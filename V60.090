//@version=5
// ============================================================================
// GPCombo v60.000  (Estratégia)
// - Fusão de gestão de risco & limites (55.007 + 59.003) + ajustes v60
// - 1 entrada por barra; permite nova entrada já na barra seguinte (cooldown=0)
// - HardKill diário (perda máx); SoftKill por sequência de perdas (janela curta)
// - Limite de trades por janela móvel (ex.: máx X trades a cada Y minutos)
// - Ganho mínimo projetado (R$) + RR mínimo projetado (TP1 vs STOP)
// - MinHold (mín. de barras em posição) para evitar "entrada/saída mesmo horário"
// - Execuções configuráveis (Intrabar/Barra fechada) com padrão seg. confiabilidade
// - Guard-rails: cap de qty por ordem, qty mínima, forçar 1 passo se risco tolerar
// - X×R Stop (cash) + Stop base (ATR/Ticks/%/Fixo) — prevalece o mais apertado
// - Midday Throttle/Block + Flat no fim da sessão
// - Mantém métodos/gates/score/FP/VP/VWAP2 (virão em blocos seguintes)
// ============================================================================

// === Versão (fonte única de verdade)
const string VERSION = "v60.090"

strategy("GPCombo " + VERSION,
     overlay=true,
     initial_capital=50000,
     currency=currency.NONE,
     pyramiding=3,
     commission_type=strategy.commission.cash_per_order, commission_value=0.0,
     calc_on_every_tick=true, process_orders_on_close=false,
     calc_on_order_fills=true,
     slippage=0)

// -----------------------------------------------------------------------------
// Helpers
// -----------------------------------------------------------------------------
clampf(float x, float lo, float hi) =>
    float a = math.max(lo, x)
    float b = math.min(a, hi)
    b

round_to_step(float qty, float step) =>
    float st = step <= 0 ? 1.0 : step
    float q  = qty / st
    float qf = math.floor(q)
    float r  = qf * st
    r

ceil_to_step(float qty, float step) =>
    float st = step <= 0 ? 1.0 : step
    float q  = qty / st
    float qf = math.ceil(q)
    float r  = qf * st
    r

nzf(float v, float repl) =>
    float r = na(v) ? repl : v
    r

// ADX sem tuplas (cálculo “na unha”)
f_adx(int len) =>
    float up   = math.max(high - high[1], 0)
    float down = math.max(low[1] - low,   0)
    float plusDM  = (up   > down) ? up   : 0.0
    float minusDM = (down > up)   ? down : 0.0
    float tr  = ta.rma(ta.tr(true), len)
    float pDI = tr > 0 ? 100.0 * ta.rma(plusDM,  len) / tr : 0.0
    float mDI = tr > 0 ? 100.0 * ta.rma(minusDM, len) / tr : 0.0
    float dx  = (pDI + mDI) > 0 ? 100.0 * math.abs(pDI - mDI) / (pDI + mDI) : 0.0
    float adx = ta.rma(dx, len)
    adx

// aplica boosts respeitando passe e retornando já arredondado
boost_qty(float q, float pct, float step) =>
    round_to_step(q * (1.0 + pct/100.0), step)

// ---- Core allow flags (inicialização global segura)
bool allowCoreL = true
bool allowCoreS = true

// Retorna true se o horário atual está entre HHMM início e HHMM fim (inclusivo)
f_inHHMM(int startHHMM, int endHHMM) =>
    int sh = int(math.floor(startHHMM / 100))
    int sm = startHHMM % 100
    int eh = int(math.floor(endHHMM / 100))
    int em = endHHMM % 100
    int nowM = hour(time) * 60 + minute(time)
    int sM = sh*60 + sm
    int eM = eh*60 + em
    nowM >= sM and nowM <= eM


// -----------------------------------------------------------------------------
// ⓪ Modo / Sessão / Fechamento / Crypto
// -----------------------------------------------------------------------------
string gpMode = "⓪ Modo & Sessão"
string opMode = input.string("Backtest", "Modo", options=["Backtest","Produção"], group=gpMode)
bool   allowOrders = (opMode == "Backtest")

bool   isCrypto = input.bool(false, "Ativo é Cripto?", group=gpMode)
bool   cryptoIgnoreSession = input.bool(true, "Se Cripto: ignorar sessão/fechamento", group=gpMode)

bool   useSession   = input.bool(true, "Restringir por sessão", group=gpMode)
string sessMain     = input.session("1000-1740", "Sessão principal (HHMM-HHMM)", group=gpMode)
bool   inSessionRaw = not useSession or not na(time(timeframe.period, sessMain))
bool   inSession    = isCrypto and cryptoIgnoreSession ? true : inSessionRaw
// Delay inicial pós-abertura da sessão
bool useSessionDelay = input.bool(true, "Delay inicial pós-abertura", group=gpMode)
int  sessionDelayMin = input.int(5, "Delay (min) após abrir sessão", minval=0, group=gpMode)
// Detecta a virada "fora da sessão" -> "dentro da sessão"
var int sessStartMs = na
bool sessionJustOpened = inSessionRaw and not inSessionRaw[1]

// Reseta no início de cada dia
if ta.change(time("D")) != 0
    sessStartMs := na

// Marca o timestamp do primeiro candle da sessão
if sessionJustOpened
    sessStartMs := int(time)

// Verifica se o delay já passou
int  nowMs_all = int(time)
int  needMs    = sessionDelayMin * 60 * 1000
bool delayPassed = na(sessStartMs) ? false : (nowMs_all - sessStartMs) >= needMs

// Se for cripto e estiver ignorando sessão, não aplica delay
bool delayGate = isCrypto and cryptoIgnoreSession ? true
                 : (not useSessionDelay ? true : delayPassed)
// Fechamento (default 16:40) + Flat X min antes
bool   useDayFlat   = input.bool(true, "Hard-Flat (zerar antes do fim)", group=gpMode)
string mktCloseHHMM = input.string("1640", "Horário de fechamento (HHMM)", group=gpMode)

// Parse HHMM seguro
string _hhStr = str.substring(mktCloseHHMM, 0, 2)
string _mmStr = str.substring(mktCloseHHMM, 2, 4)
float  _hhF   = nz(str.tonumber(_hhStr), 16.0)
float  _mmF   = nz(str.tonumber(_mmStr), 40.0)
int    closeHH = int(math.floor(clampf(_hhF, 0.0, 23.0)))
int    closeMM = int(math.floor(clampf(_mmF, 0.0, 59.0)))
int    mktCloseMin  = closeHH * 60 + closeMM

int    flatMinutes  = input.int(5, "Zerar a X min do fechamento", minval=0, group=gpMode)

int    nowMinRaw    = hour(time) * 60 + minute(time)
int    nowMin       = isCrypto and cryptoIgnoreSession ? 0 : nowMinRaw
bool   timeToFlat   = isCrypto and cryptoIgnoreSession ? false : ((mktCloseMin - nowMin) <= flatMinutes and (mktCloseMin - nowMin) >= 0)

// Uma entrada por barra (permitir nova já na barra seguinte)
bool   sameBarEntries = input.bool(false, "Permitir múltiplas entradas na mesma barra", group=gpMode)
var int lastEntryBar  = na
// --- Gate: só 1 envio por barra (usa lastEntryBar que você já tem)
bool canSendThisBar = sameBarEntries or na(lastEntryBar) or (bar_index > lastEntryBar)
// =================== PATCH: guardião global 1-por-barra ===================
bool onePerBar = input.bool(true, "Apenas 1 envio por barra (entradas/addons/alertas)", group=gpMode)

// Estado global (último bar em que QUALQUER envio aconteceu: ordem/alerta/addon)
var int lastSendBar = na

// “Posso enviar algo agora?” — se ligado, apenas se ainda não enviei nada nesta barra
bool canSendNow = onePerBar ? (na(lastSendBar) or bar_index > lastSendBar) : true

// Compatibilidade: reutiliza o que já existia
canSendThisBar := canSendNow
// ========================================================================
// Operar somente Long/Short/Ambos
string sideMode = input.string("Both", "Lado permitido", options=["Both","LongOnly","ShortOnly"], group=gpMode)

// Midday throttle (opcional)
bool   useMidday    = input.bool(true, "Habilitar Midday", group=gpMode)
string sessMid      = input.session("1200-1400", "Janela Midday (HHMM-HHMM)", group=gpMode)
string midMode      = input.string("Throttle", "Midday: modo", options=["Off","Throttle","Block"], group=gpMode)
float  midThrottle  = input.float(0.5, "Throttle fator (0-1)", minval=0.0, maxval=1.0, step=0.05, group=gpMode)
bool   inMidday     = isCrypto and cryptoIgnoreSession ? false : (useMidday and not na(time(timeframe.period, sessMid)))
// Midday dinâmico: se contexto forte, afrouxa; se fraco, estrangula mais
float midAdj = 1.0
// -----------------------------------------------------------------------------
// ① Bases técnicas comuns
// -----------------------------------------------------------------------------
float atr14  = ta.atr(14)
float ema200 = ta.ema(close, 200)
float ema20  = ta.ema(close, 20)
float vwap   = ta.vwap(hlc3)
float pv     = math.max(1.0, syminfo.pointvalue)

// -----------------------------------------------------------------------------
// ② Risco & Limites — Fusão 55.007 + 59.003 + v60
// -----------------------------------------------------------------------------
string gpRisk = "① Risco & Limites (R$)"
float riskBRL         = input.float(200.0, "Risco por trade (R$)", minval=1.0, step=10.0, group=gpRisk)
float lotStep         = input.float(100.0, "Passo (múltiplos; aceita float ≤5 casas)", minval=0.00001, step=0.00001, group=gpRisk)
int   tradesMaxDia    = input.int(3, "Máx trades/dia", minval=0, group=gpRisk)
float maxDailyLossBRL = input.float(2000.0, "Perda máx. diária (R$) = HardKill", minval=0.0, step=50.0, group=gpRisk)
float dailyKillBufferPct = input.float(0.0, "HardKill: buffer (%)", minval=0.0, maxval=3.0, step=0.1, group=gpRisk)
int   cooldownBars    = input.int(0, "Cooldown entre entradas (barras)", minval=0, group=gpRisk)
float maxQtyPerOrder  = input.float(50000.0, "Qtd máx por ordem (aceita float)", minval=0.00001, group=gpRisk)
float minQtyPerTrade  = input.float(100.0, "Qtd mín por trade (aceita float)", minval=0.00001, group=gpRisk)
bool  allowForceMinLot= input.bool(true, "Se base<passo: tentar 1 passo se risco tolerar", group=gpRisk)
float maxOverRiskPct  = input.float(20.0, "Excesso de risco máx. p/ 1 passo (%)", minval=0.0, step=0.5, group=gpRisk)

// Stop adicional por X×R (cash)
bool  useXRiskStop    = input.bool(true, "Stop adicional por X×R (cash)", group=gpRisk)
float xRiskMult       = input.float(2.5,  "X (ex.: 2.5 × risco)", minval=0.5, step=0.1, group=gpRisk)

// --- Novidades v59.003 → v60: SoftKill + Janela móvel de trades ---
bool  useSoftKill         = input.bool(true,  "SoftKill por sequência de perdas", group=gpRisk)
int   softKillLossStreak  = input.int(2,      "SoftKill: perdas consecutivas",   minval=1, group=gpRisk)
int   softKillPauseBars   = input.int(4,      "SoftKill: pausar N barras",       minval=1, group=gpRisk)

bool  useRollingLimit     = input.bool(true,  "Limitar trades por janela móvel", group=gpRisk)
int   rollWinMinutes      = input.int(60,     "Janela (minutos)",                minval=1, group=gpRisk)
int   rollMaxTrades       = input.int(6,      "Máx trades na janela",            minval=1, group=gpRisk)

// Ganho mínimo e RR mínimo projetados (guard-rails para elevar $/trade)
bool  mg_use              = input.bool(true,  "Exigir ganho previsto mínimo (R$)", group=gpRisk)
float mg_minGain          = input.float(120.0,"Ganho previsto mínimo (R$)", step=5.0, group=gpRisk)
bool  rr_use              = input.bool(true,  "Exigir RR mínimo projetado (TP1/STOP)", group=gpRisk)
float rr_min              = input.float(1.20, "RR mínimo (TP1 ÷ STOP)", step=0.05, minval=0.5, group=gpRisk)

// contadores do dia / PnL do dia 
var float dayStartNet = na
if ta.change(time("D")) != 0
    dayStartNet := strategy.netprofit
float profitToday = na(dayStartNet) ? 0.0 : (strategy.netprofit - dayStartNet)

// Trades por dia
var int tradesToday = 0
if ta.change(time("D")) != 0
    tradesToday := 0

// HardKill diário (perda máx.)
var bool dayKilled = false
if ta.change(time("D")) != 0
    dayKilled := false
if maxDailyLossBRL > 0 and not dayKilled
    float killLine = -maxDailyLossBRL * (1.0 - dailyKillBufferPct/100.0)
    if profitToday <= killLine
        strategy.close_all("DailyHardKill")
        dayKilled := true

// SoftKill por sequência de perdas (pausa temporária)
var int lastWinTrades = 0
var int lastLosTrades = 0
var int lossStreak    = 0
var int softPauseUntilBar = na
// SoftKill adaptativo por regime (mais vol → pausa um pouco maior)
// usar ATR% local aqui para não depender dos Gates
float _atrPctNow = (atr14/close)*100.0
int   softPauseDyn = math.round(softKillPauseBars * (1 + clampf(_atrPctNow/2.0, 0.0, 2.0)))

if strategy.wintrades != lastWinTrades
    lossStreak      := 0
    lastWinTrades   := strategy.wintrades

if strategy.losstrades != lastLosTrades
    lossStreak      := lossStreak + 1
    lastLosTrades   := strategy.losstrades
    if useSoftKill and lossStreak >= softKillLossStreak
        softPauseUntilBar := bar_index + softPauseDyn

bool inSoftPause = not na(softPauseUntilBar) and bar_index <= softPauseUntilBar

// Limite por janela móvel de tempo (trades executados recentemente)
var array<int> entryTimes = array.new<int>()  // guarda "time" (ms) das entradas aprovadas
int   winMs   = rollWinMinutes * 60 * 1000
int   nowMs   = int(time)

f_prune_window() =>
    int sz = array.size(entryTimes)
    if sz > 0
        for k = 0 to (sz - 1)
            int i = (sz - 1) - k
            int t = array.get(entryTimes, i)
            if nowMs - t > winMs
                array.remove(entryTimes, i)

f_prune_window()
int tradesInWindow = array.size(entryTimes)
bool overRolling   = useRollingLimit and (tradesInWindow >= rollMaxTrades)

// Cooldown entre entradas (em barras)
bool inCooldown    = cooldownBars > 0 and not na(lastEntryBar) and (bar_index - lastEntryBar) <= cooldownBars
bool hitMaxLoss    = dayKilled
bool overDayTrades = tradesMaxDia > 0 and tradesToday >= tradesMaxDia

// -----------------------------------------------------------------------------
// ③ STOP / TP / BE / Trail + MinHold para evitar same-bar exits
// -----------------------------------------------------------------------------
string gpExit = "② Saídas (STOP/TP/BE/Trail)"
// STOP base
string sLMode = input.string("ATR", "Modo STOP", options=["ATR","Ticks","Percent","Fixo"], group=gpExit)
float sLATRx  = input.float(1.0,  "ATRx p/ STOP", minval=0.05, step=0.05, group=gpExit)
int   sLTicks = input.int(50,     "STOP em ticks", minval=1, group=gpExit)
float sLPct   = input.float(1.0,  "STOP %", minval=0.05, step=0.05, group=gpExit)
float sLFixed = input.float(50.0, "STOP FIXO (R$ por ação)", minval=0.01, step=0.01, group=gpExit)

float stopDistPriceATR   = atr14 * sLATRx
float stopDistPriceTicks = syminfo.mintick * sLTicks
float stopDistPricePct   = close * (sLPct/100.0)
float stopDistPriceFixo  = sLFixed / pv
float stopDistPriceBase  = sLMode=="ATR" ? stopDistPriceATR : sLMode=="Ticks" ? stopDistPriceTicks : sLMode=="Percent" ? stopDistPricePct : stopDistPriceFixo
float stopDistCashBase   = stopDistPriceBase * pv

// TP / Execuções — padrão mais conservador (para evitar "mesmo horário")
bool  useTP1      = input.bool(true,  "Usar TP1", group=gpExit)
int   tp1Percent  = input.int(50,     "Percentual TP1 (%)", minval=0, maxval=100, group=gpExit)
bool  useTP2      = input.bool(false, "Usar TP2 (restante)", group=gpExit)
float tp1R_base   = input.float(1.2,  "TP1 base (R) [v60 ↑]", minval=0.1, step=0.1, group=gpExit)
float tp1FloorR   = input.float(1.0,  "TP1 floor (R) [v60 ↑]", minval=0.5, step=0.05, group=gpExit)
float tp1CeilR    = input.float(4.0,  "TP1 ceil (R)",  minval=0.5, step=0.1, group=gpExit)
// [PATCH-2] Versão efetiva do R (pode ser ajustada em runtime; o input não pode)
var float tp1R_base_eff = na
tp1R_base_eff := tp1R_base
bool  tp1AnchorEMA= input.bool(true,  "TP1 ancorar EMA200", group=gpExit)
bool  tp1AnchorDon= input.bool(true,  "TP1 ancorar Donchian", group=gpExit)
int   donLenTP    = input.int(20,     "Donchian (âncora TP1)", minval=2, group=gpExit)
float tp2Mult     = input.float(2.0,  "TP2 = múltiplo de TP1", minval=1.0, step=0.25, group=gpExit)
string tpRefSrc   = input.string("AvgPrice", "Preço ref. dos TPs", options=["AvgPrice","Close"], group=gpExit)

// Exec modes (default mais confiável)
string execTP1Mode   = input.string("Barra fechada", "Exec TP1", options=["Intrabar","Barra fechada"], group=gpExit)
string execBEMode    = input.string("Barra fechada", "Exec Break-even", options=["Intrabar","Barra fechada"], group=gpExit)
string execTrailMode = input.string("Barra fechada", "Exec Trail", options=["Intrabar","Barra fechada"], group=gpExit)
string execStopMode  = input.string("Barra fechada", "Exec Stop", options=["Intrabar","Barra fechada"], group=gpExit)
bool okTP1Exec   = execTP1Mode  == "Barra fechada" ? barstate.isconfirmed : true
bool okBEExec    = execBEMode   == "Barra fechada" ? barstate.isconfirmed : true
bool okTrailExec = execTrailMode== "Barra fechada" ? barstate.isconfirmed : true
bool okStopExec  = execStopMode == "Barra fechada" ? barstate.isconfirmed : true

// ===== PATCH: Inputs extras (② Saídas) =====
string gpExitX = gpExit

// Modo Runner após TP2 (alonga alvo; fecha por STOP/trail)
bool  extend_after_tp2 = input.bool(false, "TP2: alongar e travar stop em TP2 (Runner)", group=gpExitX)

// Flat-Lock anti-eco: silenciar eventos por N barras após fechar
bool  flatlock_enable  = input.bool(true,  "Flat-Lock: silenciar após fechar", group=gpExitX)
int   flatlock_bars    = input.int(1,      "Flat-Lock: N barras de silêncio", minval=1, group=gpExitX)

// BE/Trail: permitir exceção ao '1×/barra' na mesma barra do TP1
// (usa seu allowSameBarBE existente; só registramos aqui que haverá exceção controlada)

// MinHold / evitar saída na mesma barra que a entrada
int   minHoldBars     = input.int(1,  "MinHold: segurar pelo menos N barras", minval=0, group=gpExit)
bool  holdAffectsStop = input.bool(false, "MinHold também trava STOP? (cautela)", group=gpExit)

clockMs() => int(nz(timenow, time))
int maintainDelaySec = 120
int maintainDelayMs  = maintainDelaySec * 1000
// --- MEMÓRIA DA POSIÇÃO EFETIVA (usada no modo Indicador/Alertas) ---
var float  _entryAvg  = na
var bool   _sentEntry = false
var int    _entryMs   = na
var float  _entryQty  = na
var string _entrySide = ""
var int posEntryBar = na

// memória para alerta de manutenção (mantém entre barras)
var bool _sentMaint = false

// --- Sequencial diário + helpers de data/código (para 'codigo' no JSON)
var string _curCode = ""
var int    _seqToday = 0
f2(int n)=>str.tostring(n,"00")
f3(int n)=>str.tostring(n,"000")
f4(int n)=>str.tostring(n,"0000")
date_key()=>f2(dayofmonth(time))+f2(month(time))+f4(year(time))
build_code()=> syminfo.ticker + "-" + timeframe.period + "-" + date_key() + "-" + f3(_seqToday)

// --- “hasPos” estrito: só é verdade se houver uma entrada efetiva registrada
// Estado efetivo estrito: só considera posição quando de fato temos fill (ou simulação de fill no modo Indicador)
bool hasPosEffStrict = allowOrders ? (strategy.position_size != 0) : (_sentEntry and _entryQty > 0 and not na(_entryAvg))

// --- Auto-reset defensivo quando sair da sessão ou no flat do fim do dia (modo Indicador)
bool _autoFlat = (not allowOrders) and ((not inSession) or timeToFlat) and _sentEntry

if _autoFlat and strategy.position_size != 0
    strategy.close("ForceClose", comment="Cutoff Auto Close")
    alert("CUTOFF executado — posição encerrada automaticamente", alert.freq_once_per_bar)

if _autoFlat and _sentEntry
    _sentEntry:=false
    _sentMaint:=false
    _entryMs:=na
    _entryQty:=na
    _entryAvg:=na
    _entrySide:=""
    _curCode:=""

// Opcional: controle fino do reset de manutenção
var int _lastSide = 0

bool inPosEffNow = allowOrders
     ? (strategy.position_size != 0)
     : (_sentEntry and _entryQty > 0 and not na(_entryAvg))

if not inPosEffNow
    posEntryBar := na

bool allowExitNow = na(posEntryBar) ? true : (bar_index - posEntryBar) >= minHoldBars
bool okStopFinal  = okStopExec  and (holdAffectsStop ? allowExitNow : true)
bool okTPBEFinal  = allowExitNow // TP/BE/Trail só após MinHold

// TP1 adaptativo (RSI/ATR%/RVOL + âncoras)
tp1R_calc(float baseR) =>
    float rsiNow_   = ta.rsi(close, 14)
    float atrPctNow = (atr14/close)*100.0
    float _smaVol20 = ta.sma(volume, 20)
    float rvolNow   = _smaVol20 > 0 ? (volume / _smaVol20) : 1.0
    float factor = 1.0
    factor += (math.abs(rsiNow_ - 50.0)/100.0) * 0.6
    factor += math.min(atrPctNow/2.0, 1.0) * 0.4
    factor += math.min(math.max(rvolNow - 1.0, 0.0), 1.0) * 0.3
    if tp1AnchorEMA
        factor *= 1.0 + (math.abs(close - ema200) / math.max(close, syminfo.mintick*10))
    if tp1AnchorDon
        float dH = ta.highest(high, donLenTP)
        float dL = ta.lowest(low,  donLenTP)
        float distDon = math.min(math.abs(close - dH), math.abs(close - dL))
        factor *= 1.0 + distDon * 0.2
    // ajuste suave conforme o regime
    float baserlocal = baseR
    if atrPctNow > 1.5
        baserlocal += 0.1
    if rvolNow > 1.5
        baserlocal += 0.05
    float cr = clampf(baseR*factor, tp1FloorR, tp1CeilR)
    cr

getTP1Price(bool isLong, float basePx) =>
    float rCash = stopDistCashBase
    float t1R   = tp1R_calc(tp1R_base_eff)
    float dist  = t1R * (rCash / pv)
    float px    = isLong ? (basePx + dist) : (basePx - dist)
    px

getTP2Price(bool isLong, float basePx) =>
    float rCash = stopDistCashBase
    float t1R   = tp1R_calc(tp1R_base_eff)
    float t2R   = math.max(tp2Mult * t1R, t1R + 0.5)
    float dist  = t2R * (rCash / pv)
    float px    = isLong ? (basePx + dist) : (basePx - dist)
    px


// Projeções para guard-rails (RR e minGain) — serão usadas no sizer
float basePxProj = close
float tp1ProjL = getTP1Price(true,  basePxProj)
float tp2ProjL = useTP2 ? getTP2Price(true,  basePxProj) : na
float tp1ProjS = getTP1Price(false, basePxProj)
float tp2ProjS = useTP2 ? getTP2Price(false, basePxProj) : na
// RR projetado (TP1 vs STOP base em cash)
float _t1R_now = tp1R_calc(tp1R_base_eff)
float rrProj   = stopDistCashBase > 0 ? _t1R_now : na
// rrProj fica igual ao t1R_calc(base), mas mantemos a forma geral se futuramente o STOP base variar.
bool rrOK = (not rr_use) or (not na(rrProj) and rrProj >= rr_min)
// Preparos diversos para blocos seguintes
var bool __ready_block1 = true
// -----------------------------------------------------------------------------
// ④ Métodos de Entrada (setup signals)
// -----------------------------------------------------------------------------
string gpMeth = "③ Métodos de Entrada"
// Inside
bool mInside_on = input.bool(true, "Inside Breakout", group=gpMeth)
bool insidePrev = high[1] <= high[2] and low[1] >= low[2]
bool sigInsideL = mInside_on and insidePrev and ta.crossover(close, high[1])
bool sigInsideS = mInside_on and insidePrev and ta.crossunder(close, low[1])
// Engulfing
bool mEngulf_on = input.bool(true, "Engulfing", group=gpMeth)
bool bullEng = close > open and open <= close[1] and close >= open[1] and low <= low[1] and high >= high[1]
bool bearEng = close < open and open >= close[1] and close <= open[1] and low <= low[1] and high >= high[1]
bool sigEngulfL = mEngulf_on and bullEng
bool sigEngulfS = mEngulf_on and bearEng
// Donchian
bool mDon_on = input.bool(true, "Donchian Break", group=gpMeth)
int  donLen = input.int(20, "Donchian len", minval=2, group=gpMeth)
bool sigDonL = mDon_on and ta.crossover(close, ta.highest(high, donLen)[1])
bool sigDonS = mDon_on and ta.crossunder(close, ta.lowest(low,  donLen)[1])
// EMA Continuation
bool  mCont_on = input.bool(true, "EMA Continuation", group=gpMeth)
bool  sigContL = mCont_on and close > ema20 and low  <= ema20 and close > close[1]
bool  sigContS = mCont_on and close < ema20 and high >= ema20 and close < close[1]
// VWAP Reversal
bool mVWAP_on = input.bool(false, "VWAP Reversal", group=gpMeth)
float distVWAP = close - vwap
bool sigVWAPL = mVWAP_on and distVWAP < 0 and ta.crossover(close, vwap)
bool sigVWAPS = mVWAP_on and distVWAP > 0 and ta.crossunder(close, vwap)
// Opening range
bool mOR_on = input.bool(false, "Opening Range BO", group=gpMeth)
int  orBars = input.int(5, "OR barras iniciais", minval=1, group=gpMeth)
float orHigh = ta.highest(high, orBars)
float orLow  = ta.lowest(low,  orBars)
bool sigORL = mOR_on and bar_index > orBars and ta.crossover(close, orHigh)
bool sigORS = mOR_on and bar_index > orBars and ta.crossunder(close, orLow)
// RSI Divergência
bool  mRSIDiv_on = input.bool(false, "RSI Divergência", group=gpMeth)
int   divLen = input.int(14, "RSI div len", minval=5, group=gpMeth)
float rsi = ta.rsi(close, 14)
bool  bullDiv = mRSIDiv_on and low < low[1] and rsi > rsi[1] and low == ta.lowest(low, divLen)
bool  bearDiv = mRSIDiv_on and high > high[1] and rsi < rsi[1] and high == ta.highest(high, divLen)
bool  sigRSIL = bullDiv
bool  sigRSIS = bearDiv
// Range + Reteste (caixa)
bool  mRangeRet_on = input.bool(false, "Range + Reteste (Caixa)", group=gpMeth)
int   boxLen = input.int(30, "Box janela", minval=5, group=gpMeth)
float boxH = ta.highest(high, boxLen)
float boxL = ta.lowest(low,  boxLen)
bool  boUp = ta.crossover(close, boxH[1])
bool  boDn = ta.crossunder(close, boxL[1])
var float boxBrkL = na
var float boxBrkS = na
if boUp
    boxBrkL := boxH[1]
if boDn
    boxBrkS := boxL[1]
float retTol = input.float(0.3, "Reteste tolerância (ATRx)", minval=0.0, step=0.05, group=gpMeth)
bool  retBoxL = not na(boxBrkL) and math.abs(close - boxBrkL) <= retTol*atr14
bool  retBoxS = not na(boxBrkS) and math.abs(close - boxBrkS) <= retTol*atr14
bool  sigRangeRetL = mRangeRet_on and retBoxL
bool  sigRangeRetS = mRangeRet_on and retBoxS
// Breakout-Pullback local (BOPB)
bool  mBOPB_on = input.bool(false, "Breakout-Pullback (local)", group=gpMeth)
int   pivLen = input.int(3, "Pivô len", minval=1, group=gpMeth)
float pH = ta.pivothigh(high, pivLen, pivLen)
float pL = ta.pivotlow(low,  pivLen, pivLen)
bool  brkPH = not na(pH[1]) and close > pH[1]
bool  brkPL = not na(pL[1]) and close < pL[1]
var float bopbLvlL = na
var float bopbLvlS = na
if brkPH
    bopbLvlL := pH[1]
if brkPL
    bopbLvlS := pL[1]
int   bopbBars = input.int(6, "Máx barras p/ pullback", minval=1, group=gpMeth)
int   sincePH = ta.barssince(brkPH)
int   sincePL = ta.barssince(brkPL)
bool  pullL = sincePH <= bopbBars and not na(bopbLvlL) and math.abs(close - bopbLvlL) <= retTol*atr14
bool  pullS = sincePL <= bopbBars and not na(bopbLvlS) and math.abs(close - bopbLvlS) <= retTol*atr14
bool  sigBOPBL = mBOPB_on and pullL
bool  sigBOPBS = mBOPB_on and pullS
// Larry Williams 9.6 (aprox.)
bool mLW96_on = input.bool(false, "Larry Williams 9.6 (aprox.)", group=gpMeth)
int  lwStartBars = input.int(9, "Bars após abertura", minval=1, group=gpMeth)
int  lwLook = input.int(6, "Janela gatilho", minval=1, group=gpMeth)
bool inFirstHour = not na(time(timeframe.period, "1000-1100"))
bool lwLong  = mLW96_on and inFirstHour and bar_index > lwStartBars and close > ta.highest(high, lwLook)[1]
bool lwShort = mLW96_on and inFirstHour and bar_index > lwStartBars and close < ta.lowest(low,  lwLook)[1]
bool sigLW96L = lwLong
bool sigLW96S = lwShort
// Opening Reversal Fade
bool mORFade_on = input.bool(false, "Opening Reversal Fade", group=gpMeth)
float orMid = (orHigh + orLow)/2.0
bool  early = not na(time(timeframe.period, "1000-1100"))
bool  sigORFadeL = mORFade_on and early and close < orLow and ta.crossover(close, vwap)
bool  sigORFadeS = mORFade_on and early and close > orHigh and ta.crossunder(close, vwap)
// 2-Bar
bool m2Bar_on = input.bool(false, "2-Bar Reversal / Piercing / DarkCloud", group=gpMeth)
bool bull2Bar = m2Bar_on and close[1] < open[1] and close > open and close >= (open[1] + close[1]) / 2.0 and low <= low[1]
bool bear2Bar = m2Bar_on and close[1] > open[1] and close < open and close <= (open[1] + close[1]) / 2.0 and high >= high[1]
bool sig2BarL = bull2Bar
bool sig2BarS = bear2Bar
// BOS Continuação
bool mBOSCont_on = input.bool(false, "BOS Continuação (pós-reteste)", group=gpMeth)
bool momentumL = close > open and close > high[1]
bool momentumS = close < open and close < low[1]
bool sigBOSContL = mBOSCont_on and momentumL
bool sigBOSContS = mBOSCont_on and momentumS

// === NOVOS MÉTODOS v60.090 ===
bool mADX_on   = input.bool(false, "ADX Compression Breakout", group=gpMeth)
int  adxLen    = input.int(14, "ADX len", minval=5, group=gpMeth)
float adxV     = f_adx(adxLen)
// versão robusta (evita igualdade estrita):
bool adxCompress = (adxV < 15) and (adxV <= ta.lowest(adxV, adxLen*2))
bool sigADXL = mADX_on and adxCompress and ta.crossover(close, ta.highest(high, 10)[1])
bool sigADXS = mADX_on and adxCompress and ta.crossunder(close, ta.lowest(low,  10)[1])

bool mRSIFS_on = input.bool(false, "RSI Failure Swing", group=gpMeth)
float rsi14    = rsi

bool mConflu_on = input.bool(false, "EMA–VWAP Confluence PB", group=gpMeth)
// RSI Failure Swing (ajuste leve)
bool rsiFS_L = mRSIFS_on and rsi14[2] < 30 and rsi14[1] > rsi14[2] and (rsi14 > 45 or ta.crossover(rsi14, 50)) and close >= high[1]
bool rsiFS_S = mRSIFS_on and rsi14[2] > 70 and rsi14[1] < rsi14[2] and (rsi14 < 55 or ta.crossunder(rsi14, 50)) and close <= low[1]
bool sigRSIFL = rsiFS_L
bool sigRSIFS = rsiFS_S
// EMA–VWAP Confluence PB (ajuste leve)
bool conflL = mConflu_on and close >= vwap and low <= ema20 * 1.001 and ta.crossover(close, ema20)
bool conflS = mConflu_on and close <= vwap and high >= ema20 * 0.999 and ta.crossunder(close, ema20)
bool sigConfluL = conflL
bool sigConfluS = conflS

bool mATRexp_on = input.bool(false, "ATR Expansion Bar", group=gpMeth)
bool bigBarL = mATRexp_on and (high - low) > 1.5*atr14 and close > open and close > (open + (high - low)*0.6)
bool bigBarS = mATRexp_on and (high - low) > 1.5*atr14 and close < open and close < (open - (high - low)*0.6)
bool sigATRXL = bigBarL
bool sigATRXS = bigBarS
// -----------------------------------------------------------------------------
// ⑤ Gates & Filtros
// -----------------------------------------------------------------------------
string gpFilt = "④ Gates & Filtros"
string gateMode = input.string("Soft", "Modo dos Gates", options=["Off","Soft","Medium","Hard"], group=gpFilt)
float  minGateFrac  = input.float(0.35, "Medium: fração mínima de gates OK", minval=0.0, maxval=1.0, step=0.05, group=gpFilt)

bool useEMA200   = input.bool(false, "Gate EMA200 (tendência)", group=gpFilt)
bool useVWAPBand = input.bool(false, "Gate VWAP (faixa)", group=gpFilt)
bool useVWAPImp  = input.bool(false, "Gate VWAP Impulso", group=gpFilt)
bool useERmin    = input.bool(false, "Gate ER mínimo", group=gpFilt)
bool useRVOLmin  = input.bool(false, "Gate RVOL mínimo", group=gpFilt)
bool useATRpct   = input.bool(false, "Gate ATR% regime", group=gpFilt)
bool useIBS      = input.bool(false, "Gate IBS faixa", group=gpFilt)
bool useWR7NR7   = input.bool(false, "Gate WR7/NR7", group=gpFilt)
bool useSlope    = input.bool(false, "Gate Slope (EMA/VWAP)", group=gpFilt)
bool useMarket   = input.bool(false, "Gate Mercado (IBOV EMA200)", group=gpFilt)
bool useGapATR   = input.bool(false, "Gate Gap normalizado por ATR", group=gpFilt)
bool useCHOP     = input.bool(false, "Gate Choppiness (tendência)", group=gpFilt)

float vwapBandPct = input.float(0.005, "VWAP: tolerância (% do preço)", minval=0.0, step=0.0001, group=gpFilt)
float vwapSlopeMinPct = input.float(0.04, "VWAP Impulso: inclinação mín (%/bar)", minval=0.0, step=0.005, group=gpFilt)
float vwapMaxDistPct  = input.float(0.75, "VWAP Impulso: dist máx (% do preço)", minval=0.1, step=0.05, group=gpFilt)
int   erLen   = input.int(14, "ER período", minval=2, group=gpFilt)
float erMin   = input.float(0.2, "ER mínimo", minval=0.0, step=0.01, group=gpFilt)
float rvolMin = input.float(1.2, "RVOL mínimo", minval=0.0, step=0.1, group=gpFilt)
float atrPctMin= input.float(0.2, "ATR% mín", minval=0.0, step=0.1, group=gpFilt)
float atrPctMax= input.float(8.0, "ATR% máx", minval=0.0, step=0.1, group=gpFilt)
float ibsMin= input.float(0.1, "IBS mínimo", minval=0.0, maxval=1.0, step=0.01, group=gpFilt)
float ibsMax= input.float(0.9, "IBS máximo", minval=0.0, maxval=1.0, step=0.01, group=gpFilt)
float slopeMin = input.float(0.0, "Slope mínimo abs.", minval=0.0, step=0.0001, group=gpFilt)
string slopeSrc = input.string("EMA200", "Slope: fonte", options=["EMA200","VWAP"], group=gpFilt)
string marketSym = input.string("BMFBOVESPA:IBOV", "Símbolo índice mercado", group=gpFilt)
float maxGapATR = input.float(1.5, "Gap ATR máx", minval=0.0, step=0.1, group=gpFilt)
int   chopLen = input.int(14, "CHOP len", minval=2, group=gpFilt)
float chopMax   = input.float(61.8, "CHOP máx (trend <)", minval=0.0, maxval=100.0, step=0.5, group=gpFilt)

// Cálculos
float vwapSlopePct = math.abs((vwap - vwap[1]) / math.max(vwap[1], syminfo.mintick*10)) * 100.0
bool  vwapRightSideL = close >= vwap
bool  vwapRightSideS = close <= vwap
bool  vwapDistOK     = math.abs((close - vwap)/close) * 100.0 <= vwapMaxDistPct
bool  vwapSlopeOK    = vwapSlopePct >= vwapSlopeMinPct
bool  ema200OK_L = close >= ema200
bool  ema200OK_S = close <= ema200
bool  vwapOK = math.abs((close - vwap)/close) <= vwapBandPct
float changeAbs = math.abs(close - close[erLen])
float moveAbs   = ta.sma(math.abs(ta.change(close)), erLen) * erLen
float er        = moveAbs == 0.0 ? 0.0 : changeAbs / moveAbs
float volSMA20 = ta.sma(volume, 20)
float rvol     = volSMA20 > 0 ? volume/volSMA20 : 1.0
float atrPct   = (atr14/close)*100.0
float ibs      = (high - low) == 0 ? 0.5 : (close - low)/(high - low)
float rng      = high - low
float maxR7    = ta.highest(rng, 7)
float minR7    = ta.lowest(rng, 7)
bool  isWR7     = rng >= maxR7
bool  isNR7     = rng <= minR7
float srcSlope = slopeSrc=="EMA200" ? (ema200 - ema200[5]) : (vwap - vwap[5])
float idxClose = request.security(marketSym, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
float idxEMA200= request.security(marketSym, timeframe.period, ta.ema(close,200), barmerge.gaps_off, barmerge.lookahead_off)
bool  marketOK_L= idxClose >= idxEMA200
bool  marketOK_S= idxClose <= idxEMA200
float prevCloseD = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float gapATR = atr14 == 0 ? 0.0 : math.abs(open - prevCloseD)/atr14
float tr = math.max(high - low, syminfo.mintick)
// CHOP fix
float trMA      = ta.sma(tr, chopLen)
float trSum     = trMA * chopLen
float hiN       = ta.highest(high, chopLen)
float loN       = ta.lowest(low,  chopLen)
float chopRange = math.max(hiN - loN, syminfo.mintick)
float chop      = 100.0 * (math.log10(trSum / chopRange) / math.log10(chopLen))

// Gates por lado
bool gEMA_L = not useEMA200   or ema200OK_L
bool gEMA_S = not useEMA200   or ema200OK_S
bool gVWAP  = not useVWAPBand or vwapOK
bool gVIMP_L= not useVWAPImp  or (vwapRightSideL and vwapSlopeOK and vwapDistOK)
bool gVIMP_S= not useVWAPImp  or (vwapRightSideS and vwapSlopeOK and vwapDistOK)
bool gER    = not useERmin    or (er >= erMin)
bool gRVOL  = not useRVOLmin  or (rvol >= rvolMin)
bool gATR   = not useATRpct   or (atrPct >= atrPctMin and atrPct <= atrPctMax)
bool gIBS   = not useIBS      or (ibs >= ibsMin and ibs <= ibsMax)
bool gWRNR  = not useWR7NR7   or (isWR7 or isNR7)
bool gSlope_L = not useSlope  or (srcSlope >=  slopeMin)
bool gSlope_S = not useSlope  or (srcSlope <= -slopeMin)
bool gMKT_L   = not useMarket or marketOK_L
bool gMKT_S   = not useMarket or marketOK_S
bool gGAP     = not useGapATR or (gapATR <= maxGapATR)
bool gCHOP    = not useCHOP   or (chop <= chopMax)

// Pesos (para score/size bonus)
float wgEMA      = input.float(0.6, "Peso: EMA200 OK", step=0.1, group=gpFilt)
float wgVWAP     = input.float(0.4, "Peso: VWAP OK", step=0.1, group=gpFilt)
float wgVIMP     = input.float(0.5, "Peso: VWAP Impulso OK", step=0.1, group=gpFilt)
float wgER       = input.float(0.3, "Peso: ER OK", step=0.1, group=gpFilt)
float wgRVOL     = input.float(0.4, "Peso: RVOL OK", step=0.1, group=gpFilt)
float wgATR      = input.float(0.2, "Peso: ATR% OK", step=0.1, group=gpFilt)
float wgIBS      = input.float(0.2, "Peso: IBS OK", step=0.1, group=gpFilt)
float wgWRNR     = input.float(0.2, "Peso: WR/NR7 OK", step=0.1, group=gpFilt)
float wgSlope    = input.float(0.3, "Peso: Slope OK", step=0.1, group=gpFilt)
float wgMKT      = input.float(0.3, "Peso: Mercado OK", step=0.1, group=gpFilt)
float wgGap      = input.float(0.2, "Peso: Gap OK", step=0.1, group=gpFilt)
float wgCHOP     = input.float(0.3, "Peso: CHOP OK", step=0.1, group=gpFilt)

float bonusL = 0.0
float bonusS = 0.0
float wAct   = 0.0

// === PATCH A: YZ-Vol Regime (cole no grupo ⑤ Gates & Filtros, após seus inputs) ===
string gpYZ = "④.b Gate Volatilidade (Yang–Zhang)"
bool  useYZ        = input.bool(false, "Usar Gate YZ-Vol", group=gpYZ)
string yzMode      = input.string("Off", "Modo YZ", options=["Off","Block","Weight"], group=gpYZ)
float yzMinPct     = input.float(0.20, "YZ% mín (por barra)", step=0.01, group=gpYZ)
float yzMaxPct     = input.float(8.00, "YZ% máx (por barra)", step=0.01, group=gpYZ)
float yzWeightGain = input.float(0.20, "Weight: bônus qty em regime bom (%)", minval=0, step=1, group=gpYZ)

// Cálculo YZ (aprox. intraday, robusto a gaps)
float rr  = math.log(close/open)
float co  = math.log(open/close[1])
float u2  = math.pow(math.log(high/close), 2)
float d2  = math.pow(math.log(low/close),  2)
// sigma^2_YZ ≈ 0.34*co² + 0.66*(rr - co)² + 0.5*(u2+d2)
float sigmaYZ2 = 0.34*co*co + 0.66*math.pow(rr - co, 2) + 0.5*(u2 + d2)
float yzPctNow = math.sqrt(math.max(sigmaYZ2, 0.0)) * 100.0

bool  gYZ = (yzPctNow >= yzMinPct and yzPctNow <= yzMaxPct)

// ============================================================================
// ⑧ Consolidação dos gates – versão linearizada e robusta
// ============================================================================
// EMA200
wAct   += useEMA200                  ? wgEMA   : 0.0
bonusL += (useEMA200 and gEMA_L)     ? wgEMA   : 0.0
bonusS += (useEMA200 and gEMA_S)     ? wgEMA   : 0.0
// VWAP (faixa)
wAct   += useVWAPBand                ? wgVWAP  : 0.0
bonusL += (useVWAPBand and gVWAP)    ? wgVWAP  : 0.0
bonusS += (useVWAPBand and gVWAP)    ? wgVWAP  : 0.0
// VWAP Impulso
wAct   += useVWAPImp                 ? wgVIMP  : 0.0
bonusL += (useVWAPImp and gVIMP_L)   ? wgVIMP  : 0.0
bonusS += (useVWAPImp and gVIMP_S)   ? wgVIMP  : 0.0
// ER mínimo
wAct   += useERmin                   ? wgER    : 0.0
bonusL += (useERmin and gER)         ? wgER    : 0.0
bonusS += (useERmin and gER)         ? wgER    : 0.0
// RVOL mínimo
wAct   += useRVOLmin                 ? wgRVOL  : 0.0
bonusL += (useRVOLmin and gRVOL)     ? wgRVOL  : 0.0
bonusS += (useRVOLmin and gRVOL)     ? wgRVOL  : 0.0
// ATR% regime
wAct   += useATRpct                  ? wgATR   : 0.0
bonusL += (useATRpct and gATR)       ? wgATR   : 0.0
bonusS += (useATRpct and gATR)       ? wgATR   : 0.0
// IBS
wAct   += useIBS                     ? wgIBS   : 0.0
bonusL += (useIBS and gIBS)          ? wgIBS   : 0.0
bonusS += (useIBS and gIBS)          ? wgIBS   : 0.0
// WR7/NR7
wAct   += useWR7NR7                  ? wgWRNR  : 0.0
bonusL += (useWR7NR7 and gWRNR)      ? wgWRNR  : 0.0
bonusS += (useWR7NR7 and gWRNR)      ? wgWRNR  : 0.0
// Slope
wAct   += useSlope                   ? wgSlope : 0.0
bonusL += (useSlope and gSlope_L)    ? wgSlope : 0.0
bonusS += (useSlope and gSlope_S)    ? wgSlope : 0.0
// Mercado (índice)
wAct   += useMarket                  ? wgMKT   : 0.0
bonusL += (useMarket and gMKT_L)     ? wgMKT   : 0.0
bonusS += (useMarket and gMKT_S)     ? wgMKT   : 0.0
// Gap/ATR
wAct   += useGapATR                  ? wgGap   : 0.0
bonusL += (useGapATR and gGAP)       ? wgGap   : 0.0
bonusS += (useGapATR and gGAP)       ? wgGap   : 0.0
// CHOP
wAct   += useCHOP                    ? wgCHOP  : 0.0
bonusL += (useCHOP and gCHOP)        ? wgCHOP  : 0.0
bonusS += (useCHOP and gCHOP)        ? wgCHOP  : 0.0

// === PATCH B: CUSUM (mudança material) ===
string gpCUSUM = "④.c Gate/Boost por Evento (CUSUM)"
bool  useCUSUM   = input.bool(false, "Usar CUSUM", group=gpCUSUM)
string cusumMode = input.string("Off", "Modo CUSUM", options=["Off","Block","Weight"], group=gpCUSUM)
float cusumK_ATR = input.float(0.50, "Limiar (k × ATR14)", step=0.05, group=gpCUSUM)
float cusumBoost = input.float(15.0, "Weight: bônus qty quando em evento (%)", minval=0, step=1, group=gpCUSUM)

var float _cus = 0.0
float kCus = cusumK_ATR * atr14
_cus += (close - close[1])
bool evtUp   = _cus >  kCus
bool evtDown = _cus < -kCus
if evtUp or evtDown
    _cus := 0.0

bool gCUSUM = evtUp or evtDown

// integra como gate leve (score/contadores)
wAct   += useCUSUM ? 0.2 : 0.0
bonusL += (useCUSUM and gCUSUM) ? 0.2 : 0.0
bonusS += (useCUSUM and gCUSUM) ? 0.2 : 0.0

// === PATCH C: Perfil intraday (hora-do-dia) ===
string gpHOD = "④.d Gate/Boost por Hora-do-Dia"
bool  useHOD    = input.bool(false, "Usar perfil por hora-do-dia", group=gpHOD)
string hodMode  = input.string("Off", "Modo HOD", options=["Off","Block","Weight"], group=gpHOD)
int    hodOpenM = input.int(1000, "Janela Forte: início (HHMM)", group=gpHOD)
int    hodOpenN = input.int(1100, "Janela Forte: fim (HHMM)",    group=gpHOD)
int    hodCloseM= input.int(1600, "Janela Forte 2: início (HHMM)", group=gpHOD)
int    hodCloseN= input.int(1740, "Janela Forte 2: fim (HHMM)",    group=gpHOD)
float  hodWeakF = input.float(0.7, "Weight: fator em janela fraca", minval=0.0, maxval=1.0, step=0.05, group=gpHOD)
float  hodStrongF = input.float(1.2, "Weight: fator em janela forte", minval=0.5, step=0.05, group=gpHOD)

// helper local
bool hodStrong = f_inHHMM(hodOpenM, hodOpenN) or f_inHHMM(hodCloseM, hodCloseN)

// conta como gate leve
bonusL += (useHOD and hodStrong) ? 0.2 : 0.0
bonusS += (useHOD and hodStrong) ? 0.2 : 0.0

float bonusLnorm = wAct == 0.0 ? 1.0 : clampf(bonusL / wAct, 0.0, 1.0)
float bonusSnorm = wAct == 0.0 ? 1.0 : clampf(bonusS / wAct, 0.0, 1.0)

// -----------------------------------------------------------------------------
// Bloco 589–600 reescrito: contadores por gate, sem tuplas
// -----------------------------------------------------------------------------
int nAct   = 0
int nPassL = 0
int nPassS = 0

// EMA200
if useEMA200
    nAct   += 1
    if gEMA_L
        nPassL += 1
    if gEMA_S
        nPassS += 1

// VWAP Band
if useVWAPBand
    nAct   += 1
    if gVWAP
        nPassL += 1
        nPassS += 1

// VWAP Impulso
if useVWAPImp
    nAct   += 1
    if gVIMP_L
        nPassL += 1
    if gVIMP_S
        nPassS += 1

// ER mínimo
if useERmin
    nAct   += 1
    if gER
        nPassL += 1
        nPassS += 1

// RVOL mínimo
if useRVOLmin
    nAct   += 1
    if gRVOL
        nPassL += 1
        nPassS += 1

// ATR%
if useATRpct
    nAct   += 1
    if gATR
        nPassL += 1
        nPassS += 1

// IBS
if useIBS
    nAct   += 1
    if gIBS
        nPassL += 1
        nPassS += 1

// WR7/NR7
if useWR7NR7
    nAct   += 1
    if gWRNR
        nPassL += 1
        nPassS += 1

// Slope
if useSlope
    nAct   += 1
    if gSlope_L
        nPassL += 1
    if gSlope_S
        nPassS += 1

// Mercado (índice)
if useMarket
    nAct   += 1
    if gMKT_L
        nPassL += 1
    if gMKT_S
        nPassS += 1

// Gap/ATR
if useGapATR
    nAct   += 1
    if gGAP
        nPassL += 1
        nPassS += 1

// CHOP
if useCHOP
    nAct   += 1
    if gCHOP
        nPassL += 1
        nPassS += 1

// --- Contadores extras vindos dos novos gates (YZ/CUSUM/HOD) ---
if useYZ
    nAct += 1
    if gYZ
        nPassL += 1
        nPassS += 1

if useCUSUM
    nAct += 1
    if gCUSUM
        nPassL += 1
        nPassS += 1

if useHOD
    nAct += 1
    if hodStrong
        nPassL += 1
        nPassS += 1


bool passL_soft  = true
bool passS_soft  = true
bool passL_med   = (nAct == 0) or (nPassL >= int(math.ceil(minGateFrac * nAct)))
bool passS_med   = (nAct == 0) or (nPassS >= int(math.ceil(minGateFrac * nAct)))
bool passL_hard  = (nAct == 0) or (nPassL == nAct)
bool passS_hard  = (nAct == 0) or (nPassS == nAct)

bool passL_gates = gateMode=="Off" ? true : gateMode=="Soft" ? passL_soft : gateMode=="Medium" ? passL_med : passL_hard
bool passS_gates = gateMode=="Off" ? true : gateMode=="Soft" ? passS_soft : gateMode=="Medium" ? passS_med : passS_hard

// -----------------------------------------------------------------------------
// ⑥ Score (desempate) + bônus de gates
// -----------------------------------------------------------------------------
string gpScore = "⑤ Score (desempate)"
float wBase = input.float(1.0, "Peso base", step=0.25, group=gpScore)
float wInside = input.float(1.2, "Peso Inside", step=0.25, group=gpScore)
float wEngulf = input.float(0.9, "Peso Engulfing", step=0.25, group=gpScore)
float wDon    = input.float(1.1, "Peso Donchian", step=0.25, group=gpScore)
float wCont   = input.float(1.0, "Peso EMA Continuation", step=0.25, group=gpScore)
float wVWAPm  = input.float(1.0, "Peso VWAP Reversal", step=0.25, group=gpScore)
float wOR     = input.float(0.9, "Peso Opening Range", step=0.25, group=gpScore)
float wRSIDiv = input.float(0.8, "Peso RSI Divergência", step=0.25, group=gpScore)
float wRangeRet = input.float(0.9, "Peso Range+Reteste", step=0.25, group=gpScore)
float wBOPB   = input.float(0.9, "Peso BOPB", step=0.25, group=gpScore)
float wLW96   = input.float(0.8, "Peso LW 9.6", step=0.25, group=gpScore)
float wORFade = input.float(0.9, "Peso OR Fade", step=0.25, group=gpScore)
float w2Bar   = input.float(0.9, "Peso 2-Bar", step=0.25, group=gpScore)
float wBOSCont= input.float(0.7, "Peso BOS Continuação", step=0.25, group=gpScore)
float wADX     = input.float(0.9, "Peso ADX Compression", step=0.25, group=gpScore)
float wRSIFS   = input.float(0.9, "Peso RSI Failure Swing", step=0.25, group=gpScore)
float wConflu  = input.float(1.1, "Peso EMA–VWAP Confluence", step=0.25, group=gpScore)
float wATRexp  = input.float(0.8, "Peso ATR Expansion", step=0.25, group=gpScore)
bool  useScoreCut = input.bool(true, "Aplicar mínimo de score?", group=gpScore)
float scoreMinCut = input.float(0.4, "Score mínimo p/ aceitar", step=0.1, group=gpScore)
float gateBonusScale = input.float(1.0, "Escala do bônus de gates no score", step=0.1, group=gpScore)

methodScore(string name) =>
    float s = wBase
    if      name == "Inside"
        s += wInside
    else if name == "Engulf"
        s += wEngulf
    else if name == "Don"
        s += wDon
    else if name == "Cont"
        s += wCont
    else if name == "VWAP"
        s += wVWAPm
    else if name == "OR"
        s += wOR
    else if name == "RSIDiv"
        s += wRSIDiv
    else if name == "RangeRet"
        s += wRangeRet
    else if name == "BOPB"
        s += wBOPB
    else if name == "LW96"
        s += wLW96
    else if name == "ORFade"
        s += wORFade
    else if name == "TwoBar"
        s += w2Bar
    else if name == "BOSCont"
        s += wBOSCont
    else if name == "ADX"
        s += wADX
    else if name == "RSIFS"
        s += wRSIFS
    else if name == "Conflu"
        s += wConflu
    else if name == "ATRexp"
        s += wATRexp

    s

float gateMultL = 1.0 + gateBonusScale*(bonusLnorm - 0.5)*0.2
float gateMultS = 1.0 + gateBonusScale*(bonusSnorm - 0.5)*0.2

// -----------------------------------------------------------------------------
// ⑦ Footprint/Profile/VWAP2 (multiplicadores e blocks)
// -----------------------------------------------------------------------------
string gpFP = "⑤.b Footprint/Profile & VWAP2"
bool fp_use    = input.bool(false, "Footprint-lite: usar", group=gpFP)
string fp_mode = input.string("Weight", "Footprint: modo", options=["Weight","Block"], group=gpFP)
float fp_wDelta   = input.float(0.4, "FP peso: z-Delta", step=0.1, group=gpFP)
float fp_wImb     = input.float(0.2, "FP peso: Imbalance", step=0.1, group=gpFP)
float fp_wEffRes  = input.float(0.1, "FP peso: Effort/Result", step=0.1, group=gpFP)
float fp_wClosePos= input.float(0.2, "FP peso: ClosePos", step=0.1, group=gpFP)
float fp_wZVol    = input.float(0.1, "FP peso: z-Vol", step=0.1, group=gpFP)
float fp_deltaStrong = input.float(1.0, "FP limiar: z-Delta forte", step=0.1, group=gpFP)
float fp_imbStrong   = input.float(0.2, "FP limiar: Imbalance forte", step=0.05, group=gpFP)
float fp_effResMin   = input.float(0.00005, "FP limiar: Eff/Result min", step=0.00001, group=gpFP)
float fp_zVolStrong  = input.float(1.0, "FP limiar: z-Vol forte", step=0.1, group=gpFP)

bool vp_use    = input.bool(false, "Profile-lite (AVWAP/VA): usar", group=gpFP)
string vp_mode = input.string("Weight", "Profile: modo", options=["Weight","Block"], group=gpFP)
string vp_anchor = input.string("SessionOpen", "AVWAP Âncora", options=["SessionOpen","ORBreak","CustomTime"], group=gpFP)
string vp_timeHHMM = input.string("1000", "Se CustomTime: HHMM", group=gpFP)
float  vp_sdMult = input.float(1.0, "VA-lite: desvio p/ banda", step=0.1, group=gpFP)
float  vp_wVWAPFavor = input.float(0.5, "VP peso: favor VWAP", step=0.1, group=gpFP)
float  vp_wRVOL      = input.float(0.3, "VP peso: regime RVOL", step=0.1, group=gpFP)
float  vp_wATRpct    = input.float(0.2, "VP peso: regime ATR%", step=0.1, group=gpFP)

// VWAP 2.0
bool  v2_use   = input.bool(true, "VWAP 2.0: usar (trend/dist)", group=gpFP)
string v2_mode = input.string("Weight", "VWAP 2.0: modo", options=["Weight","Block"], group=gpFP)
float  v2_slopeMin = input.float(0.03, "VWAP2: slope mín %/bar", step=0.01, group=gpFP)
float  v2_maxDist  = input.float(1.0,  "VWAP2: dist máx % preço", step=0.1, group=gpFP)

// AVWAP/VA-lite
// AVWAP/VA-lite (corrigido: avwap = Σ(P×V)/Σ(V) a partir do anchor)
var float avwap = na
var float avwapPV = na      // soma ponderada preço×volume
var float avwapVol = na     // soma de volume
bool anchorNow = false

if vp_use
    if vp_anchor == "SessionOpen"
        anchorNow := ta.change(time("D")) != 0
    else if vp_anchor == "ORBreak"
        anchorNow := ta.crossover(close, orHigh) or ta.crossunder(close, orLow)
    else
        string _vpHH = str.substring(vp_timeHHMM, 0, 2)
        string _vpMM = str.substring(vp_timeHHMM, 2, 4)
        float  _vpHF = nz(str.tonumber(_vpHH), 10.0)
        float  _vpMF = nz(str.tonumber(_vpMM),  0.0)
        int    ah    = int(math.floor(clampf(_vpHF, 0.0, 23.0)))
        int    am    = int(math.floor(clampf(_vpMF, 0.0, 59.0)))
        int _h = hour(time)
        int _m = minute(time)
        anchorNow := (_h == ah and _m == am)

    if anchorNow or na(avwap)
        avwapPV  := close * volume
        avwapVol := volume
        avwap    := avwapVol > 0 ? (avwapPV / avwapVol) : close
    else
        avwapPV  += close * volume
        avwapVol += volume
        avwap    := avwapVol > 0 ? (avwapPV / avwapVol) : avwap

float stdevL = ta.stdev(close, 50)
float vaTop  = vp_use ? avwap + vp_sdMult * stdevL : na
float vaBot  = vp_use ? avwap - vp_sdMult * stdevL : na
bool  vpFavorL = vp_use ? (close >= avwap and (na(vaTop) or close <= vaTop)) : true
bool  vpFavorS = vp_use ? (close <= avwap and (na(vaBot) or close >= vaBot)) : true
float vp_ctxL  = (vpFavorL ? vp_wVWAPFavor : 0.0) + math.max(rvol-1.0,0.0)*vp_wRVOL + (atrPct/100.0)*vp_wATRpct
float vp_ctxS  = (vpFavorS ? vp_wVWAPFavor : 0.0) + math.max(rvol-1.0,0.0)*vp_wRVOL + (atrPct/100.0)*vp_wATRpct

// Quiet Regime: baixa volatilidade → filtrar setups de breakout “frágeis”
bool quietRegime = (rvol < 0.8) and (atrPct < 0.4)
// Desabilita temporariamente Inside/Don/OR quando “quiet”
bool mInside_eff = mInside_on and not quietRegime
bool mDon_eff    = mDon_on    and not quietRegime
bool mOR_eff     = mOR_on     and not quietRegime

// === PATCH D: AVWAP multiâncora ===
string gpAVMA = "⑤.b.1 AVWAP Multiâncora"
bool  avma_use   = input.bool(false, "Usar AVWAP multiâncora", group=gpAVMA)
string avma_mode = input.string("Off", "Modo AVWAP-M", options=["Off","Block","Weight"], group=gpAVMA)
float  avma_band = input.float(1.0, "Banda (× desvio 50)", step=0.1, group=gpAVMA)

// Âncoras adicionais
float dClosePrev = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)

// AVWAP ancorado no Fechamento D-1 (simples: EMA preço com reset quando toca o primeiro candle do dia)
var float avwapD1 = na
var float avwapD1PV = na
var float avwapD1Vol = na
bool newDay = ta.change(time("D")) != 0
if avma_use
    if newDay or na(avwapD1)
        avwapD1PV  := close * volume
        avwapD1Vol := volume
        avwapD1    := avwapD1Vol > 0 ? (avwapD1PV / avwapD1Vol) : close
    else
        avwapD1PV  += close * volume
        avwapD1Vol += volume
        avwapD1    := avwapD1Vol > 0 ? (avwapD1PV / avwapD1Vol) : avwapD1

// OR já existe (orHigh/orLow). Consideramos a âncora OR como a do seu avwap "vp_anchor==ORBreak"
// Confluência: preço entre bandas de (avwap ± avma_band*stdevL) E (avwapD1 ± ...) simultaneamente
float stL = ta.stdev(close, 50)
bool inBand1 = avma_use ? (math.abs(close - avwap)   <= avma_band*stL) : true
bool inBand2 = avma_use ? (math.abs(close - avwapD1) <= avma_band*stL) : true
bool avmaOK  = inBand1 and inBand2

// Block/Weight
if avma_use and avma_mode=="Block" and not avmaOK
    allowCoreL := false
    allowCoreS := false

// Multiplicador a ser aplicado mais tarde no Sizer
float avma_mult = 1.00
if avma_use and avma_mode=="Weight" and avmaOK
    avma_mult := 1.10

// Métricas Footprint-lite
float _tr  = math.max(high - low, syminfo.mintick)
float _dpx = _tr > 0 ? (close - open) / _tr : 0.0
float fp_delta = volume * _dpx
float sma50d = ta.sma(fp_delta, 50)
float std50d = ta.stdev(fp_delta, 50)
float fp_zDelta = std50d > 0 ? (fp_delta - sma50d) / std50d : 0.0
float wickTop = high - math.max(open, close)
float wickBot = math.min(open, close) - low
float fp_imb  = _tr > 0 ? (wickBot - wickTop) / _tr : 0.0
float fp_evr  = volume > 0 ? _tr / volume : 0.0
float fp_closePos = _tr > 0 ? (close - low) / _tr : 0.5
float _mV = ta.sma(volume, 50)
float _sV = math.sqrt(math.max(ta.variance(volume, 50), 0.0))
float fp_zVol = _sV > 0 ? (volume - _mV) / _sV : 0.0


// VWAP 2.0 favorabilidade
// ---- VWAP 2.0: “fit” ao VWAP (desvio atual e variação do desvio)
float v2_fit_now  = math.abs((close     - vwap    ) / math.max(close,     syminfo.mintick*10)) * 100.0
float v2_fit_prev = math.abs((close[1]  - vwap[1] ) / math.max(close[1],  syminfo.mintick*10)) * 100.0

// Se você precisa da “melhora do fit” (opcional)
float v2_fit_mom  = math.abs(v2_fit_now - v2_fit_prev) / math.max(v2_fit_prev, 1e-6) * 100.0
float v2_slope     = math.abs((v2_fit_now - v2_fit_prev) / math.max(vwap[1], syminfo.mintick*10)) * 100.0
float v2_dist  = math.abs((close - vwap)/close) * 100.0
bool  v2_okL   = v2_use ? (close >= vwap and v2_slope >= v2_slopeMin and v2_dist <= v2_maxDist) : true
bool  v2_okS   = v2_use ? (close <= vwap and v2_slope >= v2_slopeMin and v2_dist <= v2_maxDist) : true

// === PATCH F: VWAP2 (slope %/bar) — movido p/ cima ===
string gpV2Fix = "⑤.b.2 VWAP2 (slope %/bar)"
bool  v2fix_use   = input.bool(false, "Usar slope %/bar (fix)", group=gpV2Fix)
int   v2fix_look  = input.int(5, "Lookback barras", minval=1, group=gpV2Fix)
float v2fix_minPPB= input.float(0.03, "Mín %/bar", step=0.01, group=gpV2Fix)

float v2_slopePPB = math.abs((vwap - vwap[v2fix_look]) / math.max(vwap[v2fix_look], syminfo.mintick*10)) * 100.0 / v2fix_look
bool  v2_okL_fix  = (close >= vwap) and (v2_slopePPB >= v2fix_minPPB) and (math.abs((close - vwap)/close)*100.0 <= v2_maxDist)
bool  v2_okS_fix  = (close <= vwap) and (v2_slopePPB >= v2fix_minPPB) and (math.abs((close - vwap)/close)*100.0 <= v2_maxDist)

if v2fix_use
    v2_okL := v2_okL_fix
    v2_okS := v2_okS_fix

// Multiplicadores (modo Weight)-
float fp_rawL = fp_wDelta*math.max(fp_zDelta,0) + fp_wImb*math.max(fp_imb,0) + fp_wEffRes*clampf((fp_evr - fp_effResMin)/math.max(fp_effResMin,1e-9),0,1) + fp_wClosePos*fp_closePos + fp_wZVol*math.max(fp_zVol,0)
float fp_rawS = fp_wDelta*math.max(-fp_zDelta,0) + fp_wImb*math.max(-fp_imb,0) + fp_wEffRes*clampf((fp_evr - fp_effResMin)/math.max(fp_effResMin,1e-9),0,1) + fp_wClosePos*(1.0 - fp_closePos) + fp_wZVol*math.max(fp_zVol,0)
float fp_multL = fp_use and fp_mode=="Weight" ? (1.0 + fp_rawL*0.10) : 1.0
float fp_multS = fp_use and fp_mode=="Weight" ? (1.0 + fp_rawS*0.10) : 1.0
float vp_multL = vp_use and vp_mode=="Weight" ? (1.0 + vp_ctxL*0.10) : 1.0
float vp_multS = vp_use and vp_mode=="Weight" ? (1.0 + vp_ctxS*0.10) : 1.0
float v2_multL = v2_use and v2_mode=="Weight" ? (v2_okL ? 1.10 : 1.00) : 1.0
float v2_multS = v2_use and v2_mode=="Weight" ? (v2_okS ? 1.10 : 1.00) : 1.0

// StrongSignal (para Addon) & Blocks
bool strongL = (fp_zDelta > fp_deltaStrong) and (fp_closePos > 0.66) and (fp_zVol > fp_zVolStrong) and v2_okL
bool strongS = (fp_zDelta < -fp_deltaStrong) and (fp_closePos < 0.34) and (fp_zVol > fp_zVolStrong) and v2_okS
bool fpBlockL = fp_use and fp_mode=="Block" and (fp_zDelta < -fp_deltaStrong or fp_closePos < 0.34)
bool fpBlockS = fp_use and fp_mode=="Block" and (fp_zDelta >  fp_deltaStrong or fp_closePos > 0.66)
bool vpBlockL = vp_use and vp_mode=="Block" and not vpFavorL
bool vpBlockS = vp_use and vp_mode=="Block" and not vpFavorS
bool v2BlockL = v2_use and v2_mode=="Block" and not v2_okL
bool v2BlockS = v2_use and v2_mode=="Block" and not v2_okS
// Histerese nos blocks de Footprint (evita flip-flop)
float fp_releaseZDelta = fp_deltaStrong * 0.7
float fp_releaseCloseP = 0.50

var bool fpBlockedL_hold = false
var bool fpBlockedS_hold = false

// Entradas de bloqueio (mesma condição forte que você já usa)
if fp_use and fp_mode=="Block"
    if (fp_zDelta < -fp_deltaStrong or fp_closePos < 0.34)
        fpBlockedL_hold := true
    if (fp_zDelta >  fp_deltaStrong or fp_closePos > 0.66)
        fpBlockedS_hold := true

// Saídas do bloqueio (com folga / release)
if fpBlockedL_hold and (fp_zDelta > -fp_releaseZDelta and fp_closePos >= fp_releaseCloseP)
    fpBlockedL_hold := false
if fpBlockedS_hold and (fp_zDelta <  fp_releaseZDelta and fp_closePos <= (1.0 - fp_releaseCloseP))
    fpBlockedS_hold := false

// Combine com blocks instantâneos
bool fpBlockL_final = (fp_use and fp_mode=="Block" and (fp_zDelta < -fp_deltaStrong or fp_closePos < 0.34)) or fpBlockedL_hold
bool fpBlockS_final = (fp_use and fp_mode=="Block" and (fp_zDelta >  fp_deltaStrong or fp_closePos > 0.66)) or fpBlockedS_hold
// ============================================================================
// ⑦.c Contexto v60+: Gap pré-mercado, Setor, Mercado, Factor-Momentum
// ============================================================================
string gpCtx = "⑤.c Contexto (Pré, Setor, Mercado, Factor-Momentum)"

// --- Gap pré-mercado / overnight (normalizado por ATR) ---
bool   usePreGap   = input.bool(true,  "Usar Gap pré-mercado (overnight)", group=gpCtx)
float  preGapMinATRx = input.float(0.6, "Limiar: |Gap| ≥ X×ATR14", step=0.1, group=gpCtx)
float  dOpen   = request.security(syminfo.tickerid, "D", open,  barmerge.gaps_off, barmerge.lookahead_off)
float  dClose1 = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float  preGap  = dClose1 == 0 ? 0.0 : (dOpen - dClose1)
float  preGapATRx = atr14 > 0 ? math.abs(preGap) / atr14 : 0.0
bool   preGapStrong = usePreGap and (preGapATRx >= preGapMinATRx)
bool   preGapAlignL = preGapStrong and (preGap > 0)
bool   preGapAlignS = preGapStrong and (preGap < 0)

// --- Momentum do setor (símbolo índice setorial configurável) ---
string gpSector2 = "⑦.b Setor & Mercado"
string sectorSym  = input.string("BMFBOVESPA:ICON", "Símbolo do Setor (índice setorial)", group=gpSector2,
     tooltip="Ex.: ICON (Consumo), IMAT (Materiais), IFNC (Financeiro), INDX (Industrial) etc.")
int    momLenSec  = input.int(20, "Momentum do Setor: janela (barras)", minval=3, group=gpSector2)
float secClose    = request.security(sectorSym, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
float secCloseLag = nz(secClose[momLenSec], secClose)
float secROC      = nz(secClose / secCloseLag - 1.0, 0.0)
bool   secAlignL  = secROC > 0
bool   secAlignS  = secROC < 0

// --- Momentum do mercado (reusa marketSym já existente) ---
int    momLenMkt  = input.int(20, "Momentum do Mercado: janela (barras)", minval=3, group=gpSector2)
float mktCloseP    = request.security(marketSym, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
float mktCloseLag  = nz(mktCloseP[momLenMkt], mktCloseP)
float mktROC       = nz(mktCloseP / mktCloseLag - 1.0, 0.0)
bool   mktAlignL  = mktROC > 0
bool   mktAlignS  = mktROC < 0
// amortecer sinais setoriais/mercado quando correlação 20b fraca
float corrSec = ta.correlation(close, secClose, 20)
float corrMkt = ta.correlation(close, mktCloseP, 20)
secAlignL  := secAlignL and (corrSec > 0.1)
secAlignS  := secAlignS and (corrSec > 0.1)
mktAlignL  := mktAlignL and (corrMkt > 0.1)
mktAlignS  := mktAlignS and (corrMkt > 0.1)
// --- Factor-Momentum (EMA das confirmações recentes) ---
int    fmLen      = input.int(30, "Factor-Momentum: EMA de confirmações", minval=5, group=gpCtx)
float  confNowL   = 0.0
float  confNowS   = 0.0
// sinais "saudáveis": gates, VWAP2, FP pró, setor pró, mercado pró, gap pró
confNowL += passL_gates ? 1.0 : 0.0
confNowS += passS_gates ? 1.0 : 0.0
confNowL += v2_okL ? 1.0 : 0.0
confNowS += v2_okS ? 1.0 : 0.0
confNowL += (fp_zDelta > 0 and fp_closePos > 0.5) ? 1.0 : 0.0
confNowS += (fp_zDelta < 0 and fp_closePos < 0.5) ? 1.0 : 0.0
confNowL += secAlignL ? 1.0 : 0.0
confNowS += secAlignS ? 1.0 : 0.0
confNowL += mktAlignL ? 1.0 : 0.0
confNowS += mktAlignS ? 1.0 : 0.0
confNowL += preGapAlignL ? 1.0 : 0.0
confNowS += preGapAlignS ? 1.0 : 0.0

// normaliza para 0..1 (máx 6 itens)
float confNowL_norm = clampf(confNowL/6.0, 0.0, 1.0)
float confNowS_norm = clampf(confNowS/6.0, 0.0, 1.0)

var float confEMA_L = na
var float confEMA_S = na
float alpha = 2.0/(fmLen + 1.0)
confEMA_L := na(confEMA_L) ? confNowL_norm : confEMA_L + (confNowL_norm - confEMA_L) * alpha
confEMA_S := na(confEMA_S) ? confNowS_norm : confEMA_S + (confNowS_norm - confEMA_S) * alpha

// >>> cole logo após calcular confEMA_L/confEMA_S (onde já existem rvol e confEMA_L)
midAdj := inMidday
     ? (1.0 - clampf(0.4*(1.0 - confEMA_L), 0.0, 0.4))
       * (1.0 - clampf(0.3*math.max(1.0 - rvol, 0.0), 0.0, 0.3))
     : 1.0

// -----------------------------------------------------------------------------
// ⑧ Picker de método com bônus + multiplicadores de contexto
// -----------------------------------------------------------------------------
float ctxMultL  = gateMultL
float ctxMultS  = gateMultS

string pickMethL = ""
float  pickScL   = 0.0
string pickMethS = ""
float  pickScS   = 0.0

float bestL = na
if sigInsideL
    float sc = methodScore("Inside") * ctxMultL
    if na(bestL) or sc > bestL
        bestL := sc
        pickScL := sc
        pickMethL := "Inside"
if sigEngulfL
    float sc2 = methodScore("Engulf") * ctxMultL
    if na(bestL) or sc2 > bestL
        bestL := sc2
        pickScL := sc2
        pickMethL := "Engulf"
if sigDonL
    float sc3 = methodScore("Don") * ctxMultL
    if na(bestL) or sc3 > bestL
        bestL := sc3
        pickScL := sc3
        pickMethL := "Don"
if sigContL
    float sc4 = methodScore("Cont") * ctxMultL
    if na(bestL) or sc4 > bestL
        bestL := sc4
        pickScL := sc4
        pickMethL := "Cont"
if sigVWAPL
    float sc5 = methodScore("VWAP") * ctxMultL
    if na(bestL) or sc5 > bestL
        bestL := sc5
        pickScL := sc5
        pickMethL := "VWAP"
if sigORL
    float sc6 = methodScore("OR") * ctxMultL
    if na(bestL) or sc6 > bestL
        bestL := sc6
        pickScL := sc6
        pickMethL := "OR"
if sigRSIL
    float sc7 = methodScore("RSIDiv") * ctxMultL
    if na(bestL) or sc7 > bestL
        bestL := sc7
        pickScL := sc7
        pickMethL := "RSIDiv"
if sigRangeRetL
    float sc8 = methodScore("RangeRet") * ctxMultL
    if na(bestL) or sc8 > bestL
        bestL := sc8
        pickScL := sc8
        pickMethL := "RangeRet"
if sigBOPBL
    float sc9 = methodScore("BOPB") * ctxMultL
    if na(bestL) or sc9 > bestL
        bestL := sc9
        pickScL := sc9
        pickMethL := "BOPB"
if sigLW96L
    float sc10 = methodScore("LW96") * ctxMultL
    if na(bestL) or sc10 > bestL
        bestL := sc10
        pickScL := sc10
        pickMethL := "LW96"
if sigORFadeL
    float sc11 = methodScore("ORFade") * ctxMultL
    if na(bestL) or sc11 > bestL
        bestL := sc11
        pickScL := sc11
        pickMethL := "ORFade"
if sig2BarL
    float sc12 = methodScore("TwoBar") * ctxMultL
    if na(bestL) or sc12 > bestL
        bestL := sc12
        pickScL := sc12
        pickMethL := "TwoBar"
if sigBOSContL
    float sc13 = methodScore("BOSCont") * ctxMultL
    if na(bestL) or sc13 > bestL
        bestL := sc13
        pickScL := sc13
        pickMethL := "BOSCont"
if sigADXL
    float scADX = methodScore("ADX") * ctxMultL
    if na(bestL) or scADX > bestL
        bestL := scADX
        pickScL := scADX
        pickMethL := "ADX"

if sigRSIFL
    float scRSIFS = methodScore("RSIFS") * ctxMultL
    if na(bestL) or scRSIFS > bestL
        bestL := scRSIFS
        pickScL := scRSIFS
        pickMethL := "RSIFS"

if sigConfluL
    float scCon = methodScore("Conflu") * ctxMultL
    if na(bestL) or scCon > bestL
        bestL := scCon
        pickScL := scCon
        pickMethL := "Conflu"

if sigATRXL
    float scATRX = methodScore("ATRexp") * ctxMultL
    if na(bestL) or scATRX > bestL
        bestL := scATRX
        pickScL := scATRX
        pickMethL := "ATRexp"
float bestS = na
if sigInsideS
    float scS1 = methodScore("Inside") * ctxMultS
    if na(bestS) or scS1 > bestS
        bestS := scS1
        pickScS := scS1
        pickMethS := "Inside"
if sigEngulfS
    float scS2 = methodScore("Engulf") * ctxMultS
    if na(bestS) or scS2 > bestS
        bestS := scS2
        pickScS := scS2
        pickMethS := "Engulf"
if sigDonS
    float scS3 = methodScore("Don") * ctxMultS
    if na(bestS) or scS3 > bestS
        bestS := scS3
        pickScS := scS3
        pickMethS := "Don"
if sigContS
    float scS4 = methodScore("Cont") * ctxMultS
    if na(bestS) or scS4 > bestS
        bestS := scS4
        pickScS := scS4
        pickMethS := "Cont"
if sigVWAPS
    float scS5 = methodScore("VWAP") * ctxMultS
    if na(bestS) or scS5 > bestS
        bestS := scS5
        pickScS := scS5
        pickMethS := "VWAP"
if sigORS
    float scS6 = methodScore("OR") * ctxMultS
    if na(bestS) or scS6 > bestS
        bestS := scS6
        pickScS := scS6
        pickMethS := "OR"
if sigRSIS
    float scS7 = methodScore("RSIDiv") * ctxMultS
    if na(bestS) or scS7 > bestS
        bestS := scS7
        pickScS := scS7
        pickMethS := "RSIDiv"
if sigRangeRetS
    float scS8 = methodScore("RangeRet") * ctxMultS
    if na(bestS) or scS8 > bestS
        bestS := scS8
        pickScS := scS8
        pickMethS := "RangeRet"
if sigBOPBS
    float scS9 = methodScore("BOPB") * ctxMultS
    if na(bestS) or scS9 > bestS
        bestS := scS9
        pickScS := scS9
        pickMethS := "BOPB"
if sigLW96S
    float scS10 = methodScore("LW96") * ctxMultS
    if na(bestS) or scS10 > bestS
        bestS := scS10
        pickScS := scS10
        pickMethS := "LW96"
if sigORFadeS
    float scS11 = methodScore("ORFade") * ctxMultS
    if na(bestS) or scS11 > bestS
        bestS := scS11
        pickScS := scS11
        pickMethS := "ORFade"
if sig2BarS
    float scS12 = methodScore("TwoBar") * ctxMultS
    if na(bestS) or scS12 > bestS
        bestS := scS12
        pickScS := scS12
        pickMethS := "TwoBar"
if sigBOSContS
    float scS13 = methodScore("BOSCont") * ctxMultS
    if na(bestS) or scS13 > bestS
        bestS := scS13
        pickScS := scS13
        pickMethS := "BOSCont"
if sigADXS
    float scADXs = methodScore("ADX") * ctxMultS
    if na(bestS) or scADXs > bestS
        bestS := scADXs
        pickScS := scADXs
        pickMethS := "ADX"

if sigRSIFS
    float scRSIFSs = methodScore("RSIFS") * ctxMultS
    if na(bestS) or scRSIFSs > bestS
        bestS := scRSIFSs
        pickScS := scRSIFSs
        pickMethS := "RSIFS"

if sigConfluS
    float scCons = methodScore("Conflu") * ctxMultS
    if na(bestS) or scCons > bestS
        bestS := scCons
        pickScS := scCons
        pickMethS := "Conflu"

if sigATRXS
    float scATRXs = methodScore("ATRexp") * ctxMultS
    if na(bestS) or scATRXs > bestS
        bestS := scATRXs
        pickScS := scATRXs
        pickMethS := "ATRexp"
bool hasMethL = pickMethL != ""
bool hasMethS = pickMethS != ""
bool passScoreL = (not useScoreCut) or (pickScL >= scoreMinCut)
bool passScoreS = (not useScoreCut) or (pickScS >= scoreMinCut)
// -----------------------------------------------------------------------------
// ⑨ Sizer & Guard-Rails (fusão 55.007 + 59.003)
//  - sizing por risco (R$) com arredondamento por passo e caps
//  - RiskWeighted pelos gates (rw_min→rw_max)
//  - multiplicadores FP/VP/VWAP2 (modo Weight)
//  - throttle de Midday (Throttle/Block)
//  - guarda de Ganho Mínimo Projetado (R$)
//  - bias setorial opcional
// -----------------------------------------------------------------------------
string gpSizer = "⑥ Sizer & Guard-Rail"
bool   rw_use       = input.bool(true,  "RiskWeighted: gates ajustam quantidade", group=gpSizer)
float  rw_min       = input.float(0.6,  "RiskWeighted: fator mín", step=0.05, group=gpSizer)
float  rw_max       = input.float(1.6,  "RiskWeighted: fator máx", step=0.05, group=gpSizer)
float maxBoostPct = input.float(20.0, "Permitir exceder máx em % se sinal forte", minval=0, step=5)
// >>> coloque logo depois do picker (após definir pickMethL/pickMethS e pickScL/pickScS)
bool isStrongMethodL = pickMethL=="Don" or pickMethL=="Inside" or pickMethL=="Cont" or pickMethL=="BOPB" or pickMethL=="RangeRet" or pickMethL=="LW96"
bool isStrongMethodS = pickMethS=="Don" or pickMethS=="Inside" or pickMethS=="Cont" or pickMethS=="BOPB" or pickMethS=="RangeRet" or pickMethS=="LW96"
isStrongMethodL := isStrongMethodL or pickMethL=="ADX" or pickMethL=="Conflu"
isStrongMethodS := isStrongMethodS or pickMethS=="ADX" or pickMethS=="Conflu"
// --- Políticas de mínimo/máximo & boosts por método ---
string minQtyPolicy = input.string("BumpToMin", "Se < mínimo:", 
     options=["Block","BumpToMin"], group=gpSizer)
string maxQtyPolicy = input.string("Cap", "Se > máximo:", 
     options=["Cap","Block","BoostIfMethod"], group=gpSizer)
float  boostPctAll     = input.float(0.0, "Boost % (geral)", minval=0, step=1, group=gpSizer)
float  boostPctLwDon   = input.float(10.0, "Boost % extra p/ LW9.6/Don", minval=0, step=1, group=gpSizer)
// (opcional) limiar de score p/ "muito forte"
float scoreStrongThresh = input.float(1.6, "Limiar de score p/ 'muito forte'", step=0.1, group=gpSizer)
bool veryStrongL = strongL or isStrongMethodL or (pickScL >= scoreStrongThresh)
bool veryStrongS = strongS or isStrongMethodS or (pickScS >= scoreStrongThresh)

// Confirmação adicional: exige fechamento favorável, exceto se método muito forte
bool needConfirmL = (pickMethL != "") and not veryStrongL
bool needConfirmS = (pickMethS != "") and not veryStrongS
bool confirmOK_L  = not needConfirmL or (close > open)   // candle fechou “a favor”
bool confirmOK_S  = not needConfirmS or (close < open)

// Base qty por risco (cash) com proteção
float pvSafe = math.max(pv, 1.0)
float stopDistCashBaseSafe = math.max(stopDistCashBase, syminfo.mintick*pvSafe)
float rawBaseQty = stopDistCashBaseSafe > 0 ? (riskBRL / stopDistCashBaseSafe) : 0.0
// Cap por ordem
rawBaseQty := math.min(rawBaseQty, maxQtyPerOrder)
// Round por passo
float baseQty = round_to_step(rawBaseQty, lotStep)

// Se base=0, tentar 1 passo se o risco tolerar
if allowForceMinLot and baseQty == 0
    float cashRiskOneStep = stopDistCashBaseSafe * lotStep
    float maxRiskAllow    = riskBRL * (1.0 + maxOverRiskPct/100.0)
    if cashRiskOneStep <= maxRiskAllow
        baseQty := lotStep

// Midday throttle / block (aplicar sobre a base, antes do RW/multiplicadores)
if inMidday and midMode=="Throttle"
    float midEff = clampf(midThrottle * midAdj, 0.0, 1.0)
    baseQty := round_to_step(baseQty * midEff, lotStep)
if inMidday and midMode=="Block"
    baseQty := 0.0

// ===========================================================================
// ⑨ Sizer 2.0 (confirmações → multiplicador robusto) + caps inteligentes
// ===========================================================================

string gpSizer2 = "⑥ Sizer & Guard-Rail (v60+)"
// faixas alvo do multiplicador final
float multWeak      = input.float(0.80, "Multiplicador quando fraco", step=0.05, group=gpSizer2)
float multNeutral   = input.float(1.00, "Multiplicador neutro",      step=0.05, group=gpSizer2)
float multStrong    = input.float(1.80, "Multiplicador quando forte",step=0.05, group=gpSizer2)
// pesos das confirmações (ajuste para “perfil da casa”)
float wGates = input.float(0.30, "Peso: Gates OK", step=0.05, group=gpSizer2)
float wVWAP2 = input.float(0.20, "Peso: VWAP2 OK", step=0.05, group=gpSizer2)
float wFP    = input.float(0.20, "Peso: Footprint pró", step=0.05, group=gpSizer2)
float wSec   = input.float(0.10, "Peso: Setor pró", step=0.05, group=gpSizer2)
float wMkt   = input.float(0.10, "Peso: Mercado pró", step=0.05, group=gpSizer2)
float wGap   = input.float(0.10, "Peso: Gap pró", step=0.05, group=gpSizer2)
float wMethodStrong = input.float(0.10, "Bônus: Método forte", step=0.05, group=gpSizer2)
float wFactorMom    = input.float(0.15, "Bônus: Factor-Momentum (EMA)", step=0.05, group=gpSizer2)

// baseQty já calculada acima (por risco R$ + round_to_step + midday throttle)
float qtyL = baseQty
float qtyS = baseQty

// RiskWeighted pelos gates (já na sua v60)
if rw_use
    float fL = rw_min + (rw_max - rw_min) * bonusLnorm
    float fS = rw_min + (rw_max - rw_min) * bonusSnorm
    qtyL := round_to_step(qtyL * fL, lotStep)
    qtyS := round_to_step(qtyS * fS, lotStep)

// --- Score de confirmações → multiplicador suave 0.8..1.8 --
float scoreL_conf = 0.0
float scoreS_conf = 0.0
float wSum = wGates + wVWAP2 + wFP + wSec + wMkt + wGap

scoreL_conf += (passL_gates ? wGates : 0)
scoreS_conf += (passS_gates ? wGates : 0)
scoreL_conf += (v2_okL ? wVWAP2 : 0)
scoreS_conf += (v2_okS ? wVWAP2 : 0)
scoreL_conf += ((fp_zDelta > 0 and fp_closePos > 0.5) ? wFP : 0)
scoreS_conf += ((fp_zDelta < 0 and fp_closePos < 0.5) ? wFP : 0)
scoreL_conf += (secAlignL ? wSec : 0)
scoreS_conf += (secAlignS ? wSec : 0)
scoreL_conf += (mktAlignL ? wMkt : 0)
scoreS_conf += (mktAlignS ? wMkt : 0)
scoreL_conf += (preGapAlignL ? wGap : 0)
scoreS_conf += (preGapAlignS ? wGap : 0)

// normaliza 0..1
scoreL_conf := wSum > 0 ? clampf(scoreL_conf / wSum, 0.0, 1.0) : 0.5
scoreS_conf := wSum > 0 ? clampf(scoreS_conf / wSum, 0.0, 1.0) : 0.5

// mapeia para [multWeak .. multStrong] com leve viés pela “força do método” e factor-momentum
float methodKickL = isStrongMethodL ? wMethodStrong : 0.0
float methodKickS = isStrongMethodS ? wMethodStrong : 0.0
float momKickL    = wFactorMom * clampf(confEMA_L, 0.0, 1.0)
float momKickS    = wFactorMom * clampf(confEMA_S, 0.0, 1.0)

float scoreL_final = clampf(scoreL_conf + methodKickL + momKickL, 0.0, 1.0)
float scoreS_final = clampf(scoreS_conf + methodKickS + momKickS, 0.0, 1.0)

float multL = multWeak + (multStrong - multWeak) * scoreL_final
float multS = multWeak + (multStrong - multWeak) * scoreS_final

qtyL := round_to_step(qtyL * multL, lotStep)
qtyS := round_to_step(qtyS * multS, lotStep)

// --- Multiplicadores de contexto existentes (FP/VP/VWAP2 Weight) ---
// --- Multiplicadores de contexto existentes (FP/VP/VWAP2 Weight) ---
qtyL := round_to_step(qtyL * (fp_multL * vp_multL * v2_multL), lotStep)
qtyS := round_to_step(qtyS * (fp_multS * vp_multS * v2_multS), lotStep)

// Aplica o efeito Weight do AVWAP Multiâncora no lugar correto (depois do Sizer)
qtyL := round_to_step(qtyL * avma_mult, lotStep)
qtyS := round_to_step(qtyS * avma_mult, lotStep)

// === Boosts dos novos gates quando em modo "Weight" ===
if useYZ and yzMode=="Weight" and gYZ
    qtyL := round_to_step(qtyL * (1.0 + yzWeightGain/100.0), lotStep)
    qtyS := round_to_step(qtyS * (1.0 + yzWeightGain/100.0), lotStep)

if useCUSUM and cusumMode=="Weight" and gCUSUM
    qtyL := round_to_step(qtyL * (1.0 + cusumBoost/100.0), lotStep)
    qtyS := round_to_step(qtyS * (1.0 + cusumBoost/100.0), lotStep)

if useHOD and hodMode=="Weight"
    float fH = hodStrong ? hodStrongF : hodWeakF
    qtyL := round_to_step(qtyL * fH, lotStep)
    qtyS := round_to_step(qtyS * fH, lotStep)

// --- Preferência de boost por método ---
bool methIsLwDonL = (pickMethL=="LW96" or pickMethL=="Don")
bool methIsLwDonS = (pickMethS=="LW96" or pickMethS=="Don")

float boostL = boostPctAll + (methIsLwDonL ? boostPctLwDon : 0.0)
float boostS = boostPctAll + (methIsLwDonS ? boostPctLwDon : 0.0)

// --- Guard-rails mínimo ---
if qtyL < minQtyPerTrade
    if minQtyPolicy == "Block"
        qtyL := 0
    else
        qtyL := ceil_to_step(minQtyPerTrade, lotStep)

if qtyS < minQtyPerTrade
    if minQtyPolicy == "Block"
        qtyS := 0
    else
        qtyS := ceil_to_step(minQtyPerTrade, lotStep)

// --- Guard-rails máximo (com opção de boost) ---
float maxAllow = maxQtyPerOrder * (1.0 + maxBoostPct/100.0)  // você já tinha overcap condicional
// 1) primeiro, se configurado, aplicar boost
if maxQtyPolicy == "BoostIfMethod"
    qtyL := boost_qty(qtyL, boostL, lotStep)
    qtyS := boost_qty(qtyS, boostS, lotStep)

// 2) depois, tratar violação do máximo
if qtyL > maxQtyPerOrder
    if maxQtyPolicy == "Block"
        qtyL := 0
    else // "Cap" ou "BoostIfMethod"
        qtyL := round_to_step(math.min(qtyL, maxAllow), lotStep)

if qtyS > maxQtyPerOrder
    if maxQtyPolicy == "Block"
        qtyS := 0
    else
        qtyS := round_to_step(math.min(qtyS, maxAllow), lotStep)

// 3) respeita passe no final (garantia)
qtyL := round_to_step(qtyL, lotStep)
qtyS := round_to_step(qtyS, lotStep)
// Garantia final: respeita passo e mínimo (pós-caps/boosts)
if qtyL > 0 and qtyL < minQtyPerTrade
    qtyL := minQtyPolicy=="Block" ? 0 : ceil_to_step(minQtyPerTrade, lotStep)
if qtyS > 0 and qtyS < minQtyPerTrade
    qtyS := minQtyPolicy=="Block" ? 0 : ceil_to_step(minQtyPerTrade, lotStep)
// reforço final de passo (defensivo)
qtyL := qtyL>0 ? round_to_step(qtyL, lotStep) : 0
qtyS := qtyS>0 ? round_to_step(qtyS, lotStep) : 0
// --- Guard-rails (não corta para baixo do mínimo; cap com overcap opcional) ---
if minQtyPolicy=="BumpToMin"
    float minStep = ceil_to_step(minQtyPerTrade, lotStep)
    if qtyL > 0
        qtyL := math.max(qtyL, minStep)
    if qtyS > 0
        qtyS := math.max(qtyS, minStep)

// overcap (ultrapassar máx em X% se sinal MUITO forte)
float maxQtyAllow = maxQtyPerOrder * (1.0 + maxBoostPct/100.0)
qtyL := veryStrongL ? math.min(qtyL, maxQtyAllow) : math.min(qtyL, maxQtyPerOrder)
qtyS := veryStrongS ? math.min(qtyS, maxQtyAllow) : math.min(qtyS, maxQtyPerOrder)

// respeita múltiplos do passo no final
qtyL := round_to_step(qtyL, lotStep)
qtyS := round_to_step(qtyS, lotStep)

// Suavização leve (histerese) – opcional
var float _qPrevL = na
var float _qPrevS = na
float _maxJump = 3.0 * lotStep
if not na(_qPrevL)
    qtyL := round_to_step(_qPrevL + clampf(qtyL - _qPrevL, -_maxJump, _maxJump), lotStep)
if not na(_qPrevS)
    qtyS := round_to_step(_qPrevS + clampf(qtyS - _qPrevS, -_maxJump, _maxJump), lotStep)
_qPrevL := qtyL
_qPrevS := qtyS


// ----------------------------------------------------------------------------
// ⑩ Guard-rail: ganho mínimo projetado (TPs)
// -----------------------------------------------------------------------------
int tp1PctEff = useTP1 ? (useTP2 ? tp1Percent : 100) : 0
int tp2PctEff = useTP2 ? (100 - tp1PctEff) : 0
tp1PctEff := int(clampf(tp1PctEff, 0, 100))
tp2PctEff := int(clampf(tp2PctEff, 0, 100))

float q1L = useTP1 ? (qtyL * (tp1PctEff/100.0)) : 0.0
float q2L = useTP2 ? (qtyL - q1L) : 0.0
float q1S = useTP1 ? (qtyS * (tp1PctEff/100.0)) : 0.0
float q2S = useTP2 ? (qtyS - q1S) : 0.0

q1L := round_to_step(q1L, lotStep)
q2L := round_to_step(q2L, lotStep)
q1S := round_to_step(q1S, lotStep)
q2S := round_to_step(q2S, lotStep)

float g1L = (q1L > 0 and not na(tp1ProjL)) ? math.max((tp1ProjL - basePxProj) * pvSafe * q1L, 0.0) : 0.0
float g2L = (q2L > 0 and not na(tp2ProjL)) ? math.max((tp2ProjL - basePxProj) * pvSafe * q2L, 0.0) : 0.0
float g1S = (q1S > 0 and not na(tp1ProjS)) ? math.max((basePxProj - tp1ProjS) * pvSafe * q1S, 0.0) : 0.0
float g2S = (q2S > 0 and not na(tp2ProjS)) ? math.max((basePxProj - tp2ProjS) * pvSafe * q2S, 0.0) : 0.0

float gainProjL = g1L + g2L
float gainProjS = g1S + g2S

// === PATCH E: Slippage-aware ===
string gpSlip = "②.d Execução & Slippage"
bool  slip_use   = input.bool(false, "Penalizar por slippage", group=gpSlip)
string slip_mode = input.string("TightenMinGain", "Modo", options=["TightenMinGain","TightenBoth"], group=gpSlip)
int   slipTicks  = input.int(2, "Custo por lado (ticks)", minval=0, group=gpSlip)
float slipPct    = input.float(0.00, "Ou custo % (0 para ignorar)", minval=0, step=0.01, group=gpSlip)

// custo monetário estimado por ENTRADA+SAÍDA (duas passagens)
float slipPerSideCash = (slipTicks>0 ? (slipTicks*syminfo.mintick*pv) : 0.0) + (slipPct>0 ? (close*slipPct/100.0)*pv : 0.0)
float slipRoundTrip   = 2.0 * slipPerSideCash

// Ajuste “TightenBoth” — fica logo após slipRoundTrip
if slip_use and slip_mode=="TightenBoth"
    float adj = slipPerSideCash/pv
    // 1) Aperta o STOP em preço...
    stopDistPriceBase := math.max(stopDistPriceBase - adj, syminfo.mintick)
    //    ...e mantém o CASH coerente
    stopDistCashBase  := stopDistPriceBase * pv

    // 2) Micro-bônus de R **sem** tocar no input:
    tp1R_base_eff := tp1R_base + 0.05

// reavalia RR projetado com os valores ajustados
float _t1R_now_afterSlip = tp1R_calc(tp1R_base_eff)
rrProj := stopDistCashBase > 0 ? _t1R_now_afterSlip : na
rrOK   := (not rr_use) or (not na(rrProj) and rrProj >= rr_min)

// aplica na projeção de ganho
float gainProjL_adj = slip_use ? math.max(gainProjL - slipRoundTrip, 0.0) : gainProjL
float gainProjS_adj = slip_use ? math.max(gainProjS - slipRoundTrip, 0.0) : gainProjS

// === Robustez regime-aware (ATR% e RVOL aumentam a exigência) ===
float dynMinGain = mg_minGain * (1 + (atrPct/100.0)*0.5) * (1 + math.max(rvol - 1.0, 0.0) * 0.3)
bool gainOK_L = (not mg_use) or (qtyL > 0 and gainProjL_adj >= dynMinGain)
bool gainOK_S = (not mg_use) or (qtyS > 0 and gainProjS_adj >= dynMinGain)


// -----------------------------------------------------------------------------
// ⑪ Permissões finais (tempo/sessão/diários/gates/score/blocks/1 por barra)
// -----------------------------------------------------------------------------
// ⑪ Permissões finais — separar núcleo de sinal do envio de ordem
bool blockSameBar  = not sameBarEntries
bool coreMaskTime  = inSession and (not timeToFlat) and delayGate

// Núcleo sem dependência de allowOrders (para INDICADOR e ALERTAS)
bool coreMaskCore  = coreMaskTime and not inCooldown and not hitMaxLoss and not overDayTrades and not overRolling and not inSoftPause

// Versão antiga que bloqueava tudo no modo Produção
bool coreMask     = coreMaskTime and not inCooldown and not hitMaxLoss and not overDayTrades

// === Bloqueios dos novos gates (modo "Block") ===
// === Bloqueios dos novos gates (modo "Block") ===
bool yzBlockL   = useYZ   and yzMode   == "Block" and not gYZ
bool yzBlockS   = useYZ   and yzMode   == "Block" and not gYZ
bool cusBlockL  = useCUSUM and cusumMode=="Block" and not gCUSUM
bool cusBlockS  = useCUSUM and cusumMode=="Block" and not gCUSUM
bool hodBlock   = useHOD  and hodMode  == "Block" and not hodStrong

allowCoreL := allowCoreL and not (yzBlockL or cusBlockL or hodBlock)
allowCoreS := allowCoreS and not (yzBlockS or cusBlockS or hodBlock)

if sideMode == "LongOnly"
    allowCoreS := false
if sideMode == "ShortOnly"
    allowCoreL := false

// Bloqueios FP/VP/VWAP2 (aplicam em ambos)
if fpBlockL_final or vpBlockL or v2BlockL
    allowCoreL := false
if fpBlockS_final or vpBlockS or v2BlockS
    allowCoreS := false

// ----- núcleo de tempo/limites já prontos no seu código -----
bool coreOK = inSession and not timeToFlat and delayGate
coreOK := coreOK and not inCooldown and not hitMaxLoss and not overDayTrades and not overRolling and not inSoftPause

// ----- pronto por lado (inclui MinGain/RR + método escolhido)
bool longReady  = coreOK and allowCoreL and confirmOK_L and ((not mg_use) or gainOK_L) and ((not rr_use) or rrOK) and hasMethL and ((not useScoreCut) or passScoreL)
bool shortReady = coreOK and allowCoreS and confirmOK_S and ((not mg_use) or gainOK_S) and ((not rr_use) or rrOK) and hasMethS and ((not useScoreCut) or passScoreS)

// ==== Sanity LOCK: respeitar passo (lotStep) antes de enviar ====
float qL_send = round_to_step(qtyL, lotStep)
float qS_send = round_to_step(qtyS, lotStep)

//-------------------------------------------------------------------------
// ⑫ Execução (Entradas / Addon / Saídas com IDs explícitos)
// -----------------------------------------------------------------------------
const string ID_LE     = "LE"
const string ID_LE_TP1 = "LE_TP1"
const string ID_LE_TP2 = "LE_TP2"
const string ID_LE_SL  = "LE_SL"
const string ID_SE     = "SE"
const string ID_SE_TP1 = "SE_TP1"
const string ID_SE_TP2 = "SE_TP2"
const string ID_SE_SL  = "SE_SL"

// ==== One-entry arbiter (core + gates + score + desempate) ====
bool sameBar = (not na(lastEntryBar)) and (bar_index == lastEntryBar)
bool canEnterThisBar = canSendThisBar

bool candL = longReady
bool candS = shortReady

// Desempate por score somente se ambos elegíveis
if candL and candS
    bool chooseL = na(pickScS) or (not na(pickScL) and pickScL >= pickScS)
    if chooseL
        candS := false
    else
        candL := false

// Entradas (um único envio por barra)
if allowOrders and candL and canSendNow and (qL_send > 0)
    strategy.entry(ID_LE, strategy.long,  qty=qL_send, comment=pickMethL)
    lastEntryBar := bar_index
    lastSendBar  := bar_index
    canSendNow   := false

if allowOrders and candS and canSendNow and (qS_send > 0)
    strategy.entry(ID_SE, strategy.short, qty=qS_send, comment=pickMethS)
    lastEntryBar := bar_index
    lastSendBar  := bar_index
    canSendNow   := false

var bool _hadPosPrev = false
bool _openedNow = (strategy.position_size != 0 and not _hadPosPrev)  // transição flat → posicionado

if _openedNow
    array.push(entryTimes, int(time))
    tradesToday += 1
    _entryAvg := strategy.position_avg_price
    // arma manutenção mesmo que o alerta de entrada não tenha sido disparado
    _sentEntry := true
    _entryMs   := clockMs()
    _entryQty  := math.abs(strategy.position_size)
    _entrySide := strategy.position_size > 0 ? "LONG" : "SHORT"

// Atualiza o estado intrabar no final
_hadPosPrev := (strategy.position_size != 0)

// Addon (sinal forte + PnL do dia ≥ k×R, respeita pyramiding/contagem)
string gpAdd = "⑨.b Addon (só em sinal forte)"
bool  addon_use = input.bool(false, "Usar Addon forte", group=gpAdd)
float addon_dayPnL_R = input.float(2.5, "Liberar se PnL do dia ≥ k×R", minval=0.0, step=0.1, group=gpAdd)
string addon_qty_mode = input.string("LotStep", "Qtd do Addon", options=["LotStep","BaseQtyUnit"], group=gpAdd)
int    addon_maxAdds  = input.int(3, "Máx addons por posição", minval=0, group=gpAdd)
var int addonCount = 0
int pyrMaxCheck = input.int(3, "Pyramiding (p/ checagem do Addon)", minval=0, group=gpAdd,
     tooltip="Repita aqui o mesmo valor definido no cabeçalho strategy(..., pyramiding=X, ...)")
if ta.change(time("D")) != 0
    addonCount := 0

// ===== Addon: regras e quantidade =====
bool  addonAllowed = false
float addonQty     = 0.0

if addon_use
    bool dayOK   = profitToday >= addon_dayPnL_R * riskBRL
    bool countOK = addonCount < addon_maxAdds
    bool pyrOK   = (strategy.opentrades < pyrMaxCheck)
    bool barOK   = canSendThisBar and (sameBarEntries or not sameBar)
    addonQty     := addon_qty_mode == "LotStep" ? lotStep : baseQty
    addonAllowed := dayOK and countOK and pyrOK and barOK

// [ADDON-AUDIT] ↓↓↓ cole após calcular `addonAllowed`
var int _lastAddonBar = -1
// trava definitiva 1x por barra se configurado
if addonAllowed
    addonAllowed := addonAllowed and (sameBarEntries or bar_index > _lastAddonBar) and canSendNow

// plot de diagnóstico: quando addonAllowed true
plotshape(addonAllowed, title="ADDON allowed", style=shape.circle, location=location.top,
     color=color.new(color.green, 0), size=size.tiny, text="ADDON")
// memorize quando disparar
// (mantenha o set abaixo perto de cada envio do strategy.entry do Addon)

// trava para não enviar addon duas vezes no mesmo candle quando 1 por barra está desligado
if not sameBarEntries and sameBar
    addonAllowed := false

// + canSendThisBar para respeitar 1 por candle
addonAllowed := addonAllowed and (strategy.opentrades < pyrMaxCheck) and canSendNow
if not sameBarEntries and sameBar
    addonAllowed := false

// Addon reusando a mesma tag de entrada (cobertura de exits garantida)
if addonAllowed and strongL and strategy.position_size > 0
    strategy.entry(ID_LE, strategy.long,  qty=addonQty, comment="ADD")
    addonCount += 1
    lastEntryBar := bar_index
    lastSendBar  := bar_index
    _lastAddonBar := bar_index

if addonAllowed and strongS and strategy.position_size < 0
    strategy.entry(ID_SE, strategy.short, qty=addonQty, comment="ADD")
    addonCount += 1
    lastEntryBar := bar_index
    lastSendBar  := bar_index
    _lastAddonBar := bar_index

// ------------------------- Saídas e Proteções -------------------------------
// Config extra para impedir “mesmo horário” (hold mínimo)
string gpExitPlus = "②.c Regras extras de saída"
bool  strictLotOnExits= input.bool(true,  "Ajustar TP1% para respeitar passo nas saídas", group=gpExitPlus)

// Capturar idade da posição (sem reset por parcial/addon)
if strategy.position_size == 0 and strategy.position_size[1] != 0
    posEntryBar := na
else if strategy.position_size != 0 and strategy.position_size[1] == 0
    posEntryBar := bar_index


// Reset fino: só quando muda de lado (flat↔pos ou flip), não em parciais/addons
// Reset fino: usa lado **efetivo** (funciona em Produção)
int _sideEffNow = allowOrders
     ? (strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0)
     : (_entrySide == "LONG" ? 1 : _entrySide == "SHORT" ? -1 : 0)

if _sideEffNow != _lastSide
    _sentMaint := false
_lastSide := _sideEffNow

int posAge = na(posEntryBar) ? 0 : (bar_index - posEntryBar)

// TP/TP2 com base no preço de referência escolhido
float basePxExec = (tpRefSrc=="AvgPrice" and strategy.position_size != 0) ? strategy.position_avg_price : close
float tp1L = getTP1Price(true,  basePxExec)
float tp2L = useTP2 ? getTP2Price(true,  basePxExec) : na
float tp1S = getTP1Price(false, basePxExec)
float tp2S = useTP2 ? getTP2Price(false, basePxExec) : na

// --- Auxiliares consistentes para este bloco ---
float posQtyAbs = math.abs(strategy.position_size)      // tamanho absoluto da posição
float tp1PctAdj = tp1PctEff    
float posQ      = math.abs(strategy.position_size)

// Ajuste de TP1% para respeitar passo do lote no momento da execução (opcional)
if strictLotOnExits and posQtyAbs > 0 and tp1PctEff > 0
    float targetQ = round_to_step(posQtyAbs * (tp1PctEff/100.0), lotStep)
    targetQ := clampf(targetQ, 0.0, posQtyAbs)
    tp1PctAdj := posQtyAbs == 0 ? 0.0 : (targetQ / posQtyAbs) * 100.0

// MinHold: TP/BE/Trail só após N barras
bool okHoldTP = posAge >= minHoldBars

// Quantidades “em números absolutos” já respeitando o passo
float qTP1  = round_to_step(posQtyAbs * (tp1PctAdj/100.0), lotStep)
float qTP2  = round_to_step(posQtyAbs * math.max(0.0, (100.0 - tp1PctAdj)/100.0), lotStep)

// Percentual do TP2 é o complemento
float tp2PctAdj = 100.0 - tp1PctAdj
tp2PctAdj := tp2PctAdj < 0 ? 0 : tp2PctAdj

// STOP base vs STOP por X×R (o mais apertado prevalece)
// --- STOP (válido com posição OU flat) ---
// Base de preço: se já posicionado usa avg; se flat usa close (mesmo base do "preco" da mensagem)
float avg = strategy.position_size != 0 ? strategy.position_avg_price : close

// XR por lado: se já posicionado usa posQtyAbs; se flat usa a qty planejada daquele lado
float riskPerShareL = strategy.position_size != 0
     ? (posQtyAbs > 0 ? (riskBRL/posQtyAbs) : 0.0)
     : (qL_send > 0 ? (riskBRL/qL_send) : 1e10)   // 1e10 evita apertar o stop se não houver qty

float riskPerShareS = strategy.position_size != 0
     ? (posQtyAbs > 0 ? (riskBRL/posQtyAbs) : 0.0)
     : (qS_send > 0 ? (riskBRL/qS_send) : 1e10)

float stopDistXR_L = useXRiskStop ? (xRiskMult * (riskPerShareL / pvSafe)) : 1e10
float stopDistXR_S = useXRiskStop ? (xRiskMult * (riskPerShareS / pvSafe)) : 1e10

// Mantém nomes originais:
float stopLong  = avg - math.min(stopDistPriceBase, stopDistXR_L)
float stopShort = avg + math.min(stopDistPriceBase, stopDistXR_S)

// Estado efetivo estrito: só considera posição quando de fato temos fill (ou simulação de fill no modo Indicador)

// Se holdAffectsStop=false, STOP sempre ativo; senão, só após minHold
bool okHoldStop = holdAffectsStop ? (posAge >= minHoldBars) : true
if allowOrders and okStopExec and okHoldStop
    strategy.exit(ID_LE_SL,  from_entry=ID_LE, stop=stopLong)
    strategy.exit(ID_SE_SL,  from_entry=ID_SE, stop=stopShort)


b(x)=>(x?"true":"false")
num(x)=>na(x)?"null":str.tostring(x,format.mintick)
hora_br()=>str.tostring(hour(time,"America/Sao_Paulo"),"00")+":"+str.tostring(minute(time,"America/Sao_Paulo"),"00")

// v60.002 — espelhos globais p/ JSON (preço e qty dos TPs)
var float g_tp1_px  = na
var float g_tp2_px  = na
var float g_tp1_qty = na
var float g_tp2_qty = na


// Substitui a função anterior: NADA de str.format — só concatenação 
// v60.002 — JSON estendido com TP1/TP2 separados (px/qty) reaproveitando variáveis existentes
// v60.002 — mantém assinatura original; acrescenta campos tp1_px/qty e tp2_px/qty
f_json_4082(string evento,string tipo,string metodo,string ativo,string exchange,string tf,float preco,float tp1,float tp2,float stopPx,float quantidade,float posQtyAtual,float posQtyRem,float tp1Pct,float tp2Pct,string codigo,string horaBR,float rr,string status,string versao)=>"{\"evento\":\""+evento+"\",\"tipo\":\""+tipo+"\",\"metodo\":\""+(metodo==""?"core":metodo)+"\",\"continuacao\":"+b(mCont_on)+",\"ativo\":\""+ativo+"\",\"exchange\":\""+exchange+"\",\"tf\":\""+tf+"\",\"preco\":"+num(preco)+",\"tp1\":"+num(tp1)+",\"tp2\":"+num(tp2)+",\"qtdtp1\":"+num(g_tp1_qty)+",\"qtdtp2\":"+num(g_tp2_qty)+",\"stop\":"+num(stopPx)+",\"quantidade\":"+num(quantidade)+",\"codigo\":\""+codigo+"\",\"hora_br\":\""+horaBR+"\",\"rr\":"+num(rr)+",\"status\":\""+status+"\",\"versao\":\""+versao+"\",\"cfg\":{\"pos\":{\"qty_atual\":"+num(posQtyAtual)+",\"qty_rem_evento\":"+num(posQtyRem)+",\"passo\":"+num(lotStep)+"},\"geral\":{\"allowLong\":"+b(sideMode!="ShortOnly")+",\"allowShort\":"+b(sideMode!="LongOnly")+"},\"metodos\":{\"Inside\":"+b(mInside_on)+",\"Engulf\":"+b(mEngulf_on)+",\"Don\":"+b(mDon_on)+",\"Cont\":"+b(mCont_on)+"},\"limits\":{\"cooldownBars\":"+num(cooldownBars)+",\"maxTradesDay\":"+num(tradesMaxDia)+"},\"exits\":{\"tp1_pct\":"+num(tp1Pct)+",\"tp2_pct\":"+num(tp2Pct)+"}}}"

// ===== MEMÓRIA DE ALERTAS (declare uma única vez no script) ====
var int lastAlertBarL     = -1
var int lastAlertBarS     = -1
var int lastTp1AlertBarL  = -1
var int lastTp1AlertBarS  = -1
var int lastTp2AlertBarL  = -1
var int lastTp2AlertBarS  = -1
var int lastStopAlertBarL = -1
var int lastStopAlertBarS = -1
var int lastAlertAnyBar = -1

// ===== PATCH: Flat-Lock anti-eco =====
var int  _flatLockUntilBar = -1

// ativo nesta barra?
bool flatLocked = flatlock_enable and (bar_index <= _flatLockUntilBar)

// limpar quando abre posição nova OU virou o dia
if (strategy.position_size != 0 and strategy.position_size[1] == 0) or (ta.change(time("D")) != 0)
    _flatLockUntilBar := -1

// Anti-colisão de código no dia
var string _lastCodeSentToday = ""
// Disparar 1x a manutenção de fechamento
var bool _sentCloseMaint = false

if ta.change(time("D"))!=0
    _seqToday:=0
    _lastCodeSentToday := ""   // <- add esta linha

// === 'tipo' para a CHAVE: sempre a direção da ENTRADA (compra p/ long, venda p/ short) ===
// Sem usar operador ternário:
int sideKey = 0

if allowOrders
    if strategy.position_size > 0
        sideKey := 1
    else
        if strategy.position_size < 0
            sideKey := -1
        else
            sideKey := 0
else
    // Modo Indicador/Alertas: usa a memória _entrySide ("LONG"/"SHORT")
    if _entrySide == "LONG"
        sideKey := 1
    else
        if _entrySide == "SHORT"
            sideKey := -1
        else
            sideKey := 0

string tipoKey = ""
if sideKey > 0
    tipoKey := "compra"   // entrada de long foi compra
else
    if sideKey < 0
        tipoKey := "venda" // entrada de short foi venda
    else
        tipoKey := ""      // flat / indefinido (não deve alertar)

// --- ESTADO EFETIVO PARA ALERTAS (funciona em Backtest e em Indicador) ---
bool  hasPosEff = allowOrders ? (strategy.position_size != 0)
                              : (_sentEntry and _entryQty > 0 and not na(_entryAvg))

int   sideEff   = allowOrders ? (strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0)
                              : (_entrySide == "LONG" ? 1 : _entrySide == "SHORT" ? -1 : 0)

float avgEff    = allowOrders ? strategy.position_avg_price : _entryAvg
float qtyEff    = allowOrders ? math.abs(strategy.position_size) : _entryQty
// Quantidade mínima para considerar “tem posição” nos ALERTAS
bool qtyEffOk = qtyEff >= (lotStep - 1e-6)

float basePxExecEff = (tpRefSrc == "AvgPrice" and hasPosEff) ? avgEff : close
float tp1L_eff      = getTP1Price(true,  basePxExecEff)
float tp2L_eff      = useTP2 ? getTP2Price(true,  basePxExecEff) : na
float tp1S_eff      = getTP1Price(false, basePxExecEff)
float tp2S_eff      = useTP2 ? getTP2Price(false, basePxExecEff) : na

float riskPerShareEff    = qtyEff > 0 ? (riskBRL / qtyEff) : 0.0
float stopDistPriceXREff = useXRiskStop ? (xRiskMult * (riskPerShareEff / pv)) : 1e10
float stopLong_eff       = avgEff - math.min(stopDistPriceBase, stopDistPriceXREff)
float stopShort_eff      = avgEff + math.min(stopDistPriceBase, stopDistPriceXREff)

// RR efetivo (usado no JSON dos alerts de saída)
float _tpR_eff = tp1R_calc(tp1R_base_eff)

bool _tp1L = useTP1 and okTP1Exec and okTPBEFinal and hasPosEffStrict and qtyEffOk and (sideEff>0) and not na(tp1L_eff) and high>=tp1L_eff and bar_index!=lastTp1AlertBarL
bool _tp1S = useTP1 and okTP1Exec and okTPBEFinal and hasPosEffStrict and qtyEffOk    and (sideEff<0) and not na(tp1S_eff) and low <=tp1S_eff and bar_index!=lastTp1AlertBarS
bool _tp2L = useTP2 and okTP1Exec and okTPBEFinal and hasPosEffStrict and qtyEffOk    and (sideEff>0) and not na(tp2L_eff) and high>=tp2L_eff and bar_index!=lastTp2AlertBarL
bool _tp2S = useTP2 and okTP1Exec and okTPBEFinal and hasPosEffStrict and qtyEffOk           and (sideEff<0) and not na(tp2S_eff) and low <=tp2S_eff and bar_index!=lastTp2AlertBarS
bool _slL  = okStopFinal and hasPosEffStrict and qtyEffOk and (sideEff>0)   and not na(stopLong_eff)  and low <=stopLong_eff  and bar_index!=lastStopAlertBarL
bool _slS  = okStopFinal and hasPosEffStrict and qtyEffOk and (sideEff<0)   and not na(stopShort_eff) and high>=stopShort_eff and bar_index!=lastStopAlertBarS

// STOP base vs XR (usa posQtyAbs)
float _posQ = math.abs(strategy.position_size)  // para os alertas
float _qTP1  = round_to_step(_posQ * (tp1PctAdj/100.0), lotStep)
float _qTP2  = round_to_step(_posQ * math.max(0.0, (100.0 - tp1PctAdj)/100.0), lotStep)
float _qRemTP1 = round_to_step(math.max(_posQ - _qTP1, 0), lotStep)
float _qRemTP2 = round_to_step(math.max(_posQ - _qTP1 - _qTP2, 0), lotStep)

float _posQ_eff   = qtyEff
float _qTP1_eff   = round_to_step(_posQ_eff * (tp1PctAdj/100.0), lotStep)
float _qTP2_eff   = round_to_step(_posQ_eff * math.max(0.0, (100.0 - tp1PctAdj)/100.0), lotStep)
float _qRemTP1_eff= round_to_step(math.max(_posQ_eff - _qTP1_eff, 0), lotStep)
float _qRemTP2_eff= round_to_step(math.max(_posQ_eff - _qTP1_eff - _qTP2_eff, 0), lotStep)

safeQty(float want, float pos, float step) =>
    // trava dentro de [0 .. pos] e respeita o passo
    float q = clampf(want, 0.0, pos)
    round_to_step(q, step)

// Recalcula as quantidades para o CONTEXTO EFETIVO dos alerts (usa _posQ_eff)
// Mantém os mesmos nomes já usados no restante do código
// ---- Quantidades EFETIVAS para os alerts (reuso de nomes) ----
float qTP1_qty = safeQty(_qTP1_eff, _posQ_eff, lotStep)
float qTP2_qty = safeQty(math.max(_posQ_eff - qTP1_qty, 0.0), _posQ_eff, lotStep)


// Se sobrar resto < passo, leva tudo para TP1 (ou fica só Stop)
if qTP2_qty < lotStep
    qTP2_qty := 0.0
    qTP1_qty := safeQty(_posQ_eff, _posQ_eff, lotStep)

// Espelhos que o JSON usa
g_tp1_qty := qTP1_qty
g_tp2_qty := qTP2_qty


// LONG
if allowOrders and useTP1 and qTP1_qty > 0 and okTP1Exec and okTPBEFinal and not na(tp1L) and strategy.position_size > 0
    strategy.exit(ID_LE_TP1, from_entry=ID_LE, limit=tp1L, qty=qTP1_qty)
if allowOrders and useTP2 and qTP2_qty > 0 and okTPBEFinal and not na(tp2L) and strategy.position_size > 0
    strategy.exit(ID_LE_TP2, from_entry=ID_LE, limit=tp2L, qty=qTP2_qty)

// SHORT
if allowOrders and useTP1 and qTP1_qty > 0 and okTP1Exec and okTPBEFinal and not na(tp1S) and strategy.position_size < 0
    strategy.exit(ID_SE_TP1, from_entry=ID_SE, limit=tp1S, qty=qTP1_qty)
if allowOrders and useTP2 and qTP2_qty > 0 and okTPBEFinal and not na(tp2S) and strategy.position_size < 0
    strategy.exit(ID_SE_TP2, from_entry=ID_SE, limit=tp2S, qty=qTP2_qty)

// (garantias p/ BE/runner) — mova para cima se necessário (não duplique!)
// ②.b BE/Trail — configs e estado COMPARTILHADOS (precisam vir antes do Runner)
bool  beOnlyAfterTP1 = input.bool(true,  "BE/Trail só após TP1", group=gpExit)
bool  allowSameBarBE = input.bool(true,  "Permitir BE/Trail na mesma barra do TP1", group=gpExit)
float beOffsetATRx   = input.float(0.0,  "Offset extra p/ BE (ATRx)", minval=0.0, step=0.05, group=gpExit)
float trailATRx      = input.float(0.6,  "Trail offset (ATRx)",      minval=0.1, step=0.1,  group=gpExit)

// Estado compartilhado por Runner e Alertas de BE/Trail 
var float be_lastTrailPx = na     // último preço de trail alertado
var int   lastBEAlertBar = -1     // trava 1x/barra dos alerts de BE/Trail
// allowSameBarBE já existe nos seus inputs do BE/Trail

// ===== PATCH: Runner após TP2 =====
// ===================== RUNNER PÓS-TP2 (stop promovido) =====================
// Requisito: manter lucro se preço passar de TP2. O stop sobe para TP2 (ou além,
// se o BE/trail atual já estiver melhor), e disparamos um "be_trail" imediato.
// Observação: NÃO afrouxa o stop. Sempre escolhe o mais apertado.
// ===================== RUNNER PÓS-TP2 (sem ternários) =====================
bool runnerEligible = hasPosEffStrict and qtyEffOk and okBEExec and okTPBEFinal and (sideEff != 0)

float tp2L_eff_local = tp2L_eff
float tp2S_eff_local = tp2S_eff

bool crossedTP2 = false
if sideEff > 0
    crossedTP2 := useTP2 and not na(tp2L_eff_local) and high >= tp2L_eff_local
else
    crossedTP2 := useTP2 and not na(tp2S_eff_local) and low  <= tp2S_eff_local

if runnerEligible and crossedTP2
    // 1) stop-base do runner = TP2 do lado atual
    float runnerStop = na
    if sideEff > 0
        runnerStop := tp2L_eff_local
    else
        runnerStop := tp2S_eff_local

    // 2) calcula BE/Trail atual (mesma lógica do bloco clássico)
    float bePxEffL_runner = avgEff + beOffsetATRx * atr14
    float bePxEffS_runner = avgEff - beOffsetATRx * atr14
    float trailNowL_runner = math.max(bePxEffL_runner, avgEff + trailATRx*atr14)
    float trailNowS_runner = math.min(bePxEffS_runner, avgEff - trailATRx*atr14)

    float trailNow_runner = na
    if sideEff > 0
        trailNow_runner := trailNowL_runner
    else
        trailNow_runner := trailNowS_runner

    // 3) Promove o stop sem afrouxar
    float promotedStop = na
    if na(runnerStop)
        promotedStop := trailNow_runner
    else
        if sideEff > 0
            promotedStop := math.max(runnerStop, trailNow_runner)
        else
            promotedStop := math.min(runnerStop, trailNow_runner)

    // 4) Exceção opcional ao cadeado 1x/barra
    bool canSendBE_runner = canSendNow
    if not canSendBE_runner and allowSameBarBE and (bar_index != lastBEAlertBar)
        canSendBE_runner := true

    if canSendBE_runner
        string _tipoR = ""
        if sideEff > 0
            _tipoR := "venda"
        else
            _tipoR := "compra"

        float _rrEffR = tp1R_calc(tp1R_base_eff)

        alert(f_json_4082(               "be_trail", tipoKey, "BE",              syminfo.ticker, syminfo.prefix, timeframe.period,              promotedStop, na, na, promotedStop,              qtyEff, qtyEff, qtyEff,             tp1PctAdj, 100.0 - tp1PctAdj,              _curCode, hora_br(), _rrEffR,             (opMode=="Backtest"?"backtest":"producao"),            VERSION        )  )

        // memorizações de controle
        be_lastTrailPx := promotedStop
        lastBEAlertBar := bar_index
        lastSendBar    := bar_index
        canSendNow     := false
// =================== FIM RUNNER PÓS-TP2 (sem ternários) =====================
// =================== FIM RUNNER PÓS-TP2 ===================


// TP1 LONG
if _tp1L and qTP1_qty >= lotStep and canSendNow
    alert(f_json_4082("saida_tp1",tipoKey,"TP1",syminfo.ticker,syminfo.prefix,timeframe.period,tp1L_eff,tp1L_eff,na,na,_qTP1_eff,_posQ_eff,_qRemTP1_eff,tp1PctAdj,100.0-tp1PctAdj,_curCode,hora_br(),_tpR_eff,(opMode=="Backtest"?"backtest":"producao"),VERSION))
    lastTp1AlertBarL := bar_index
    lastSendBar := bar_index
    canSendNow  := false
    if not allowOrders
        _entryQty := math.max(_entryQty - _qTP1_eff, 0)

// TP1 SHORT
if _tp1S and qTP1_qty >= lotStep and canSendNow
    alert(f_json_4082("saida_tp1",tipoKey,"TP1",syminfo.ticker,syminfo.prefix,timeframe.period,tp1S_eff,tp1S_eff,na,na,_qTP1_eff,_posQ_eff,_qRemTP1_eff,tp1PctAdj,100.0-tp1PctAdj,_curCode,hora_br(),_tpR_eff,(opMode=="Backtest"?"backtest":"producao"),VERSION))
    lastTp1AlertBarS := bar_index
    lastSendBar := bar_index
    canSendNow  := false
    if not allowOrders
        _entryQty := math.max(_entryQty - _qTP1_eff, 0)

// TP2 LONG 
if _tp2L and canSendNow and not extend_after_tp2 and not flatLocked
    alert(f_json_4082("saida_tp2",tipoKey,"TP2",syminfo.ticker,syminfo.prefix,timeframe.period,tp2L_eff,na,tp2L_eff,na,_qTP2_eff,_posQ_eff,_qRemTP2_eff,tp1PctAdj,100.0-tp1PctAdj,_curCode,hora_br(),_tpR_eff,(opMode=="Backtest"?"backtest":"producao"),VERSION))
    lastTp2AlertBarL := bar_index
    lastSendBar := bar_index
    canSendNow  := false
    _flatLockUntilBar := flatlock_enable ? bar_index + flatlock_bars : _flatLockUntilBar
    if not allowOrders
        _entryQty := 0
        _entryAvg := na
        _sentEntry := false
        _sentMaint := false
        _curCode := ""

// TP2 SHORT
if _tp2S and canSendNow and not extend_after_tp2 and not flatLocked
    alert(f_json_4082("saida_tp2",tipoKey,"TP2",syminfo.ticker,syminfo.prefix,timeframe.period,tp2S_eff,na,tp2S_eff,na,_qTP2_eff,_posQ_eff,_qRemTP2_eff,tp1PctAdj,100.0-tp1PctAdj,_curCode,hora_br(),_tpR_eff,(opMode=="Backtest"?"backtest":"producao"),VERSION))
    lastTp2AlertBarS := bar_index
    lastSendBar := bar_index
    canSendNow  := false
    _flatLockUntilBar := flatlock_enable ? bar_index + flatlock_bars : _flatLockUntilBar
    if not allowOrders
        _entryQty := 0
        _entryAvg := na
        _sentEntry := false
        _sentMaint := false
        _curCode := ""

if _slL and canSendNow and not flatLocked
    alert(f_json_4082("saida_stop",tipoKey,"STOP",syminfo.ticker,syminfo.prefix,timeframe.period,stopLong_eff,na,na,stopLong_eff,_posQ_eff,_posQ_eff,0.0,tp1PctAdj,100.0-tp1PctAdj,_curCode,hora_br(),_tpR_eff,(opMode=="Backtest"?"backtest":"producao"),VERSION))
    lastStopAlertBarL := bar_index
    lastSendBar := bar_index
    canSendNow  := false
    _flatLockUntilBar := flatlock_enable ? bar_index + flatlock_bars : _flatLockUntilBar
    if not allowOrders
        _entryQty := 0
        _entryAvg := na
        _sentEntry := false
        _sentMaint := false
        _curCode := ""

if _slS and canSendNow and not flatLocked
    alert(f_json_4082("saida_stop",tipoKey,"STOP",syminfo.ticker,syminfo.prefix,timeframe.period,stopShort_eff,na,na,stopShort_eff,_posQ_eff,_posQ_eff,0.0,tp1PctAdj,100.0-tp1PctAdj,_curCode,hora_br(),_tpR_eff,(opMode=="Backtest"?"backtest":"producao"),VERSION))
    lastStopAlertBarS := bar_index
    lastSendBar := bar_index
    canSendNow  := false
    _flatLockUntilBar := flatlock_enable ? bar_index + flatlock_bars : _flatLockUntilBar
    if not allowOrders
        _entryQty := 0
        _entryAvg := na
        _sentEntry := false
        _sentMaint := false
        _curCode := ""

// --- Gate reforçado de manutenção, só após entrada do "dia atual" ---
int  dayStartMs     = int(time("D"))  // começo do dia corrente (já usado no script)
bool sameBarOfEntry = not na(posEntryBar) and (bar_index == posEntryBar)
bool entryIsToday   = _sentEntry and not na(_entryMs) and (_entryMs >= dayStartMs)

if entryIsToday and hasPosEffStrict and not _sentMaint and (clockMs() - _entryMs) >= maintainDelayMs and not sameBarOfEntry
    alert(f_json_4082("manutencao",tipoKey,(_entrySide=="LONG"?(pickMethL!=""?pickMethL:"core"):(pickMethS!=""?pickMethS:"core")),syminfo.ticker,syminfo.prefix,timeframe.period,avgEff,(sideEff>0?tp1L_eff:tp1S_eff),(sideEff>0?tp2L_eff:tp2S_eff),(sideEff>0?stopLong_eff:stopShort_eff),qtyEff,qtyEff,qtyEff,tp1PctAdj,100.0-tp1PctAdj,_curCode,hora_br(),_tpR_eff,(opMode=="Backtest"?"backtest":"producao"),VERSION))
    _sentMaint := true
    canSendNow  := false

var int  lastTp1Bar = na
bool tp1HitL = strategy.position_size > 0 and not na(tp1L) and high >= tp1L
bool tp1HitS = strategy.position_size < 0 and not na(tp1S) and low  <= tp1S
if (tp1HitL or tp1HitS)
    lastTp1Bar := bar_index
bool beSeqOK_time = not beOnlyAfterTP1 or (allowSameBarBE ? (tp1HitL or tp1HitS) : (bar_index > nz(lastTp1Bar)))
bool beSeqOK_hold = posAge >= minHoldBars or (tp1HitL or tp1HitS)
bool beSeqOK = beSeqOK_time and beSeqOK_hold

if allowOrders and okBEExec and beSeqOK and strategy.position_size > 0
    float bePxL    = avg + beOffsetATRx * atr14
    float trailPxL = math.max(bePxL, avg + trailATRx*atr14)
    strategy.exit(ID_LE_SL, from_entry=ID_LE, stop=trailPxL)
if allowOrders and okBEExec and beSeqOK and strategy.position_size < 0
    float bePxS    = avg - beOffsetATRx * atr14
    float trailPxS = math.min(bePxS, avg - trailATRx*atr14)
    strategy.exit(ID_SE_SL, from_entry=ID_SE, stop=trailPxS)

// ----- Inputs usados pelos ALERTAS de BE/Trail (precisam vir antes do uso) -----
string beAlert_stepMode = input.string("Ticks", 
     "BE/Trail: critério do 'aperto'", 
     options=["Ticks","PctEntryNow"], group=gpExit)

int   beAlert_minTicks  = input.int(2, 
     "Aperto mín. p/ novo alerta (em ticks)", minval=1, group=gpExit)

float beAlert_minPct    = input.float(1.0, 
     "Aperto mín. p/ novo alerta (% de |Entrada−Preço atual|)", 
     minval=0.1, step=0.1, group=gpExit)

bool  beAlert_oncePerBar = input.bool(true, 
     "BE/Trail: no máx. 1 alerta por barra", group=gpExit)

// Estado por lado para resetar trilha
var int be_lastSide = 0

// ============================================================================
// ②.e ALERTAS de BE/Trail (robusto; toggle entre Ticks e % Entrada→Preço Atual)
// Colar após calcular avgEff/sideEff/okBEExec/okTPBEFinal/hasPosEffStrict/qtyEffOk
// ============================================================================
// Reset quando zera ou troca de lado
if (sideEff == 0) or (sideEff != be_lastSide)
    be_lastTrailPx := na
    be_lastSide    := sideEff
    // (opcional) liberar trava se quiser múltiplos na mesma barra após flip:
    // lastBEAlertBar := -1

// Elegibilidade do alerta (espelha as travas do bloco de ordens)
bool beElig = hasPosEffStrict and qtyEffOk and okBEExec and okTPBEFinal and beSeqOK and (sideEff != 0)

// Preço candidato do BE/Trail (mesma lógica do strategy.exit)
float bePxEffL = avgEff + beOffsetATRx * atr14
float bePxEffS = avgEff - beOffsetATRx * atr14

float trailNow_eff = na
if sideEff > 0
    trailNow_eff := math.max(bePxEffL, avgEff + trailATRx*atr14)
else if sideEff < 0
    trailNow_eff := math.min(bePxEffS, avgEff - trailATRx*atr14)

// Limiar de “aperto” para novo alerta
float _deltaTicks = beAlert_minTicks * syminfo.mintick
float _deltaPct   = (beAlert_minPct/100.0) * math.abs(avgEff - close)
float _delta      = beAlert_stepMode == "Ticks" ? _deltaTicks : _deltaPct
_delta := math.max(_delta, syminfo.mintick)  // evita ruído

// Ficou mais apertado que o último alertado?
bool tighter = false
if not na(trailNow_eff)
    if sideEff > 0
        tighter := na(be_lastTrailPx) or (trailNow_eff >= be_lastTrailPx + _delta)
    else if sideEff < 0
        tighter := na(be_lastTrailPx) or (trailNow_eff <= be_lastTrailPx - _delta)

// Respeita 1×/barra (local e global), com exceção opcional na mesma barra do TP1
bool canSendBE = beElig and tighter
canSendBE := canSendBE and (not beAlert_oncePerBar or bar_index != lastBEAlertBar)
canSendBE := canSendBE and (canSendNow or (allowSameBarBE and bar_index != lastBEAlertBar))

if canSendBE
    alert(f_json_4082("be_trail",
         tipoKey, "BE",
         syminfo.ticker, syminfo.prefix, timeframe.period,
         trailNow_eff, na, na, trailNow_eff,
         qtyEff, qtyEff, qtyEff,
         tp1PctAdj, 100.0 - tp1PctAdj,
         _curCode, hora_br(), _tpR_eff,
         (opMode=="Backtest"?"backtest":"producao"), VERSION))

    be_lastTrailPx := trailNow_eff
    lastBEAlertBar := bar_index
    lastSendBar    := bar_index
    canSendNow     := false

// Reset quando zera ou troca de lado
if (sideEff == 0) or (sideEff != be_lastSide)
    be_lastTrailPx := na
    be_lastSide    := sideEff

// -------------------- Elegibilidade (mesma lógica de BE/Trail) ---------------
bool beAlert_OK = okBEExec and beSeqOK and hasPosEffStrict and qtyEffOk
bool canAlertThisBar = sameBarEntries ? true : (bar_index != lastAlertAnyBar)
// Preços BE/Trail "efetivos" (iguais ao que você usa na execução)
float trailNowL   = math.max(bePxEffL, avgEff + trailATRx*atr14)
float trailNowS   = math.min(bePxEffS, avgEff - trailATRx*atr14)

// Escolhe o stop trail do lado em posição
float trailNow    = sideEff>0 ? trailNowL : sideEff<0 ? trailNowS : na

// ------------- Regras de “aperto” (melhora) + tamanho do passo ---------------
float deltaTrail  = na(be_lastTrailPx) ? na : math.abs(trailNow - be_lastTrailPx)

// Passo mínimo: por Ticks OU por % da perna |Entrada − Preço atual|
float stepMin     = na
if beAlert_stepMode == "Ticks"
    stepMin := beAlert_minTicks * syminfo.mintick
else
    // base: distância absoluta entre o preço atual e a entrada (avgEff)
    float baseRange = math.abs(close - avgEff)
    stepMin := (baseRange > 0) ? (beAlert_minPct/100.0) * baseRange : na

// "Apertou" a favor do lucro?
bool improved =
     (sideEff > 0 and not na(trailNow) and (na(be_lastTrailPx) or trailNow >  be_lastTrailPx)) or
     (sideEff < 0 and not na(trailNow) and (na(be_lastTrailPx) or trailNow <  be_lastTrailPx))

// Passo suficiente?
bool stepEnough = na(stepMin) or na(deltaTrail) ? true : (deltaTrail >= stepMin)

// --------------- Gatilho final (respeita 1x/barra e “cadeado” global) --------
// --------------- Gatilho final (respeita exceção controlada) -----------------
bool fireBE = beAlert_OK and (sideEff != 0) and not na(trailNow)

// (1) primeira vez ou melhora com passo suficiente
fireBE := fireBE and (na(be_lastTrailPx) or (improved and stepEnough))

// (2) exceção 1×/barra: se allowSameBarBE==true, liberar BE mesmo que já tenha enviado algo nesta barra
bool canSendBE_now = canSendNow or (allowSameBarBE and (lastSendBar == bar_index))

// (3) travas finais (e flat-lock)
fireBE := fireBE and (not beAlert_oncePerBar or (bar_index != lastBEAlertBar)) and (not flatLocked) and canSendBE_now

if fireBE
    string _tipo  = sideEff > 0 ? "venda" : "compra"
    float  _qEff  = qtyEff
    float  _rrEff = tp1R_calc(tp1R_base_eff)
    // (A) renomeado: de "saida_be" para "be_trail"
    alert(f_json_4082("be_trail", _tipo, "BE", syminfo.ticker, syminfo.prefix, timeframe.period,               trailNow, na, na, trailNow, _qEff, _qEff, _qEff,         tp1PctAdj, 100.0 - tp1PctAdj, _curCode, hora_br(), _rrEff,             (opMode=="Backtest"?"backtest":"producao"), VERSION))
    be_lastTrailPx := trailNow
    lastBEAlertBar := bar_index
    lastSendBar    := bar_index
    canSendNow     := false   // mantém seu cadeado global


if allowOrders and useDayFlat and timeToFlat and strategy.position_size != 0
    // 1) Cancelar saídas pendentes (TP/SL) desta posição
    strategy.cancel(ID_LE_TP1)
    strategy.cancel(ID_LE_TP2)
    strategy.cancel(ID_SE_TP1)
    strategy.cancel(ID_SE_TP2)
    strategy.cancel(ID_LE_SL)
    strategy.cancel(ID_SE_SL)
    // 2) Fechar tudo a mercado
    strategy.close_all("Flat end of session")


bool flatEff = allowOrders ? (strategy.position_size == 0) : (not hasPosEff)
// ficou flat agora (e havia uma posição/alerta ativo)?
bool justWentFlat =
     flatEff and (
         allowOrders ? (strategy.position_size[1] != 0)
                     : (_sentEntry or not na(_entryMs))
     )

// emite 1x uma manutenção confirmando que zerou (qtd=0)
if justWentFlat and not _sentCloseMaint and _curCode != ""
    alert(f_json_4082("manutencao", "zerado","core", syminfo.ticker, syminfo.prefix, timeframe.period,close, na, na, na,0.0, 0.0, 0.0, tp1PctAdj, 100.0 - tp1PctAdj,_curCode, hora_br(), _tpR_eff, (opMode=="Backtest"?"backtest":"producao"),VERSION))
    _sentCloseMaint := true

if flatEff
    _sentEntry := false
    _sentMaint := false
    _entryMs := na
    _entryQty := na
    _entrySide := ""
    _curCode := ""     // mantém seu reset de código aqui



string _metodo = strategy.position_size > 0 ? (pickMethL != "" ? pickMethL : "core") : strategy.position_size < 0 ? (pickMethS != "" ? pickMethS : "core") : (pickMethL != "" ? pickMethL : pickMethS)
string _metodoSafe = (_metodo == "" ? "core" : _metodo)
string _ativo = syminfo.ticker
string _exch = syminfo.prefix
string _tf = timeframe.period
string _ver = VERSION
string _codigo = _entrySide + "_" + str.tostring(bar_index)

float _avg = strategy.position_size == 0 ? close : strategy.position_avg_price
float _tp1 = strategy.position_size > 0 ? tp1L : strategy.position_size < 0 ? tp1S : na
float _tp2 = strategy.position_size > 0 ? tp2L : strategy.position_size < 0 ? tp2S : na
float _sl = strategy.position_size > 0 ? stopLong : strategy.position_size < 0 ? stopShort : na
float _rr = tp1R_calc(tp1R_base_eff)

// [NOVO] Empate também para o modo Indicador (quando allowOrders==false)
bool allowCoreL_once = allowCoreL
bool allowCoreS_once = allowCoreS

if allowCoreL_once and allowCoreS_once
    float scL_core = hasMethL ? pickScL : na
    float scS_core = hasMethS ? pickScS : na
    bool chooseL_core = na(scS_core) or (not na(scL_core) and scL_core >= scS_core)
    if chooseL_core
        allowCoreS_once := false
    else
        allowCoreL_once := false

// ===== ALERTA DE ENTRADA POR SINAL (não depende de fill) =====
// depois — usa *_once e respeita o desempate
// ===== ALERTA DE ENTRADA POR SINAL (não depende de fill) =====
// Núcleo para alertas: usa o mesmo core com not overDayTrades, not overRolling, etc. 
bool coreOK_alert = coreMaskCore
// candidatos por lado (idênticos ao seu critério anterior + cadeado global)
bool fireL = (not hasPosEff) and allowCoreL_once and coreOK_alert         and (bar_index != lastAlertBarL) and canSendNow and canAlertThisBar       and (qL_send > 0)       and ((not mg_use) or gainOK_L) and ((not rr_use) or rrOK)        and ((not useScoreCut) or passScoreL) and not flatLocked

bool fireS = (not hasPosEff) and allowCoreS_once and coreOK_alert      and (bar_index != lastAlertBarS) and canSendNow and canAlertThisBar        and (qS_send > 0)        and ((not mg_use) or gainOK_S) and ((not rr_use) or rrOK)        and ((not useScoreCut) or passScoreS) and not flatLocked

// desempate: se ambos verdadeiros, escolhe o maior score e zera o outro
if fireL and fireS
    bool chooseL_alert = na(pickScS) or (not na(pickScL) and pickScL >= pickScS)
    if chooseL_alert
        fireS := false
    else
        fireL := false

// Usa os mesmos campos já calculados acima (_metodoSafe/_ativo/_exch/_tf/_ver)
if fireL
    g_tp1_px  := tp1L
    g_tp2_px  := tp2L
    g_tp1_qty := round_to_step(qL_send * (tp1PctAdj/100.0), lotStep)
    g_tp2_qty := useTP2 ? round_to_step(math.max(qL_send - g_tp1_qty, 0.0), lotStep) : na
    _seqToday += 1
    _curCode := build_code()
    if _curCode == _lastCodeSentToday
        _seqToday += 1
        _curCode  := build_code()
    alert(f_json_4082("entrada_compra","compra",(pickMethL!=""?pickMethL:"core"),syminfo.ticker,syminfo.prefix,timeframe.period,(strategy.position_size==0?close:strategy.position_avg_price),tp1L,tp2L,stopLong,qL_send,0,qL_send,tp1PctAdj,100.0-tp1PctAdj,_curCode,hora_br(),_tpR_eff,(opMode=="Backtest"?"backtest":"producao"),VERSION))
    lastAlertBarL := bar_index
    lastAlertAnyBar := bar_index
    lastEntryBar := bar_index
    lastSendBar  := bar_index   // trava a barra para o toggle 1-por-barra
    _sentEntry := true
    _entryMs := clockMs()
    _entryQty := qL_send
    _entrySide := "LONG"
    _sentCloseMaint := false
    _lastCodeSentToday := _curCode
    canSendNow   := false
    if not allowOrders
        _entryAvg := close
        posEntryBar := bar_index
        array.push(entryTimes, int(time))
        tradesToday += 1

// Antes do alert de entrada_venda

if fireS
    g_tp1_px  := tp1S
    g_tp2_px  := tp2S
    g_tp1_qty := round_to_step(qS_send * (tp1PctAdj/100.0), lotStep)
    g_tp2_qty := useTP2 ? round_to_step(math.max(qS_send - g_tp1_qty, 0.0), lotStep) : na
    _seqToday += 1
    _curCode := build_code()
    if _curCode == _lastCodeSentToday
        _seqToday += 1
        _curCode  := build_code()
    alert(f_json_4082("entrada_venda","venda",(pickMethS!=""?pickMethS:"core"),syminfo.ticker,syminfo.prefix,timeframe.period,(strategy.position_size==0?close:strategy.position_avg_price),tp1S,tp2S,stopShort,qS_send,0,qS_send,tp1PctAdj,100.0-tp1PctAdj,_curCode,hora_br(),_tpR_eff,(opMode=="Backtest"?"backtest":"producao"),VERSION))
    lastAlertBarS := bar_index
    lastAlertAnyBar := bar_index
    lastEntryBar := bar_index
    lastSendBar  := bar_index   // trava a barra para o toggle 1-por-barra
    _sentEntry := true
    _entryMs := clockMs()
    _entryQty := qS_send
    _entrySide := "SHORT"
    _sentCloseMaint := false
    _lastCodeSentToday := _curCode
    canSendNow   := false
    if not allowOrders
        _entryAvg := close
        posEntryBar := bar_index
        array.push(entryTimes, int(time))
        tradesToday += 1

if _openedNow
    _entryQty := math.abs(strategy.position_size)
    _entrySide := strategy.position_size > 0 ? "LONG" : "SHORT"

if ta.change(time("D")) != 0
    _sentEntry := false
    _sentMaint := false
    _entryMs   := na
    _entryQty  := na
    _entryAvg  := na
    _entrySide := ""
    _curCode   := ""
    _sentCloseMaint := false

// -----------------------------------------------------------------------------
// ⑬ Visual / HUD e Diagnóstico
// -----------------------------------------------------------------------------
plot(ema200, title="EMA200", color=color.new(color.gray, 0), linewidth=2)
plot(ema20,  title="EMA20",  color=color.new(color.blue, 0), linewidth=1)
plot(vwap,   title="VWAP",   color=color.new(color.orange,0), linewidth=1)
plotchar(sigInsideL, title="Inside L", char="^", location=location.belowbar, color=color.new(color.teal,0),   size=size.tiny)
plotchar(sigInsideS, title="Inside S", char="v", location=location.abovebar, color=color.new(color.red,0),    size=size.tiny)
plotchar(sigDonL,    title="Don L",    char="^", location=location.belowbar, color=color.new(color.green,0),  size=size.tiny)
plotchar(sigDonS,    title="Don S",    char="v", location=location.abovebar, color=color.new(color.maroon,0), size=size.tiny)
plotchar(sigContL,   title="Cont L",   char="^", location=location.belowbar, color=color.new(color.aqua,0),   size=size.tiny)
plotchar(sigContS,   title="Cont S",   char="v", location=location.abovebar, color=color.new(color.purple,0), size=size.tiny)
plotchar(sigORL,     title="OR L",     char="^", location=location.belowbar, color=color.new(color.navy,0),   size=size.tiny)
plotchar(sigORS,     title="OR S",     char="v", location=location.abovebar, color=color.new(color.fuchsia,0),size=size.tiny)

// Diagnóstico: por que não entrou?
plotshape((pickMethL != "" and coreMask and not (qtyL > 0)) or (pickMethS != "" and coreMask and not (qtyS > 0)),
     title="Sem Qtd", style=shape.xcross, location=location.bottom, color=color.red, size=size.tiny, text="qty=0")
plotshape(((pickMethL != "") or (pickMethS != "")) and coreMask and (not passScoreL and not passScoreS),
     title="Score bloqueou", style=shape.triangledown, location=location.bottom, color=color.orange, size=size.tiny, text="score")
plotshape(((pickMethL != "") or (pickMethS != "")) and not coreMask,
     title="Core bloqueou", style=shape.triangledown, location=location.bottom, color=color.gray, size=size.tiny, text="core")
plotshape(((pickMethL != "" and qtyL > 0 and not gainOK_L) or (pickMethS != "" and qtyS > 0 and not gainOK_S)),
     title="Ganho mínimo bloqueou", style=shape.triangledown, location=location.bottom, color=color.new(color.blue,0), size=size.tiny, text="minGain")
