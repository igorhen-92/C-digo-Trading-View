float dROC20 = perf_skipCross ? na : _d_roc20
bool dayAlignL = useDailyAlign and not perf_skipCross and (dClose > dEMA200) and (dROC20 > 0)
bool dayAlignS = useDailyAlign and not perf_skipCross and (dClose < dEMA200) and (dROC20 < 0)

// === OR: alinhamento com GAP do dia (pré-abertura vs fechamento anterior) ===
bool or_alignGap = input.bool(true, "Alinhar com GAP do dia", tooltip = "Se ON, só permite trades na direção do GAP (com tolerância).")
float or_gapMinPct = input.float(0.20, "GAP mínimo %", step = 0.05, tooltip = "Mínimo absoluto do GAP para considerar alinhamento. Ex.: 0.20 = 0,20%")

float _d_prevClose = request.security(syminfo.tickerid, "D", close[1])
float _d_open = request.security(syminfo.tickerid, "D", open)
float _gapPct = na(_d_prevClose) ? 0.0 : 100.0 * (_d_open - _d_prevClose) / _d_prevClose

bool preGapAlignL = not or_alignGap or (_gapPct >= or_gapMinPct)
bool preGapAlignS = not or_alignGap or (_gapPct <= -or_gapMinPct)

// === PATCH A: YZ-Vol Regime (cole no grupo ⑤ Gates & Filtros, após seus inputs) ===
string gpYZ = "④.b Gate Volatilidade (Yang–Zhang)"
bool  useYZ        = input.bool(false, "Usar Gate YZ-Vol", group=gpYZ)
string yzMode      = input.string("Off", "Modo YZ", options=["Off","Block","Weight"], group=gpYZ)
float yzMinPct     = input.float(0.20, "YZ% mín (por barra)", step=0.01, group=gpYZ)
float yzMaxPct     = input.float(8.00, "YZ% máx (por barra)", step=0.01, group=gpYZ)
float yzWeightGain = input.float(20.0, "Weight: bônus qty em regime bom (%)", minval=0, step=1, group=gpYZ)

// Cálculo YZ (aprox. intraday, robusto a gaps)
float rr  = math.log(close/open)
float co  = math.log(open/close[1])
float u2  = math.pow(math.log(high/close), 2)
float d2  = math.pow(math.log(low/close),  2)
// sigma^2_YZ ≈ 0.34*co² + 0.66*(rr - co)² + 0.5*(u2+d2)
float sigmaYZ2 = 0.34*co*co + 0.66*math.pow(rr - co, 2) + 0.5*(u2 + d2)
float yzPctNow = math.sqrt(math.max(sigmaYZ2, 0.0)) * 100.0

bool  gYZ = (yzPctNow >= yzMinPct and yzPctNow <= yzMaxPct)

// --- Smart-Filter DON --- (após sigDonL/sigDonS)
string gpDonSF = "③.b.1 Donchian Smart-Filter"
