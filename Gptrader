float  vp_sdMult = input.float(1.0, "VA-lite: desvio p/ banda", step=0.1, group=gpFP)
float  vp_wVWAPFavor = input.float(0.5, "VP peso: favor VWAP", step=0.1, group=gpFP)
float  vp_wRVOL      = input.float(0.3, "VP peso: regime RVOL", step=0.1, group=gpFP)
float  vp_wATRpct    = input.float(0.2, "VP peso: regime ATR%", step=0.1, group=gpFP)

// VWAP 2.0
bool  v2_use   = input.bool(true, "VWAP 2.0: usar (trend/dist)", group=gpFP)
string v2_mode = input.string("Weight", "VWAP 2.0: modo", options=["Weight","Block"], group=gpFP)
float  v2_slopeMin = input.float(0.03, "VWAP2: slope mín %/bar", step=0.01, group=gpFP)
