methodScore(string name) =>
    float s = wBase
    if      name == "Inside"
        s += wInside
    else if name == "Engulf"
        s += wEngulf
    else if name == "Don"
        s += wDon
    else if name == "Cont"
        s += wCont
    else if name == "VWAP"
        s += wVWAPm
    else if name == "OR"
        s += wOR
    else if name == "RSIDiv"
        s += wRSIDiv
    else if name == "RangeRet"
        s += wRangeRet
    else if name == "BOPB"
        s += wBOPB
    else if name == "LW96"
        s += wLW96
    else if name == "ORFade"
        s += wORFade
    else if name == "TwoBar"
        s += w2Bar
    else if name == "BOSCont"
        s += wBOSCont
    else if name == "ADX"
        s += wADX
    else if name == "RSIFS"
        s += wRSIFS
    else if name == "Conflu"
        s += wConflu
    else if name == "ATRexp"
        s += wATRexp

    s

float gateMultL = 1.0 + gateBonusScale*(bonusLnorm - 0.5)*0.2
float gateMultS = 1.0 + gateBonusScale*(bonusSnorm - 0.5)*0.2

