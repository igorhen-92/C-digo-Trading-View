var float az_lastForce       = 0.0          // força do lado na última troca

// ---- Métricas de força e inclinação ----
int   _diLen   = math.max(1, az_di_len)
float _upMove  = high - high[1]
float _dnMove  = low[1]  - low
float _pDM     = (_upMove > _dnMove and _upMove > 0) ? _upMove : 0.0
float _mDM     = (_dnMove > _upMove and _dnMove > 0) ? _dnMove : 0.0
float _atrW    = ta.atr(_diLen)
float _pDMrma = ta.rma(_pDM, _diLen)
float _mDMrma = ta.rma(_mDM, _diLen)
float az_diP  = _atrW == 0.0 ? 0.0 : 100.0 * _pDMrma / _atrW
float az_diM  = _atrW == 0.0 ? 0.0 : 100.0 * _mDMrma / _atrW
float az_forceDir = (az_diP + az_diM == 0) ? 0.0 : math.abs(az_diP - az_diM) / (az_diP + az_diM)
float az_emaF     = ta.ema(close, az_slope_fast)
