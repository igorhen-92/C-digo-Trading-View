float _sd_in     = ta.stdev(close, in_conLen)
bool  in_consol  = _sd_in <= in_stdevATRx*atr14
bool  in_adxOK   = adxV >= in_adxMin
bool  in_chopOK  = chop <= chopMax
bool  in_slopeL  = srcSlope >= slopeMin
bool  in_slopeS  = srcSlope <= -slopeMin

int nIN=4, passINL=0, passINS=0
passINL += in_consol ? 1 : 0
passINS += in_consol ? 1 : 0
passINL += in_adxOK  ? 1 : 0
passINS += in_adxOK  ? 1 : 0
passINL += in_slopeL ? 1 : 0
passINS += in_slopeS ? 1 : 0
passINL += in_chopOK ? 1 : 0
passINS += in_chopOK ? 1 : 0

bool in_passL = passINL >= math.ceil(in_minFrac*nIN)
bool in_passS = passINS >= math.ceil(in_minFrac*nIN)

sigInsideL := sigInsideL and (not inSF_use or in_passL)
sigInsideS := sigInsideS and (not inSF_use or in_passS)

// --- Smart-Filter TwoBar ---
string gp2BSF = "③.b.4 TwoBar Smart-Filter"
bool  t2SF_use   = input.bool(true, "TwoBar: aplicar filtros", group=gp2BSF)
float t2_adxMin  = input.float(14, "Min ADX", step=0.5, group=gp2BSF)
float t2_rsiLMax = input.float(45, "RSI L ≤", step=1, group=gp2BSF)
