float  boostPctLwDon   = input.float(10.0, "Boost % extra p/ LW9.6/Don", minval=0, step=1, group=gpSizer)
// (opcional) limiar de score p/ "muito forte"
float scoreStrongThresh = input.float(1.6, "Limiar de score p/ 'muito forte'", step=0.1, group=gpSizer)
bool veryStrongL = strongL or isStrongMethodL or (pickScL >= scoreStrongThresh)
bool veryStrongS = strongS or isStrongMethodS or (pickScS >= scoreStrongThresh)

// Confirmação adicional: exige fechamento favorável, exceto se método muito forte
bool needConfirmL = (pickMethL != "") and not veryStrongL
bool needConfirmS = (pickMethS != "") and not veryStrongS
bool confirmOK_L  = not needConfirmL or (close > open)   // candle fechou “a favor”
bool confirmOK_S  = not needConfirmS or (close < open)

// Base qty por risco (cash) com proteção
float pvSafe = math.max(pv, 1.0)
float stopDistCashBaseSafe = math.max(stopDistCashBase, syminfo.mintick*pvSafe)
float rawBaseQty = stopDistCashBaseSafe > 0 ? (riskBRL / stopDistCashBaseSafe) : 0.0
// Cap por ordem
rawBaseQty := math.min(rawBaseQty, maxQtyPerOrder)
// Round por passo
float baseQty = round_to_step(rawBaseQty, lotStep)

baseQty := round_to_step(baseQty * atr_mult, lotStep)

// Se base=0, tentar 1 passo se o risco tolerar
if allowForceMinLot and baseQty == 0
    float cashRiskOneStep = stopDistCashBaseSafe * lotStep
    float maxRiskAllow    = riskBRL * (1.0 + maxOverRiskPct/100.0)
    if cashRiskOneStep <= maxRiskAllow
        baseQty := lotStep

// Midday throttle / block (aplicar sobre a base, antes do RW/multiplicadores)
if inMidday and midMode=="Throttle"
    float midEff = clampf(midThrottle * midAdj, 0.0, 1.0)
    baseQty := round_to_step(baseQty * midEff, lotStep)
if inMidday and midMode=="Block"
    baseQty := 0.0

// ===========================================================================
// ⑨ Sizer 2.0 (confirmações → multiplicador robusto) + caps inteligentes
// ===========================================================================
string gpSizer2 = "⑥ Sizer & Guard-Rail (v60+)"
float multWeak      = input.float(0.80, "Multiplicador quando fraco", step=0.05, group=gpSizer2)
float multNeutral   = input.float(1.00, "Multiplicador neutro",      step=0.05, group=gpSizer2)
float multStrong    = input.float(1.80, "Multiplicador quando forte",step=0.05, group=gpSizer2)
float wGates = input.float(0.30, "Peso: Gates OK", step=0.05, group=gpSizer2)
float wVWAP2 = input.float(0.20, "Peso: VWAP2 OK", step=0.05, group=gpSizer2)
float wFP    = input.float(0.20, "Peso: Footprint pró", step=0.05, group=gpSizer2)
float wSec   = input.float(0.10, "Peso: Setor pró", step=0.05, group=gpSizer2)
float wMkt   = input.float(0.10, "Peso: Mercado pró", step=0.05, group=gpSizer2)
float wGap   = input.float(0.10, "Peso: Gap pró", step=0.05, group=gpSizer2)
float wMethodStrong = input.float(0.10, "Bônus: Método forte", step=0.05, group=gpSizer2)
float wFactorMom    = input.float(0.15, "Bônus: Factor-Momentum (EMA)", step=0.05, group=gpSizer2)

float qtyL = baseQty
float qtyS = baseQty

// RiskWeighted pelos gates
if rw_use
    float fL = rw_min + (rw_max - rw_min) * bonusLnorm
    float fS = rw_min + (rw_max - rw_min) * bonusSnorm
    qtyL := round_to_step(qtyL * fL, lotStep)
    qtyS := round_to_step(qtyS * fS, lotStep)

// --- Score de confirmações → multiplicador suave 0.8..1.8 --
float scoreL_conf = 0.0
float scoreS_conf = 0.0
float wSum = wGates + wVWAP2 + wFP + wSec + wMkt + wGap

scoreL_conf += (passL_gates ? wGates : 0)
scoreS_conf += (passS_gates ? wGates : 0)
scoreL_conf += (v2_okL ? wVWAP2 : 0)
scoreS_conf += (v2_okS ? wVWAP2 : 0)
scoreL_conf += ((fp_zDelta > 0 and fp_closePos > 0.5) ? wFP : 0)
scoreS_conf += ((fp_zDelta < 0 and fp_closePos < 0.5) ? wFP : 0)
scoreL_conf += (secAlignL ? wSec : 0)
scoreS_conf += (secAlignS ? wSec : 0)
scoreL_conf += (mktAlignL ? wMkt : 0)
scoreS_conf += (mktAlignS ? wMkt : 0)
scoreL_conf += (preGapAlignL ? wGap : 0)
scoreS_conf += (preGapAlignS ? wGap : 0)

// normaliza 0..1
scoreL_conf := wSum > 0 ? clampf(scoreL_conf / wSum, 0.0, 1.0) : 0.5
scoreS_conf := wSum > 0 ? clampf(scoreS_conf / wSum, 0.0, 1.0) : 0.5

float wDaily = input.float(0.10, "Peso: Diário pró", step=0.05, group=gpSizer2)

// ... logo após scoreL_conf += (preGapAlignL ? wGap : 0)
scoreL_conf += (dayAlignL ? wDaily : 0)
scoreS_conf += (dayAlignS ? wDaily : 0)

// mapeia para [multWeak .. multStrong] com leve viés pela “força do método” e factor-momentum
float methodKickL = isStrongMethodL ? wMethodStrong : 0.0
float methodKickS = isStrongMethodS ? wMethodStrong : 0.0
float momKickL    = wFactorMom * clampf(confEMA_L, 0.0, 1.0)
float momKickS    = wFactorMom * clampf(confEMA_S, 0.0, 1.0)

float scoreL_final = clampf(scoreL_conf + methodKickL + momKickL, 0.0, 1.0)
float scoreS_final = clampf(scoreS_conf + methodKickS + momKickS, 0.0, 1.0)

float multL = multWeak + (multStrong - multWeak) * scoreL_final
float multS = multWeak + (multStrong - multWeak) * scoreS_final

qtyL := round_to_step(qtyL * multL, lotStep)
qtyS := round_to_step(qtyS * multS, lotStep)

// --- Multiplicadores de contexto existentes (FP/VP/VWAP2 Weight) ---
qtyL := round_to_step(qtyL * (fp_multL * vp_multL * v2_multL), lotStep)
qtyS := round_to_step(qtyS * (fp_multS * vp_multS * v2_multS), lotStep)

// Aplica o efeito Weight do AVWAP Multiâncora no lugar correto (depois do Sizer)
qtyL := round_to_step(qtyL * avma_mult, lotStep)
qtyS := round_to_step(qtyS * avma_mult, lotStep)

// === Boosts dos novos gates quando em modo "Weight" ===
if useYZ and yzMode=="Weight" and gYZ
    qtyL := round_to_step(qtyL * (1.0 + yzWeightGain/100.0), lotStep)
    qtyS := round_to_step(qtyS * (1.0 + yzWeightGain/100.0), lotStep)

if useCUSUM and cusumMode=="Weight" and gCUSUM
    qtyL := round_to_step(qtyL * (1.0 + cusumBoost/100.0), lotStep)
    qtyS := round_to_step(qtyS * (1.0 + cusumBoost/100.0), lotStep)


if tiltActive and tilt_modo == "Reduzir size"
    qtyL := round_to_step(qtyL * tilt_sizeMult, lotStep)
    qtyS := round_to_step(qtyS * tilt_sizeMult, lotStep)

// --- Preferência de boost por método ---
bool methIsLwDonL = (pickMethL=="LW96" or pickMethL=="Don")
bool methIsLwDonS = (pickMethS=="LW96" or pickMethS=="Don")

float boostL = boostPctAll + (methIsLwDonL ? boostPctLwDon : 0.0)
float boostS = boostPctAll + (methIsLwDonS ? boostPctLwDon : 0.0)

// --- Guard-rails mínimo ---
if qtyL < minQtyPerTrade
    if minQtyPolicy == "Block"
        qtyL := 0
    else
        qtyL := ceil_to_step(minQtyPerTrade, lotStep)

if qtyS < minQtyPerTrade
    if minQtyPolicy == "Block"
        qtyS := 0
    else
        qtyS := ceil_to_step(minQtyPerTrade, lotStep)

// --- Guard-rails máximo (com opção de boost) ---
float maxAllow = maxQtyPerOrder * (1.0 + maxBoostPct/100.0)
// 1) primeiro, se configurado, aplicar boost
if maxQtyPolicy == "BoostIfMethod"
    qtyL := boost_qty(qtyL, boostL, lotStep)
    qtyS := boost_qty(qtyS, boostS, lotStep)

// 2) depois, tratar violação do máximo
if qtyL > maxQtyPerOrder
    if maxQtyPolicy == "Block"
        qtyL := 0
    else // "Cap" ou "BoostIfMethod"
        qtyL := round_to_step(math.min(qtyL, maxAllow), lotStep)

if qtyS > maxQtyPerOrder
    if maxQtyPolicy == "Block"
        qtyS := 0
    else
        qtyS := round_to_step(math.min(qtyS, maxAllow), lotStep)

// 3) respeita passe no final (garantia)
qtyL := round_to_step(qtyL, lotStep)
qtyS := round_to_step(qtyS, lotStep)
// Garantia final: respeita passo e mínimo (pós-caps/boosts)
if qtyL > 0 and qtyL < minQtyPerTrade
    qtyL := minQtyPolicy=="Block" ? 0 : ceil_to_step(minQtyPerTrade, lotStep)
if qtyS > 0 and qtyS < minQtyPerTrade
    qtyS := minQtyPolicy=="Block" ? 0 : ceil_to_step(minQtyPerTrade, lotStep)
// reforço final de passo (defensivo)
qtyL := qtyL>0 ? round_to_step(qtyL, lotStep) : 0
qtyS := qtyS>0 ? round_to_step(qtyS, lotStep) : 0
// --- Guard-rails (não corta para baixo do mínimo; cap com overcap opcional) ---
if minQtyPolicy=="BumpToMin"
    float minStep = ceil_to_step(minQtyPerTrade, lotStep)
    if qtyL > 0
        qtyL := math.max(qtyL, minStep)
    if qtyS > 0
        qtyS := math.max(qtyS, minStep)

// overcap (ultrapassar máx em X% se sinal MUITO forte)
float maxQtyAllow = maxQtyPerOrder * (1.0 + maxBoostPct/100.0)
qtyL := veryStrongL ? math.min(qtyL, maxQtyAllow) : math.min(qtyL, maxQtyPerOrder)
qtyS := veryStrongS ? math.min(qtyS, maxQtyAllow) : math.min(qtyS, maxQtyPerOrder)

// respeita múltiplos do passo no final
qtyL := round_to_step(qtyL, lotStep)
qtyS := round_to_step(qtyS, lotStep)

// Suavização leve (histerese) – opcional
var float _qPrevL = na
var float _qPrevS = na
float _maxJump = 3.0 * lotStep
if not na(_qPrevL)
    qtyL := round_to_step(_qPrevL + clampf(qtyL - _qPrevL, -_maxJump, _maxJump), lotStep)
if not na(_qPrevS)
    qtyS := round_to_step(_qPrevS + clampf(qtyS - _qPrevS, -_maxJump, _maxJump), lotStep)
_qPrevL := qtyL
_qPrevS := qtyS


// ----------------------------------------------------------------------------
// ⑩ Guard-rail: ganho mínimo projetado (TPs)
// -----------------------------------------------------------------------------
int tp1PctEff = useTP1 ? (useTP2 ? tp1Percent : 100) : 0
int tp2PctEff = useTP2 ? (100 - tp1PctEff) : 0
tp1PctEff := int(clampf(tp1PctEff, 0, 100))
tp2PctEff := int(clampf(tp2PctEff, 0, 100))

f_takeProfit(bool isLong, int level) =>
    qty = isLong ? qtyL : qtyS
    pct = level == 1 ? tp1PctEff : tp2PctEff
    useTP = level == 1 ? useTP1 : useTP2
    useTP ? round_to_step(qty * pct / 100, lotStep) : 0.0

float gainProjL = (tp1ProjL ? f_takeProfit(true, 1) * tp1ProjL : 0.0) +  (tp2ProjL ? f_takeProfit(true, 2) * tp2ProjL : 0.0)
float gainProjS = (tp1ProjS ? f_takeProfit(false, 1) * tp1ProjS : 0.0) +  (tp2ProjS ? f_takeProfit(false, 2) * tp2ProjS : 0.0)

// === PATCH E: Slippage-aware ===
string gpSlip = "②.d Execução & Slippage"
bool  slip_use   = input.bool(false, "Penalizar por slippage", group=gpSlip)
string slip_mode = input.string("TightenMinGain", "Modo", options=["TightenMinGain","TightenBoth"], group=gpSlip)
int   slipTicks  = input.int(2, "Custo por lado (ticks)", minval=0, group=gpSlip)
float slipPct    = input.float(0.00, "Ou custo % (0 para ignorar)", minval=0, step=0.01, group=gpSlip)

// custo monetário estimado por ENTRADA+SAÍDA (duas passagens)
float slipPerSideCash = (slipTicks>0 ? (slipTicks*syminfo.mintick*pv) : 0.0) + (slipPct>0 ? (close*slipPct/100.0)*pv : 0.0)
float slipRoundTrip   = 2.0 * slipPerSideCash

// Ajuste “TightenBoth”
if slip_use and slip_mode=="TightenBoth"
    float adj = slipPerSideCash/pv
    // 1) Aperta o STOP em preço...
    stopDistPriceBase := math.max(stopDistPriceBase - adj, syminfo.mintick)
    //    ...e mantém o CASH coerente
    stopDistCashBase  := stopDistPriceBase * pv

    // 2) Micro-bônus de R **sem** tocar no input:
    tp1R_base_eff := tp1R_base + 0.05

// reavalia RR projetado com os valores ajustados
float _t1R_now_afterSlip = tp1R_calc(tp1R_base_eff)
rrProj := stopDistCashBase > 0 ? _t1R_now_afterSlip : na
rrOK   := (not rr_use) or (not na(rrProj) and rrProj >= rr_min)

// aplica na projeção de ganho
float gainProjL_adj = slip_use ? math.max(gainProjL - slipRoundTrip, 0.0) : gainProjL
float gainProjS_adj = slip_use ? math.max(gainProjS - slipRoundTrip, 0.0) : gainProjS

// === Robustez regime-aware (ATR% e RVOL aumentam a exigência) ===
float dynMinGain = mg_minGain * (1 + (atrPct/100.0)*0.5) * (1 + math.max(rvol - 1.0, 0.0) * 0.3)
bool gainOK_L = (not mg_use) or (qtyL > 0 and gainProjL_adj >= dynMinGain)
bool gainOK_S = (not mg_use) or (qtyS > 0 and gainProjS_adj >= dynMinGain)

// Reinit por barra (evita "ficar travado" de barras anteriores)
allowCoreL := true
allowCoreS := true

// -----------------------------------------------------------------------------
// ⑪ Permissões finais (tempo/sessão/diários/gates/score/blocks/1 por barra)
// -----------------------------------------------------------------------------
// ⑪ Permissões finais — separar núcleo de sinal do envio de ordem
bool blockSameBar  = not sameBarEntries
bool coreMaskTime  = inSession and (not timeToFlat) and delayGate

// Núcleo sem dependência de allowOrders (para INDICADOR e ALERTAS)
bool coreMaskCore  = coreMaskTime and not inCooldown and not hitMaxLoss and not overDayTrades and not overRolling and not inSoftPause

// Versão antiga que bloqueava tudo no modo Produção
bool coreMask     = coreMaskTime and not inCooldown and not hitMaxLoss and not overDayTrades

// === Bloqueios dos novos gates (modo "Block") ===
bool yzBlockL   = useYZ   and yzMode   == "Block" and not gYZ
bool yzBlockS   = useYZ   and yzMode   == "Block" and not gYZ
bool cusBlockL  = useCUSUM and cusumMode=="Block" and not gCUSUM
bool cusBlockS  = useCUSUM and cusumMode=="Block" and not gCUSUM

allowCoreL := allowCoreL and not (yzBlockL or cusBlockL or hod_block_now)
allowCoreS := allowCoreS and not (yzBlockS or cusBlockS or hod_block_now)
allowCoreL := allowCoreL and not avmaBlockNow
allowCoreS := allowCoreS and not avmaBlockNow
// Opcional: hard block quando CHOP muito alto e ATR% muito baixo
bool antiRangeHard = (chop > 65) and (atrPct < 0.35)
allowCoreL := allowCoreL and not antiRangeHard
allowCoreS := allowCoreS and not antiRangeHard

if sideMode == "LongOnly"
    allowCoreS := false
if sideMode == "ShortOnly"
    allowCoreL := false

// Bloqueios FP/VP/VWAP2 (aplicam em ambos)
if fpBlockL_final or vpBlockL or v2BlockL
    allowCoreL := false
if fpBlockS_final or vpBlockS or v2BlockS
    allowCoreS := false

// ----- núcleo de tempo/limites já prontos no seu código -----
bool coreOK = inSession and not timeToFlat and delayGate
coreOK := coreOK and not inCooldown and not hitMaxLoss and not overDayTrades and not overRolling and not inSoftPause

bool hodBlockEntries = hod_use and hod_block_now
coreOK := coreOK and not hodBlockEntries

// ----- pronto por lado (inclui Gates + MinGain/RR + método + score) -----
bool longReady  = coreOK and allowCoreL and passL_gates and confirmOK_L and ((not mg_use) or gainOK_L) and ((not rr_use) or rrOK) and hasMethL and ((not useScoreCut) or passScoreL)
bool shortReady = coreOK and allowCoreS and passS_gates and confirmOK_S and ((not mg_use) or gainOK_S) and ((not rr_use) or rrOK) and hasMethS and ((not useScoreCut) or passScoreS)

bool tiltBlock = tiltActive and tilt_modo == "Bloquear novas entradas"
longReady  := longReady  and not tiltBlock
shortReady := shortReady and not tiltBlock

longReady  := longReady  and setOK_L
shortReady := shortReady and setOK_S

// ==== Sanity LOCK: respeitar passo (lotStep) antes de enviar ====
float qL_send = round_to_step(qtyL, lotStep)
float qS_send = round_to_step(qtyS, lotStep)

//-------------------------------------------------------------------------
// ⑫ Execução (Entradas / Addon / Saídas com IDs explícitos)
// -----------------------------------------------------------------------------
const string ID_LE     = "LE"
const string ID_LE_TP1 = "LE_TP1"
const string ID_LE_TP2 = "LE_TP2"
const string ID_LE_SL  = "LE_SL"
const string ID_SE     = "SE"
const string ID_SE_TP1 = "SE_TP1"
const string ID_SE_TP2 = "SE_TP2"
const string ID_SE_SL  = "SE_SL"

// ==== One-entry arbiter (core + gates + score + desempate) ====
bool sameBar = (not na(lastEntryBar)) and (bar_index == lastEntryBar)
bool canEnterThisBar = canSendThisBar

bool candL = longReady
bool candS = shortReady

candL := candL and az_allowLongFinal
candS := candS and az_allowShortFinal

// Desempate por score somente se ambos elegíveis
if candL and candS
    bool chooseL = na(pickScS) or (not na(pickScL) and pickScL >= pickScS)
    if chooseL
        candS := false
    else
        candL := false

bool posL = strategy.position_size > 0
bool posS = strategy.position_size < 0
if posS and candL
    candL := rev_use and revOK_L
if posL and candS
    candS := rev_use and revOK_S

// Entradas (um único envio por barra)
if allowOrders and candL and canSendNow and (qL_send > 0)
    _seqToday += 1
    mark_send()
    _curCode := build_code_from_ms(_lastSendMs)
    strategy.entry(ID_LE, strategy.long,  qty=qL_send, comment=pickMethL)
    lastEntryBar := bar_index
    lastSendBar  := bar_index
    canSendNow   := false

if allowOrders and candS and canSendNow and (qS_send > 0)
    _seqToday += 1
    mark_send()
    _curCode := build_code_from_ms(_lastSendMs)
    strategy.entry(ID_SE, strategy.short, qty=qS_send, comment=pickMethS)
    lastEntryBar := bar_index
    lastSendBar  := bar_index
    canSendNow   := false

var bool _hadPosPrev = false
bool _openedNow = (strategy.position_size != 0 and not _hadPosPrev)  // transição flat → posicionado

// Intenção de entrada (pré-envio) — usa seus sinais finais
bool enterLongIntent  = candL and canSendNow and (qL_send > 0)
bool enterShortIntent = candS and canSendNow and (qS_send > 0)

// Evento de abertura efetiva (pós-fill)
if _openedNow
    array.push(entryTimes, int(time))
    tradesToday += 1
    _entryAvg := strategy.position_avg_price
    _sentEntry := true
    _entryMs   := clockMs()
    _entryQty  := math.abs(strategy.position_size)
    _entrySide := strategy.position_size > 0 ? "LONG" : "SHORT"

// Atualiza o estado intrabar no final
_hadPosPrev := (strategy.position_size != 0)

// Addon (sinal forte + PnL do dia ≥ k×R, respeita pyramiding/contagem)
string gpAdd = "⑨.b Addon (só em sinal forte)"
bool  addon_use = input.bool(false, "Usar Addon forte", group=gpAdd)
float addon_dayPnL_R = input.float(2.5, "Liberar se PnL do dia ≥ k×R", minval=0.0, step=0.1, group=gpAdd)
string addon_qty_mode = input.string("LotStep", "Qtd do Addon", options=["LotStep","BaseQtyUnit"], group=gpAdd)
int    addon_maxAdds  = input.int(3, "Máx addons por posição", minval=0, group=gpAdd)
var int addonCount = 0
var int _lastAddonBar = -1
int pyrMaxCheck = input.int(3, "Pyramiding (p/ checagem do Addon)", minval=0, group=gpAdd,
     tooltip="Repita aqui o mesmo valor definido no cabeçalho strategy(..., pyramiding=X, ...)")
if ta.change(time("D")) != 0
    addonCount := 0

// ===== Addon: regras e quantidade =====
bool  addonAllowed = false
float addonQty     = 0.0

if addon_use
    bool dayOK   = profitToday >= addon_dayPnL_R * riskBRL
    bool countOK = addonCount < addon_maxAdds
    bool pyrOK   = (strategy.opentrades < pyrMaxCheck)
    bool oneBarOK= (sameBarEntries or bar_index > _lastAddonBar) and (not onePerBar or canSendNow)
    addonQty     := addon_qty_mode == "LotStep" ? lotStep : baseQty
    addonAllowed := dayOK and countOK and pyrOK and oneBarOK
    
// [ADDON-AUDIT]
if addonAllowed
    addonAllowed := addonAllowed and (sameBarEntries or bar_index > _lastAddonBar) and canSendNow

// plot de diagnóstico
plotshape(addonAllowed, title="ADDON allowed", style=shape.circle, location=location.top,
     color=color.new(color.green, 0), size=size.tiny, text="ADDON")

// trava para não enviar addon duas vezes no mesmo candle quando 1 por barra está desligado
if not sameBarEntries and sameBar
    addonAllowed := false

// + canSendThisBar para respeitar 1 por candle
addonAllowed := addonAllowed and (strategy.opentrades < pyrMaxCheck) and canSendNow
if not sameBarEntries and sameBar
    addonAllowed := false

// Addon reusando a mesma tag de entrada
if addonAllowed and strongL and strategy.position_size > 0
    strategy.entry(ID_LE, strategy.long,  qty=addonQty, comment="ADD")
    addonCount += 1
    lastEntryBar := bar_index
    lastSendBar  := bar_index
    _lastAddonBar := bar_index
    canSendNow := false

if addonAllowed and strongS and strategy.position_size < 0
    strategy.entry(ID_SE, strategy.short, qty=addonQty, comment="ADD")
    addonCount += 1
    lastEntryBar := bar_index
    lastSendBar  := bar_index
    _lastAddonBar := bar_index
    canSendNow := false

// ------------------------- Saídas e Proteções -------------------------------
// Config extra para impedir “mesmo horário” (hold mínimo)
string gpExitPlus = "②.c Regras extras de saída"
bool  strictLotOnExits= input.bool(true,  "Ajustar TP1% para respeitar passo nas saídas", group=gpExitPlus)

// Capturar idade da posição (sem reset por parcial/addon)
if strategy.position_size == 0 and strategy.position_size[1] != 0
    posEntryBar := na
else if strategy.position_size != 0 and strategy.position_size[1] == 0
