bool useWR7NR7   = input.bool(false, "Gate WR7/NR7", group=gpFilt)
bool useSlope    = input.bool(false, "Gate Slope (EMA/VWAP)", group=gpFilt)
bool useMarket   = input.bool(false, "Gate Mercado (IBOV EMA200)", group=gpFilt)
bool useGapATR   = input.bool(false, "Gate Gap normalizado por ATR", group=gpFilt)
bool useCHOP     = input.bool(false, "Gate Choppiness (tendência)", group=gpFilt)

float vwapBandPct = input.float(0.005, "VWAP: tolerância (% do preço)", minval=0.0, step=0.0001, group=gpFilt)
float vwapSlopeMinPct = input.float(0.04, "VWAP Impulso: inclinação mín (%/bar)", minval=0.0, step=0.005, group=gpFilt)
float vwapMaxDistPct  = input.float(0.75, "VWAP Impulso: dist máx (% do preço)", minval=0.1, step=0.05, group=gpFilt)
int   erLen   = input.int(14, "ER período", minval=2, group=gpFilt)
float erMin   = input.float(0.2, "ER mínimo", minval=0.0, step=0.01, group=gpFilt)
float rvolMin = input.float(1.2, "RVOL mínimo", minval=0.0, step=0.1, group=gpFilt)
float atrPctMin= input.float(0.2, "ATR% mín", minval=0.0, step=0.1, group=gpFilt)
float atrPctMax= input.float(8.0, "ATR% máx", minval=0.0, step=0.1, group=gpFilt)
float ibsMin= input.float(0.1, "IBS mínimo", minval=0.0, maxval=1.0, step=0.01, group=gpFilt)
float ibsMax= input.float(0.9, "IBS máximo", minval=0.0, maxval=1.0, step=0.01, group=gpFilt)
float slopeMin = input.float(0.0, "Slope mínimo abs.", minval=0.0, step=0.0001, group=gpFilt)
string slopeSrc = input.string("EMA200", "Slope: fonte", options=["EMA200","VWAP"], group=gpFilt)
string marketSym = input.string("BMFBOVESPA:IBOV", "Símbolo índice mercado", group=gpFilt)
float maxGapATR = input.float(1.5, "Gap ATR máx", minval=0.0, step=0.1, group=gpFilt)
int   chopLen = input.int(14, "CHOP len", minval=2, group=gpFilt)
float chopMax   = input.float(61.8, "CHOP máx (trend <)", minval=0.0, maxval=100.0, step=0.5, group=gpFilt)

// Cálculos
float vwapSlopePct = math.abs((vwap - vwap[1]) / math.max(vwap[1], syminfo.mintick*10)) * 100.0
bool  vwapRightSideL = close >= vwap
bool  vwapRightSideS = close <= vwap
bool  vwapDistOK     = math.abs((close - vwap)/close) * 100.0 <= vwapMaxDistPct
bool  vwapSlopeOK    = vwapSlopePct >= vwapSlopeMinPct
bool  ema200OK_L = close >= ema200
bool  ema200OK_S = close <= ema200
bool  vwapOK = math.abs((close - vwap)/close) <= vwapBandPct
float changeAbs = math.abs(close - close[erLen])
float moveAbs   = ta.sma(math.abs(ta.change(close)), erLen) * erLen
float er        = moveAbs == 0.0 ? 0.0 : changeAbs / moveAbs
float atrPct   = (atr14/close)*100.0
float ibs      = (high - low) == 0 ? 0.5 : (close - low)/(high - low)
float rng      = high - low
float maxR7    = ta.highest(rng, 7)
float minR7    = ta.lowest(rng, 7)
bool  isWR7     = rng >= maxR7
bool  isNR7     = rng <= minR7
float srcSlope = slopeSrc=="EMA200" ? (ema200 - ema200[5]) : (vwap - vwap[5])
float idxClose = request.security(marketSym, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
float idxEMA200= request.security(marketSym, timeframe.period, ta.ema(close,200), barmerge.gaps_off, barmerge.lookahead_off)
bool  marketOK_L= idxClose >= idxEMA200
bool  marketOK_S= idxClose <= idxEMA200
float prevCloseD = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float gapATR = atr14 == 0 ? 0.0 : math.abs(open - prevCloseD)/atr14
float tr = math.max(high - low, syminfo.mintick)
// CHOP fix
float trMA      = ta.sma(tr, chopLen)
float trSum     = trMA * chopLen
float hiN       = ta.highest(high, chopLen)
float loN       = ta.lowest(low,  chopLen)
float chopRange = math.max(hiN - loN, syminfo.mintick)
float chop      = 100.0 * (math.log10(trSum / chopRange) / math.log10(chopLen))

// Gates por lado
bool gEMA_L = not useEMA200   or ema200OK_L
bool gEMA_S = not useEMA200   or ema200OK_S
bool gVWAP  = not useVWAPBand or vwapOK
bool gVIMP_L= not useVWAPImp  or (vwapRightSideL and vwapSlopeOK and vwapDistOK)
bool gVIMP_S= not useVWAPImp  or (vwapRightSideS and vwapSlopeOK and vwapDistOK)
bool gER    = not useERmin    or (er >= erMin)
bool gRVOL  = not useRVOLmin  or (rvol >= rvolMin)
bool gATR   = not useATRpct   or (atrPct >= atrPctMin and atrPct <= atrPctMax)
bool gIBS   = not useIBS      or (ibs >= ibsMin and ibs <= ibsMax)
bool gWRNR  = not useWR7NR7   or (isWR7 or isNR7)
bool gSlope_L = not useSlope  or (srcSlope >=  slopeMin)
bool gSlope_S = not useSlope  or (srcSlope <= -slopeMin)
bool gMKT_L   = not useMarket or marketOK_L
bool gMKT_S   = not useMarket or marketOK_S
bool gGAP     = not useGapATR or (gapATR <= maxGapATR)
bool gCHOP    = not useCHOP   or (chop <= chopMax)

// Pesos (para score/size bonus)
float wgEMA      = input.float(0.6, "Peso: EMA200 OK", step=0.1, group=gpFilt)
float wgVWAP     = input.float(0.4, "Peso: VWAP OK", step=0.1, group=gpFilt)
float wgVIMP     = input.float(0.5, "Peso: VWAP Impulso OK", step=0.1, group=gpFilt)
float wgER       = input.float(0.3, "Peso: ER OK", step=0.1, group=gpFilt)
float wgRVOL     = input.float(0.4, "Peso: RVOL OK", step=0.1, group=gpFilt)
float wgATR      = input.float(0.2, "Peso: ATR% OK", step=0.1, group=gpFilt)
float wgIBS      = input.float(0.2, "Peso: IBS OK", step=0.1, group=gpFilt)
float wgWRNR     = input.float(0.2, "Peso: WR/NR7 OK", step=0.1, group=gpFilt)
float wgSlope    = input.float(0.3, "Peso: Slope OK", step=0.1, group=gpFilt)
float wgMKT      = input.float(0.3, "Peso: Mercado OK", step=0.1, group=gpFilt)
float wgGap      = input.float(0.2, "Peso: Gap OK", step=0.1, group=gpFilt)
float wgCHOP     = input.float(0.3, "Peso: CHOP OK", step=0.1, group=gpFilt)

float bonusL = 0.0
float bonusS = 0.0
float wAct   = 0.0

// === Inputs / toggles de performance e alinhamento diário ===
bool perf_skipCross = input.bool(false, "🛠️ Desligar consenso diário (ganha performance)", tooltip = "Quando ON, pula o cálculo de alinhamento diário (EMA200/ROC) para reduzir custo computacional.")
bool useDailyAlign = input.bool(true, "Usar consenso diário (EMA200 + ROC)", tooltip = "Exige tendência diária a favor do sinal")

// === Série diária (só usada se useDailyAlign e não perf_skipCross) ===
float _d_close = request.security(syminfo.tickerid, "D", close)
float _d_ema200 = request.security(syminfo.tickerid, "D", ta.ema(close, 200))
float _d_roc20 = request.security(syminfo.tickerid, "D", ta.roc(close, 20))

// Nota: mesmo com perf_skipCross, o Pine avalia as chamadas; o toggle serve para 'anular' o uso e baratear encadeamentos posteriores.
// Se quiser micro-otimizar ainda mais, mova os request.security para uma seção compartilhada ou use resoluções maiores.

float dClose = perf_skipCross ? na : _d_close
