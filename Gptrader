float bos_minFrac = input.float(0.60,"Fraç. mín ok", minval=0.1, maxval=1.0, step=0.05, group=gpBOSSF)

bool bos_adxOK  = adxV >= bos_adxMin
bool bos_rvOK   = rvol >= bos_rvolMin
bool bos_chopOK = chop <= chopMax

int nB=3, passBL=0, passBS=0
passBL += bos_adxOK  ? 1 : 0
passBS += bos_adxOK  ? 1 : 0
passBL += bos_rvOK   ? 1 : 0
passBS += bos_rvOK   ? 1 : 0
passBL += bos_chopOK ? 1 : 0
passBS += bos_chopOK ? 1 : 0

bool bos_passL = passBL >= math.ceil(bos_minFrac*nB)
bool bos_passS = passBS >= math.ceil(bos_minFrac*nB)

sigBOSContL := sigBOSContL and (not bosSF_use or bos_passL)
sigBOSContS := sigBOSContS and (not bosSF_use or bos_passS)

// ============================================================================
// ⑧ Consolidação dos gates – versão linearizada e robusta
// ============================================================================
// EMA200
wAct   += useEMA200                  ? wgEMA   : 0.0
bonusL += (useEMA200 and gEMA_L)     ? wgEMA   : 0.0
bonusS += (useEMA200 and gEMA_S)     ? wgEMA   : 0.0
// VWAP (faixa)
wAct   += useVWAPBand                ? wgVWAP  : 0.0
bonusL += (useVWAPBand and gVWAP)    ? wgVWAP  : 0.0
bonusS += (useVWAPBand and gVWAP)    ? wgVWAP  : 0.0
// VWAP Impulso
wAct   += useVWAPImp                 ? wgVIMP  : 0.0
bonusL += (useVWAPImp and gVIMP_L)   ? wgVIMP  : 0.0
bonusS += (useVWAPImp and gVIMP_S)   ? wgVIMP  : 0.0
// ER mínimo
wAct   += useERmin                   ? wgER    : 0.0
bonusL += (useERmin and gER)         ? wgER    : 0.0
bonusS += (useERmin and gER)         ? wgER    : 0.0
// RVOL mínimo
wAct   += useRVOLmin                 ? wgRVOL  : 0.0
bonusL += (useRVOLmin and gRVOL)     ? wgRVOL  : 0.0
bonusS += (useRVOLmin and gRVOL)     ? wgRVOL  : 0.0
// ATR% regime
wAct   += useATRpct                  ? wgATR   : 0.0
bonusL += (useATRpct and gATR)       ? wgATR   : 0.0
bonusS += (useATRpct and gATR)       ? wgATR   : 0.0
// IBS
wAct   += useIBS                     ? wgIBS   : 0.0
bonusL += (useIBS and gIBS)          ? wgIBS   : 0.0
bonusS += (useIBS and gIBS)          ? wgIBS   : 0.0
// WR7/NR7
wAct   += useWR7NR7                  ? wgWRNR  : 0.0
bonusL += (useWR7NR7 and gWRNR)      ? wgWRNR  : 0.0
bonusS += (useWR7NR7 and gWRNR)      ? wgWRNR  : 0.0
// Slope
wAct   += useSlope                   ? wgSlope : 0.0
bonusL += (useSlope and gSlope_L)    ? wgSlope : 0.0
bonusS += (useSlope and gSlope_S)    ? wgSlope : 0.0
// Mercado (índice)
wAct   += useMarket                  ? wgMKT   : 0.0
bonusL += (useMarket and gMKT_L)     ? wgMKT   : 0.0
bonusS += (useMarket and gMKT_S)     ? wgMKT   : 0.0
// Gap/ATR
wAct   += useGapATR                  ? wgGap   : 0.0
bonusL += (useGapATR and gGAP)       ? wgGap   : 0.0
bonusS += (useGapATR and gGAP)       ? wgGap   : 0.0
// CHOP
wAct   += useCHOP                    ? wgCHOP  : 0.0
bonusL += (useCHOP and gCHOP)        ? wgCHOP  : 0.0
bonusS += (useCHOP and gCHOP)        ? wgCHOP  : 0.0

// === PATCH B: CUSUM (mudança material) ===
string gpCUSUM = "④.c Gate/Boost por Evento (CUSUM)"
bool  useCUSUM   = input.bool(false, "Usar CUSUM", group=gpCUSUM)
string cusumMode = input.string("Off", "Modo CUSUM", options=["Off","Block","Weight"], group=gpCUSUM)
float cusumK_ATR = input.float(0.50, "Limiar (k × ATR14)", step=0.05, group=gpCUSUM)
float cusumBoost = input.float(15.0, "Weight: bônus qty quando em evento (%)", minval=0, step=1, group=gpCUSUM)  // já está ok

var float _cus = 0.0
float kCus = cusumK_ATR * atr14
_cus += (close - close[1])
bool evtUp   = _cus >  kCus
bool evtDown = _cus < -kCus
if evtUp or evtDown
    _cus := 0.0

bool gCUSUM = evtUp or evtDown

// integra como gate leve (score/contadores)
wAct   += useCUSUM ? 0.2 : 0.0
bonusL += (useCUSUM and gCUSUM) ? 0.2 : 0.0
bonusS += (useCUSUM and gCUSUM) ? 0.2 : 0.0


// HODv2 — reaproveita hod_use / hod_block_now / hod_mult_now
wAct   += hod_use ? 0.2 : 0.0
bonusL += (hod_use and not hod_block_now and hod_mult_now >= 1.0) ? 0.2 : 0.0
bonusS += (hod_use and not hod_block_now and hod_mult_now >= 1.0) ? 0.2 : 0.0

float bonusLnorm = wAct == 0.0 ? 1.0 : clampf(bonusL / wAct, 0.0, 1.0)
float bonusSnorm = wAct == 0.0 ? 1.0 : clampf(bonusS / wAct, 0.0, 1.0)

