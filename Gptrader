passORS += or_chopOK  ? 1 : 0

bool or_passL = passORL >= math.ceil(or_minFrac*nOR)
bool or_passS = passORS >= math.ceil(or_minFrac*nOR)

sigORL := sigORL and (not orSF_use or or_passL)
sigORS := sigORS and (not orSF_use or or_passS)

// --- Smart-Filter Inside ---
string gpINSF = "③.b.3 Inside Smart-Filter"
bool  inSF_use     = input.bool(true, "Inside: aplicar filtros", group=gpINSF)
int   in_conLen    = input.int(8,   "Consolidação len", minval=3, group=gpINSF)
float in_stdevATRx = input.float(0.75, "σ(close) ≤ X×ATR", step=0.05, group=gpINSF)
float in_adxMin    = input.float(16, "Min ADX", step=0.5, group=gpINSF)
