float don_minFrac    = input.float(0.60,"Fraç. mín de filtros ok", minval=0.1, maxval=1.0, step=0.05, group=gpDonSF)

// pré-cálculos baratos
float _sd_don = ta.stdev(close, don_consolLen)
bool  don_consolOK = _sd_don <= don_consolATRx*atr14
bool  don_adxOK    = adxV >= don_adxMin
bool  don_rvolOK   = rvol >= don_rvolMin
bool  don_slopeOKL = srcSlope >= slopeMin
bool  don_slopeOKS = srcSlope <= -slopeMin
bool  don_chopOK   = chop <= chopMax

int nDon = 5, passDonL = 0, passDonS = 0
passDonL += don_consolOK ? 1 : 0
passDonS += don_consolOK ? 1 : 0
passDonL += don_adxOK    ? 1 : 0
passDonS += don_adxOK    ? 1 : 0
passDonL += don_rvolOK   ? 1 : 0
passDonS += don_rvolOK   ? 1 : 0
passDonL += don_slopeOKL ? 1 : 0
passDonS += don_slopeOKS ? 1 : 0
passDonL += don_chopOK   ? 1 : 0
passDonS += don_chopOK   ? 1 : 0

bool don_passL = (passDonL >= math.ceil(don_minFrac*nDon))
bool don_passS = (passDonS >= math.ceil(don_minFrac*nDon))

sigDonL := sigDonL and (not donSF_use or don_passL)
sigDonS := sigDonS and (not donSF_use or don_passS)

// --- Smart-Filter OR ---
string gpORSF = "③.b.2 OR Smart-Filter"
bool  orSF_use    = input.bool(true, "OR: aplicar filtros", group=gpORSF)
float or_rvolMin  = input.float(1.30,"RVOL mín", step=0.05, group=gpORSF)
float or_vwapPPB  = input.float(0.04,"Slope VWAP mín (%/bar)", step=0.01, group=gpORSF)
float or_minFrac  = input.float(0.60, "Fraç. mín ok", minval=0.1, maxval=1.0, step=0.05, group=gpORSF)

bool  or_rvOK   = rvol >= or_rvolMin
bool  or_slopeOK= vwapSlopePct >= or_vwapPPB
bool  or_gapL   = preGapAlignL
bool  or_gapS   = preGapAlignS
bool  or_chopOK = chop <= chopMax

int nOR = 4, passORL = 0, passORS = 0
passORL += or_rvOK    ? 1 : 0
passORS += or_rvOK    ? 1 : 0
passORL += or_slopeOK ? 1 : 0
passORS += or_slopeOK ? 1 : 0
passORL += (not or_alignGap or or_gapL) ? 1 : 0
passORS += (not or_alignGap or or_gapS) ? 1 : 0
