// ADX "seguro": todas as ta.rma/ta.tr executadas em toda barra (sem condicionais)
f_adx(int len) =>
    float up      = math.max(high - high[1], 0.0)
    float down    = math.max(low[1]  - low,  0.0)
    float plusDM  = (up   > down) ? up   : 0.0
    float minusDM = (down > up)   ? down : 0.0
    float trSm    = ta.rma(ta.tr(true), len)
    float pDMsm   = ta.rma(plusDM,  len)
    float mDMsm   = ta.rma(minusDM, len)
    float pDI     = trSm > 0 ? 100.0 * pDMsm / trSm : 0.0
    float mDI     = trSm > 0 ? 100.0 * mDMsm / trSm : 0.0
    float den     = pDI + mDI
    float dx      = den  > 0 ? 100.0 * math.abs(pDI - mDI) / den : 0.0
    ta.rma(dx, len)

