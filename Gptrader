        r := avgPx
    r

clampf(float x, float lo, float hi) =>
    float a = math.max(lo, x)
    float b = math.min(a, hi)
    b

round_to_step(float qty, float step) =>
    float st = step <= 0 ? 1.0 : step
    float q  = qty / st
    float qf = math.floor(q)
    float r  = qf * st
    r

ceil_to_step(float qty, float step) =>
    float st = step <= 0 ? 1.0 : step
    float q  = qty / st
    float qf = math.ceil(q)
    float r  = qf * st
    r

nzf(float v, float repl) =>
    float r = na(v) ? repl : v
    r


// aplica boosts respeitando passe e retornando já arredondado
boost_qty(float q, float pct, float step) =>
    round_to_step(q * (1.0 + pct/100.0), step)

