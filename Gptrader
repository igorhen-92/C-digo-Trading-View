// AVWAP/VA-lite
// AVWAP/VA-lite (corrigido: avwap = Σ(P×V)/Σ(V) a partir do anchor)
var float avwap = na
var float avwapPV = na      // soma ponderada preço×volume
var float avwapVol = na     // soma de volume
bool anchorNow = false

if vp_use
    if vp_anchor == "SessionOpen"
        anchorNow := ta.change(time("D")) != 0
    else if vp_anchor == "ORBreak"
        anchorNow := ta.crossover(close, orHigh) or ta.crossunder(close, orLow)
    else
        string _vpHH = str.substring(vp_timeHHMM, 0, 2)
        string _vpMM = str.substring(vp_timeHHMM, 2, 4)
        float  _vpHF = nz(str.tonumber(_vpHH), 10.0)
        float  _vpMF = nz(str.tonumber(_vpMM),  0.0)
        int    ah    = int(math.floor(clampf(_vpHF, 0.0, 23.0)))
        int    am    = int(math.floor(clampf(_vpMF, 0.0, 59.0)))
        int _h = hour(time)
        int _m = minute(time)
        anchorNow := (_h == ah and _m == am)

    if anchorNow or na(avwap)
        avwapPV  := close * volume
        avwapVol := volume
        avwap    := avwapVol > 0 ? (avwapPV / avwapVol) : close
    else
        avwapPV  += close * volume
        avwapVol += volume
        avwap    := avwapVol > 0 ? (avwapPV / avwapVol) : avwap

float stdevL = ta.stdev(close, 50)
float vaTop  = vp_use ? avwap + vp_sdMult * stdevL : na
float vaBot  = vp_use ? avwap - vp_sdMult * stdevL : na
bool  vpFavorL = vp_use ? (close >= avwap and (na(vaTop) or close <= vaTop)) : true
bool  vpFavorS = vp_use ? (close <= avwap and (na(vaBot) or close >= vaBot)) : true
float vp_ctxL  = (vpFavorL ? vp_wVWAPFavor : 0.0) + math.max(rvol-1.0,0.0)*vp_wRVOL + (atrPct/100.0)*vp_wATRpct
float vp_ctxS  = (vpFavorS ? vp_wVWAPFavor : 0.0) + math.max(rvol-1.0,0.0)*vp_wRVOL + (atrPct/100.0)*vp_wATRpct

// Quiet Regime: baixa volatilidade → filtrar setups de breakout “frágeis”
bool quietRegime = (rvol < 0.8) and (atrPct < 0.4)
// Desabilita temporariamente Inside/Don/OR quando “quiet”
bool mInside_eff = mInside_on and not quietRegime
bool mDon_eff    = mDon_on    and not quietRegime
bool mOR_eff     = mOR_on     and not quietRegime

// === PATCH 4.1 — aplicar quietRegime de fato nos sinais usados no picker ===
sigInsideL := sigInsideL and (not quietRegime)
sigInsideS := sigInsideS and (not quietRegime)
sigDonL    := sigDonL    and (not quietRegime)
sigDonS    := sigDonS    and (not quietRegime)
sigORL     := sigORL     and (not quietRegime)
sigORS     := sigORS     and (not quietRegime)

// 4.1 — Anti‑lateralização: reaplica sinais exigindo CHOP abaixo do limite
// Inside
sigInsideL := mInside_on and (not avoidChop or chop < chopTight) and insidePrev and ta.crossover(close, high[1]) and (not inSF_use or in_passL)
sigInsideS := mInside_on and (not avoidChop or chop < chopTight) and insidePrev and ta.crossunder(close, low[1])  and (not inSF_use or in_passS)

// Donchian
sigDonL    := mDon_on    and (not avoidChop or chop < chopTight) and ta.crossover(close, ta.highest(high, donLen)[1]) and (not donSF_use or don_passL)
sigDonS    := mDon_on    and (not avoidChop or chop < chopTight) and ta.crossunder(close, ta.lowest(low,  donLen)[1])  and (not donSF_use or don_passS)

// OR
sigORL     := mOR_on     and (not avoidChop or chop < chopTight) and bar_index > orBars and ta.crossover(close, orHigh) and (not orSF_use or or_passL)
sigORS     := mOR_on     and (not avoidChop or chop < chopTight) and bar_index > orBars and ta.crossunder(close, orLow)  and (not orSF_use or or_passS)


float minCandleATR = input.float(0.60, "Reversais: range mínimo (×ATR14)", minval=0.0, step=0.05, group=gpMeth)
float _rng_rev = high - low
bool  bigEnough = _rng_rev >= minCandleATR * atr14

sigEngulfL := mEngulf_on and bigEnough and bullEng
sigEngulfS := mEngulf_on and bigEnough and bearEng
sig2BarL   := m2Bar_on   and bigEnough and bull2Bar
sig2BarS   := m2Bar_on   and bigEnough and bear2Bar
// 4.3 — VWAP Reversal com slope/side coerentes (VWAP2 fix)
sigVWAPL := mVWAP_on and v2_okL_fix and (close - vwap) < 0 and ta.crossover(close, vwap)
sigVWAPS := mVWAP_on and v2_okS_fix and (close - vwap) > 0 and ta.crossunder(close, vwap)


// === PATCH D: AVWAP multiâncora ===
bool   avma_use    = input.bool(false, "Filtro: AVWAP Multiâncora")
string avma_mode   = input.string("OFF", "AVWAP Modo", options=["OFF","Block","Weight"])
float  avma_band   = input.float(1.00, "AVWAP Banda (×Desvio)")
int    avma_stdlen = input.int(50, "AVWAP Período do Desvio", minval=10)
float  avma_gain   = input.float(1.10, "AVWAP Peso (modo Weight)", minval=1.00)

float dClosePrev = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float avwaps  = ta.vwap(hlc3)
float avwapD1 = request.security(syminfo.tickerid, "D", ta.vwap(hlc3))[1]

// --- AVWAP Multiâncora (modo Block/Weight) — usar flags locais ---
bool avmaBlock = false
float avma_mult = 1.00
// Parâmetros internos usados no AVWAP-Multi
int   stLen       = avma_stdlen
float band1_mult  = avma_band
float band2_mult  = avma_band
// Pré-cálculo (executa em toda barra)
float _avma_stdev_raw = ta.stdev(close, avma_stdlen)
float _stdev50_global  = ta.stdev(close, 50)  // reaproveite onde precisar
float stL_raw = ta.stdev(close, stLen)
float stL     = math.max(stL_raw, syminfo.mintick * 2.0)
// Parâmetros internos usados no AVWAP-Multi

if avma_use and avma_mode != "OFF"
    bool ok_av = not na(avwap) and not na(avwapD1)
    if ok_av
        // depois
        bool inBand1  = ok_av and (math.abs(close - avwap) < stL * band1_mult)
        bool inBand2  = ok_av and (math.abs(close - avwap) < stL * band2_mult)
        bool avmaOK = inBand1 and inBand2
        if avma_mode == "Block"
            avmaBlock := not avmaOK
        if avma_mode == "Weight" and avmaOK
            avma_mult := avma_gain

// OR já existe (orHigh/orLow). Consideramos a âncora OR como a do seu avwap "vp_anchor==ORBreak"
// Confluência: preço entre bandas de (avwap ± avma_band*stdevL) E (avwapD1 ± ...) simultaneamente
float stL2 = ta.stdev(close, 50)
bool inBand1 = avma_use ? (math.abs(close - avwap)   <= avma_band*stL2) : true
bool inBand2 = avma_use ? (math.abs(close - avwapD1) <= avma_band*stL2) : true
bool avmaOK  = inBand1 and inBand2

// Block/Weight efetivo
bool avmaBlockNow = avma_use and avma_mode=="Block" and not avmaOK
if avma_use and avma_mode=="Weight" and avmaOK
    avma_mult := 1.10

// Métricas Footprint-lite
float _tr  = math.max(high - low, syminfo.mintick)
float _dpx = _tr > 0 ? (close - open) / _tr : 0.0
float fp_delta = volume * _dpx
float sma50d = ta.sma(fp_delta, 50)
float std50d = ta.stdev(fp_delta, 50)
float fp_zDelta = std50d > 0 ? (fp_delta - sma50d) / std50d : 0.0
float wickTop = high - math.max(open, close)
float wickBot = math.min(open, close) - low
float fp_imb  = _tr > 0 ? (wickBot - wickTop) / _tr : 0.0
float fp_evr  = volume > 0 ? _tr / volume : 0.0
float fp_closePos = _tr > 0 ? (close - low) / _tr : 0.5
float _mV = ta.sma(volume, 50)
float _sV = math.sqrt(math.max(ta.variance(volume, 50), 0.0))
float fp_zVol = _sV > 0 ? (volume - _mV) / _sV : 0.0

// VWAP 2.0 favorabilidade
float v2_fit_now  = math.abs((close     - vwap    ) / math.max(close,     syminfo.mintick*10)) * 100.0
float v2_fit_prev = math.abs((close[1]  - vwap[1] ) / math.max(close[1],  syminfo.mintick*10)) * 100.0

// REMOVER esta linha se ainda existir solta:
float v2_dist = math.abs((close - vwap)/close) * 100.0
bool v2_okL = true
bool v2_okS = true
if v2_use
    v2_okL := (close >= vwap) and (not na(v2_slopePPB)) and (v2_slopePPB >=  v2fix_minPPB) and (v2_dist <= v2_maxDist)
    v2_okS := (close <= vwap) and (not na(v2_slopePPB)) and (v2_slopePPB <= -v2fix_minPPB) and (v2_dist <= v2_maxDist)
if v2fix_use
    v2_okL := v2_okL and v2_okL_fix
    v2_okS := v2_okS and v2_okS_fix
// Multiplicadores (modo Weight)-
float fp_multL = fp_use and fp_mode=="Weight" ? (1.0 + (fp_wDelta*math.max(fp_zDelta,0) + fp_wImb*math.max(fp_imb,0) + fp_wEffRes*clampf((fp_evr - fp_effResMin)/math.max(fp_effResMin,1e-9),0,1) + fp_wClosePos*fp_closePos + fp_wZVol*math.max(fp_zVol,0))*0.10) : 1.0
float fp_multS = fp_use and fp_mode=="Weight" ? (1.0 + (fp_wDelta*math.max(-fp_zDelta,0) + fp_wImb*math.max(-fp_imb,0) + fp_wEffRes*clampf((fp_evr - fp_effResMin)/math.max(fp_effResMin,1e-9),0,1) + fp_wClosePos*(1.0 - fp_closePos) + fp_wZVol*math.max(fp_zVol,0))*0.10) : 1.0
float vp_multL = vp_use and vp_mode=="Weight" ? (1.0 + vp_ctxL*0.10) : 1.0
float vp_multS = vp_use and vp_mode=="Weight" ? (1.0 + vp_ctxS*0.10) : 1.0
float v2_multL = v2_use and v2_mode=="Weight" ? (v2_okL ? 1.10 : 1.00) : 1.0
float v2_multS = v2_use and v2_mode=="Weight" ? (v2_okS ? 1.10 : 1.00) : 1.0

// StrongSignal (para Addon) & Blocks
bool strongL = (fp_zDelta > fp_deltaStrong) and (fp_closePos > 0.66) and (fp_zVol > fp_zVolStrong) and v2_okL
bool strongS = (fp_zDelta < -fp_deltaStrong) and (fp_closePos < 0.34) and (fp_zVol > fp_zVolStrong) and v2_okS
bool fpBlockL = fp_use and fp_mode=="Block" and (fp_zDelta < -fp_deltaStrong or fp_closePos < 0.34)
