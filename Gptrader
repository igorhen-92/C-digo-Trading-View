float t2_minFrac = input.float(0.60, "Fraç. mín ok", minval=0.1, maxval=1.0, step=0.05, group=gp2BSF)

bool t2_adxOK  = adxV >= t2_adxMin
bool t2_rsiOKL = rsi14 <= t2_rsiLMax
bool t2_rsiOKS = rsi14 >= t2_rsiSMin
bool t2_chopOK = chop <= chopMax

int nT=3, passTL=0, passTS=0
passTL += t2_adxOK  ? 1 : 0
passTS += t2_adxOK  ? 1 : 0
passTL += t2_rsiOKL ? 1 : 0
passTS += t2_rsiOKS ? 1 : 0
passTL += t2_chopOK ? 1 : 0
passTS += t2_chopOK ? 1 : 0

bool t2_passL = passTL >= math.ceil(t2_minFrac*nT)
bool t2_passS = passTS >= math.ceil(t2_minFrac*nT)

sig2BarL := sig2BarL and (not t2SF_use or t2_passL)
sig2BarS := sig2BarS and (not t2SF_use or t2_passS)

// --- Smart-Filter BOSCont ---
string gpBOSSF = "③.b.5 BOSCont Smart-Filter"
bool  bosSF_use   = input.bool(true, "BOSCont: filtros extras", group=gpBOSSF)
float bos_adxMin  = input.float(18, "Min ADX", step=0.5, group=gpBOSSF)
